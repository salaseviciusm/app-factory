    ["--force kills then retries", (() => { const d = rt({}, { executorAlive: true, executorPid: 4242, force: true }); return d.eligible && d.killExecutor === true; })()],
    ["open triage session blocks a second dispatch", (() => { const at = "2026-01-01T00:10:00.000Z"; const d = rt({ updatedAt: at, retries: [{ at, tier: "triage", step: "implement" }] }); return !d.eligible && /factory-triage-selftest-run/.test(d.reason); })()],
    ["pid guard matches only this run's exec command", matchesExecutor("node /x/orchestration/bin/factory-run exec selftest-run", "selftest-run") && !matchesExecutor("node /x/orchestration/bin/factory-run exec selftest-run-2", "selftest-run") && !matchesExecutor("vim exec selftest-run", "selftest-run")],
