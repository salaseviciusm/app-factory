  const rtT0 = "2026-01-01T00:00:00.000Z";
  const rt = (runOver, ctxOver) =>
    classifyRetry(
      { id: "selftest-run", state: "failed", updatedAt: rtT0, stepIndex: 2, retries: [], history: [], ...runOver },
