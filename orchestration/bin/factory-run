#!/usr/bin/env node
/*
 * factory-run: the App Factory run engine.
 *
 * Executes workflow DAGs (feature-dev, bug-fix) against registered rigs:
 * git worktree per run, Claude Code sessions per agentic step, deterministic
 * checks + cross-model agentic review, EAS deploy, Slack notifications with
 * QR code via the OpenClaw gateway.
 *
 * Design doc: docs/08-orchestration-layer.md. Zero npm dependencies.
 *
 * Commands:
 *   factory-run start --rig <name> --workflow <wf> --prompt "<text>" [--auto]
 *   factory-run exec <run_id>            (internal: runs the step loop in-process)
 *   factory-run resume <run_id>          (restart a stopped/failed run's executor)
 *   factory-run status [<run_id>] [--json]
 *   factory-run list [--json]
 *   factory-run approve <run_id>
 *   factory-run reject <run_id> "<feedback>"
 *   factory-run steer <run_id> "<instruction>"
 *   factory-run cancel <run_id>
 *   factory-run cleanup [--dry-run] [--json] [--remove-unmerged-worktrees]
 *   factory-run preflight [--rig <name>]   (live external-CLI contract checks)
 *   factory-run selftest
 *
 * Run ids are readable task slugs (<workflow-prefix>-<slug>, e.g.
 * feature-version-badge). Every <run_id> above except `exec` also accepts any
 * unambiguous prefix or substring of an id.
 */
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execSync, spawnSync, spawn } = require("child_process");

const ORCH_DIR = path.resolve(__dirname, "..");
const RUNS_DIR = path.join(ORCH_DIR, "runs");
const WORKTREES_DIR = path.join(ORCH_DIR, "worktrees");
const RIGS = JSON.parse(fs.readFileSync(path.join(ORCH_DIR, "rigs.json"), "utf8"));

// ---------- telemetry (SQLite, node:sqlite — structured artifacts, not context dumps) ----------

let _tdb = null;
function tdb() {
  if (_tdb) return _tdb;
  const { DatabaseSync } = require("node:sqlite");
  _tdb = new DatabaseSync(path.join(ORCH_DIR, "telemetry.db"));
  _tdb.exec(`
    CREATE TABLE IF NOT EXISTS runs (
      id TEXT PRIMARY KEY, workflow TEXT, rig TEXT, prompt TEXT, state TEXT,
      auto INTEGER, parent_run TEXT, created_at TEXT, finished_at TEXT
    );
    CREATE TABLE IF NOT EXISTS steps (
      run_id TEXT, step_id TEXT, attempt INTEGER, status TEXT, summary TEXT,
      started_at TEXT, finished_at TEXT, duration_s REAL
    );
    CREATE TABLE IF NOT EXISTS artifacts (
      run_id TEXT, step_id TEXT, type TEXT, value TEXT, created_at TEXT
    );
  `);
  // Migration: per-agent-step cost/token capture from the claude JSON output.
  // ALTER ... ADD COLUMN throws if the column already exists — idempotent by catch.
  for (const col of [
    "cost_usd REAL",
    "input_tokens INTEGER",
    "output_tokens INTEGER",
    "cache_read_tokens INTEGER",
    "cache_creation_tokens INTEGER",
  ]) {
    try {
      _tdb.exec(`ALTER TABLE steps ADD COLUMN ${col}`);
    } catch {}
  }
  return _tdb;
}

function tRun(run) {
  tdb()
    .prepare(
      `INSERT INTO runs (id, workflow, rig, prompt, state, auto, parent_run, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)
       ON CONFLICT(id) DO UPDATE SET state = excluded.state`
    )
    .run(run.id, run.workflow, run.rig, run.prompt, run.state, run.auto ? 1 : 0, run.parentRun || null, run.createdAt);
}

const TERMINAL_STATES = ["done", "failed", "rejected", "cancelled"];

function tRunState(run) {
  const terminal = TERMINAL_STATES.includes(run.state);
  tdb()
    .prepare(`UPDATE runs SET state = ?, finished_at = COALESCE(finished_at, ?) WHERE id = ?`)
    .run(run.state, terminal ? nowIso() : null, run.id);
}

function tStep(runId, stepId, attempt, status, summary, startedAt, usage) {
  const finished = nowIso();
  const dur = (Date.parse(finished) - Date.parse(startedAt)) / 1000;
  const u = usage || {};
  tdb()
    .prepare(
      `INSERT INTO steps (run_id, step_id, attempt, status, summary, started_at, finished_at, duration_s,
        cost_usd, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens)
       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)`
    )
    .run(
      runId, stepId, attempt, status, (summary || "").slice(0, 1000), startedAt, finished, dur,
      u.costUsd ?? null, u.inputTokens ?? null, u.outputTokens ?? null,
      u.cacheReadTokens ?? null, u.cacheCreationTokens ?? null
    );
}

/** Extract cost/token usage from a parsed `claude --output-format json` result. */
function parseUsage(parsed) {
  if (!parsed || typeof parsed !== "object") return null;
  const u = parsed.usage || {};
  return {
    costUsd: typeof parsed.total_cost_usd === "number" ? parsed.total_cost_usd : null,
    inputTokens: u.input_tokens || 0,
    outputTokens: u.output_tokens || 0,
    cacheReadTokens: u.cache_read_input_tokens || 0,
    cacheCreationTokens: u.cache_creation_input_tokens || 0,
  };
}

/** Sum cost/tokens across all telemetry step rows for a run (in-progress or done). */
function runUsage(runId) {
  try {
    const r = tdb()
      .prepare(
        `SELECT COALESCE(SUM(cost_usd),0) cost, COALESCE(SUM(input_tokens),0) in_tok,
                COALESCE(SUM(output_tokens),0) out_tok, COALESCE(SUM(cache_read_tokens),0) cache_read,
                COALESCE(SUM(cache_creation_tokens),0) cache_create,
                SUM(cost_usd IS NOT NULL) priced_steps
         FROM steps WHERE run_id = ?`
      )
      .get(runId);
    return {
      costUsd: r.cost || 0,
      inputTokens: (r.in_tok || 0) + (r.cache_read || 0) + (r.cache_create || 0),
      rawInputTokens: r.in_tok || 0,
      cacheReadTokens: r.cache_read || 0,
      cacheCreationTokens: r.cache_create || 0,
      outputTokens: r.out_tok || 0,
      pricedSteps: r.priced_steps || 0,
    };
  } catch {
    return null;
  }
}

function fmtTokens(n) {
  if (n >= 1e6) return `${(n / 1e6).toFixed(2)}M`;
  if (n >= 1e3) return `${(n / 1e3).toFixed(1)}k`;
  return String(n);
}

/** One-line Slack/CLI usage summary for a run, or "" if nothing priced yet. */
function usageLine(runId) {
  const u = runUsage(runId);
  if (!u || u.pricedSteps === 0) return "";
  return `:moneybag: Cost $${u.costUsd.toFixed(2)} · tokens in ${fmtTokens(u.inputTokens)} (${fmtTokens(u.cacheReadTokens)} cached) / out ${fmtTokens(u.outputTokens)} · ${u.pricedSteps} agent step(s)`;
}

function tArtifact(runId, stepId, type, value) {
  tdb()
    .prepare(`INSERT INTO artifacts (run_id, step_id, type, value, created_at) VALUES (?,?,?,?,?)`)
    .run(runId, stepId, type, String(value).slice(0, 2000), nowIso());
}

// ---------- helpers ----------

function expandHome(p) {
  return p.startsWith("~") ? path.join(os.homedir(), p.slice(1)) : p;
}

function nowIso() {
  return new Date().toISOString();
}

function log(runDir, msg) {
  const line = `[${nowIso()}] ${msg}`;
  console.log(line);
  if (runDir) fs.appendFileSync(path.join(runDir, "engine.log"), line + "\n");
}

function readJson(p, fallback) {
  try {
    return JSON.parse(fs.readFileSync(p, "utf8"));
  } catch {
    return fallback;
  }
}

function writeJson(p, obj) {
  fs.writeFileSync(p, JSON.stringify(obj, null, 2) + "\n");
}

function sh(cmd, opts = {}) {
  return execSync(cmd, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], ...opts });
}

/** Run a shell command, capturing output to a log file. Returns {ok, output}. */
function runCommand(cmd, cwd, logFile, timeoutMinutes = 30) {
  const res = spawnSync("bash", ["-lc", cmd], {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: timeoutMinutes * 60 * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  const output = (res.stdout || "") + (res.stderr || "");
  if (logFile) fs.appendFileSync(logFile, `\n$ ${cmd}\n${output}\n(exit ${res.status})\n`);
  return { ok: res.status === 0, output, status: res.status };
}

function resolveRig(name) {
  if (RIGS.rigs[name]) {
    const rig = { name, ...RIGS.rigs[name] };
    rig.path = expandHome(rig.path);
    return rig;
  }
  const m = name.match(/^factory:(.+)$/);
  if (m) {
    const appPath = path.join(expandHome(RIGS.factoryApps.basePath), m[1]);
    if (!fs.existsSync(appPath)) throw new Error(`factory app not found: ${appPath}`);
    return { name, path: appPath, ...RIGS.factoryApps, basePath: undefined };
  }
  throw new Error(`unknown rig: ${name}. Known: ${Object.keys(RIGS.rigs).join(", ")}, factory:<app>`);
}

function loadWorkflow(name) {
  const p = path.join(ORCH_DIR, "workflows", `${name}.json`);
  if (!fs.existsSync(p)) throw new Error(`unknown workflow: ${name}`);
  return JSON.parse(fs.readFileSync(p, "utf8"));
}

function runDirOf(id) {
  return path.join(RUNS_DIR, id);
}

// Run ids are human-readable task slugs: <workflow-prefix>-<slug> derived from
// the prompt (e.g. feature-version-badge), numeric suffix only on collision.
// Degenerate prompts fall back to the legacy base36 timestamp shape. Every CLI
// verb accepts any unambiguous prefix or substring of an id (exec excepted).

const SLUG_STOPWORDS = new Set([
  "a", "an", "and", "are", "as", "at", "add", "be", "by", "can", "could", "create",
  "do", "fix", "for", "from", "in", "is", "it", "its", "make", "my", "need", "new",
  "of", "on", "or", "our", "please", "should", "so", "some", "that", "the", "then",
  "this", "to", "up", "update", "want", "we", "with", "would", "you", "your",
]);
const SLUG_MAX_LEN = 28;
const SLUG_MAX_WORDS = 4;

/** Derive a [a-z0-9-] slug from a prompt: first few meaningful words, capped at
 *  a word boundary. Returns "" when the prompt has no usable words. */
function slugify(prompt) {
  const words = String(prompt || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .split(" ")
    .filter((w) => w && !SLUG_STOPWORDS.has(w))
    .slice(0, SLUG_MAX_WORDS);
  let slug = "";
  for (const w of words) {
    const next = slug ? `${slug}-${w}` : w;
    if (next.length > SLUG_MAX_LEN) break;
    slug = next;
  }
  return slug;
}

/** First free id among base, base-2, base-3, … (exists: (id) => bool). */
function uniqueRunId(base, exists) {
  let id = base;
  for (let n = 2; exists(id); n++) id = `${base}-${n}`;
  return id;
}

function listRunIds() {
  if (!fs.existsSync(RUNS_DIR)) return [];
  return fs.readdirSync(RUNS_DIR).filter((d) => fs.existsSync(path.join(RUNS_DIR, d, "run.json")));
}

/** Resolve a full id, unique id-prefix, or unique substring against `ids`.
 *  Pure core of resolveRunId, also exercised by selftest. */
function resolveRunIdFrom(input, ids) {
  if (!input) throw new Error("missing run id");
  if (ids.includes(input)) return input;
  const prefixed = ids.filter((d) => d.startsWith(input));
  // Prefix matches are a subset of substring matches, so an ambiguous prefix
  // can never be salvaged by the substring pass — error right away.
  const matches = prefixed.length ? prefixed : ids.filter((d) => d.includes(input));
  if (matches.length === 1) return matches[0];
  if (matches.length > 1) {
    throw new Error(`ambiguous run id '${input}': matches ${matches.sort().join(", ")}`);
  }
  throw new Error(`no such run: ${input}`);
}

function resolveRunId(input) {
  const id = resolveRunIdFrom(input, listRunIds());
  if (id !== input) console.error(`(resolved '${input}' -> ${id})`);
  return id;
}

function loadRun(id) {
  const p = path.join(runDirOf(id), "run.json");
  if (!fs.existsSync(p)) throw new Error(`no such run: ${id}`);
  return readJson(p);
}

function saveRun(run) {
  writeJson(path.join(runDirOf(run.id), "run.json"), run);
}

function setState(run, state, detail) {
  run.state = state;
  run.updatedAt = nowIso();
  run.history.push({ state, detail: detail || null, at: run.updatedAt });
  saveRun(run);
  try {
    tRunState(run);
  } catch {
    /* telemetry must never break a run */
  }
}

// ---------- notifications (OpenClaw -> Slack) ----------

/** Resolve ${VAR} placeholders from the environment or openclaw/secrets.env (IDs stay out of git). */
let _secretsEnv = null;
function resolvePlaceholders(str) {
  return str.replace(/\$\{(\w+)\}/g, (_, key) => {
    if (process.env[key]) return process.env[key];
    if (_secretsEnv === null) {
      _secretsEnv = {};
      const p = path.join(ORCH_DIR, "..", "openclaw", "secrets.env");
      if (fs.existsSync(p)) {
        for (const line of fs.readFileSync(p, "utf8").split("\n")) {
          const m = line.match(/^(\w+)=(.*)$/);
          if (m) _secretsEnv[m[1]] = m[2];
        }
      }
    }
    if (_secretsEnv[key]) return _secretsEnv[key];
    throw new Error(`unresolved placeholder \${${key}} (set it in env or openclaw/secrets.env)`);
  });
}

/**
 * The exact `openclaw message send` argv. Single source of truth: consumed by
 * the real notify() send AND the preflight contract probe, so the probe can
 * never drift from the real invocation.
 */
function notifyArgs(to, message, mediaPath) {
  const channel = (RIGS.notify && RIGS.notify.channel) || "slack";
  const args = [
    "message", "send",
    "--channel", channel,
    "--target", to,
    "-m", message,
  ];
  if (mediaPath) args.push("--media", mediaPath);
  return args;
}

/** Send a Slack notification. Returns true on success — and when notifications
 *  are deliberately disabled (no RIGS.notify / FACTORY_RUN_NO_NOTIFY=1): a
 *  disabled channel must not fail gates. Returns false on unresolved
 *  placeholder or non-zero exit. */
function notify(run, message, mediaPath) {
  const target = RIGS.notify;
  if (!target || process.env.FACTORY_RUN_NO_NOTIFY === "1") return true;
  const runDir = runDirOf(run.id);
  let args;
  try {
    args = notifyArgs(
      resolvePlaceholders(target.to),
      message,
      mediaPath && fs.existsSync(mediaPath) ? mediaPath : null
    );
  } catch (err) {
    log(runDir, `notify FAILED: ${err.message}`);
    return false;
  }
  const res = spawnSync("openclaw", args, {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 120000,
  });
  if (res.status !== 0) {
    log(runDir, `notify FAILED: ${(res.stderr || res.stdout || "").slice(0, 500)}`);
    return false;
  }
  log(runDir, `notified Slack: ${message.split("\n")[0]}`);
  return true;
}

// ---------- agentic steps (Claude Code) ----------

function renderPrompt(templateName, run) {
  const runDir = runDirOf(run.id);
  let tpl = fs.readFileSync(path.join(ORCH_DIR, "prompts", `${templateName}.md`), "utf8");
  const steeringPath = path.join(runDir, "steering.md");
  const steering = fs.existsSync(steeringPath)
    ? `Founder steering (mid-run instructions, honor these):\n\n${fs.readFileSync(steeringPath, "utf8")}`
    : "";
  const findingsPath = path.join(runDir, "findings.md");
  const findings = fs.existsSync(findingsPath)
    ? `Previous validation FAILED. You must address every finding below, then re-complete your task:\n\n${fs.readFileSync(findingsPath, "utf8")}`
    : "";
  return tpl
    .replaceAll("{{PROMPT}}", run.prompt)
    .replaceAll("{{RUN_DIR}}", runDir)
    .replaceAll("{{BASE_BRANCH}}", run.baseBranch)
    .replaceAll("{{STEERING}}", steering)
    .replaceAll("{{FINDINGS}}", findings);
}

/** Filename of one attempt's prompt/output document. Attempt 1 stays
 *  unsuffixed (implement.prompt.md) so pre-existing run dirs read as
 *  attempt 1; retries get implement.2.prompt.md, .3, … */
function stepDocName(stepId, kind, attempt) {
  const ext = kind === "prompt" ? "prompt.md" : "output.json";
  return attempt <= 1 ? `${stepId}.${ext}` : `${stepId}.${attempt}.${ext}`;
}

/** Highest attempt among existing prompt/output files for a step, 0 when none.
 *  Pure core (exercised by selftest); `names` = fs.readdirSync(runDir). */
function maxStepAttempt(names, stepId) {
  const re = new RegExp(`^${stepId}\\.(?:(\\d+)\\.)?(?:prompt\\.md|output\\.json)$`);
  let max = 0;
  for (const name of names) {
    const m = name.match(re);
    if (m) max = Math.max(max, m[1] ? parseInt(m[1], 10) : 1);
  }
  return max;
}

function runAgentStep(run, step) {
  const runDir = runDirOf(run.id);
  // Attempt derived from files on disk (not in-memory loop counters) so
  // numbering survives engine restarts and never overwrites earlier attempts.
  const attempt = maxStepAttempt(fs.readdirSync(runDir), step.id) + 1;
  const prompt = renderPrompt(step.prompt, run);
  const promptFile = path.join(runDir, stepDocName(step.id, "prompt", attempt));
  fs.writeFileSync(promptFile, prompt);
  const args = [
    "-p", prompt,
    "--output-format", "json",
    "--dangerously-skip-permissions",
  ];
  if (step.model) args.push("--model", step.model);
  log(runDir, `agent step '${step.id}' starting (attempt ${attempt}, model=${step.model || "default"}, cwd=${run.worktree})`);
  const res = spawnSync("claude", args, {
    cwd: run.worktree,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: (step.timeoutMinutes || 30) * 60 * 1000,
    maxBuffer: 256 * 1024 * 1024,
    env: { ...process.env, CLAUDE_CODE_ENTRYPOINT: "factory-run" },
  });
  fs.writeFileSync(path.join(runDir, stepDocName(step.id, "output", attempt)), res.stdout || "");
  if (res.error && res.error.code === "ETIMEDOUT") {
    return { ok: false, attempt, summary: `agent step '${step.id}' timed out after ${step.timeoutMinutes}m` };
  }
  if (res.status !== 0) {
    return { ok: false, attempt, summary: `agent step '${step.id}' exited ${res.status}: ${(res.stderr || "").slice(0, 500)}` };
  }
  let parsed = null;
  try {
    parsed = JSON.parse(res.stdout);
  } catch {
    /* non-json output tolerated */
  }
  const resultText = parsed && typeof parsed.result === "string" ? parsed.result : (res.stdout || "");
  return { ok: true, attempt, summary: resultText.slice(0, 2000), usage: parseUsage(parsed) };
}

/** Preserve the live findings.md as the next findings.N.md archive copy.
 *  findings.md itself must stay deletable on review PASS (renderPrompt injects
 *  it into every later agent prompt), so history lives in the archives. Called
 *  after every findings write and defensively before the PASS delete; skips
 *  when findings.md is absent or identical to the newest archive. */
function archiveFindings(runDir) {
  const live = path.join(runDir, "findings.md");
  if (!fs.existsSync(live)) return;
  const text = fs.readFileSync(live, "utf8");
  let max = 0;
  for (const name of fs.readdirSync(runDir)) {
    const m = name.match(/^findings\.(\d+)\.md$/);
    if (m) max = Math.max(max, parseInt(m[1], 10));
  }
  if (max > 0) {
    try {
      if (fs.readFileSync(path.join(runDir, `findings.${max}.md`), "utf8") === text) return;
    } catch {}
  }
  fs.writeFileSync(path.join(runDir, `findings.${max + 1}.md`), text);
}

// ---------- deterministic steps ----------

function runCommandsStep(run, step, rig) {
  const runDir = runDirOf(run.id);
  const cmds = rig[step.source] || [];
  if (cmds.length === 0) {
    log(runDir, `step '${step.id}': no ${step.source} configured for rig, skipping`);
    return { ok: true, summary: `no ${step.source} configured` };
  }
  const logFile = path.join(runDir, `${step.id}.log`);
  for (const cmd of cmds) {
    log(runDir, `step '${step.id}': ${cmd}`);
    const r = runCommand(cmd, run.worktree, logFile, 30);
    if (!r.ok) {
      const tail = r.output.split("\n").slice(-80).join("\n");
      fs.writeFileSync(
        path.join(runDir, "findings.md"),
        `Deterministic ${step.source} failed.\n\nCommand: \`${cmd}\`\n\nOutput tail:\n\n\`\`\`\n${tail}\n\`\`\`\n`
      );
      archiveFindings(runDir);
      return { ok: false, summary: `${step.source} failed at: ${cmd}` };
    }
  }
  return { ok: true, summary: `${cmds.length} ${step.source} command(s) green` };
}

function evaluateReview(run) {
  const runDir = runDirOf(run.id);
  const review = readJson(path.join(runDir, "review.json"), null);
  if (!review || !review.verdict) {
    return { ok: false, summary: "reviewer did not produce a valid review.json" };
  }
  try {
    tArtifact(run.id, "review", "review_verdict", review.verdict);
    for (const f of review.findings || []) tArtifact(run.id, "review", "finding", f);
  } catch {}
  if (review.verdict === "PASS") {
    archiveFindings(runDir);
    fs.rmSync(path.join(runDir, "findings.md"), { force: true });
    return { ok: true, summary: "agentic review PASS" };
  }
  const findings = (review.findings || []).map((f, i) => `${i + 1}. ${f}`).join("\n");
  fs.writeFileSync(
    path.join(runDir, "findings.md"),
    `Agentic cross-validation FAILED.\n\nFindings:\n\n${findings}\n`
  );
  archiveFindings(runDir);
  return { ok: false, summary: `agentic review FAIL (${(review.findings || []).length} findings)` };
}

/** Record the run branch's commits as telemetry artifacts (idempotent-ish: replaces prior rows). */
function recordCommits(run) {
  try {
    const out = sh(`git -C ${JSON.stringify(run.worktree)} log --format='%H %s' ${run.baseBranch}..HEAD`);
    tdb().prepare(`DELETE FROM artifacts WHERE run_id = ? AND type = 'commit'`).run(run.id);
    for (const line of out.trim().split("\n").filter(Boolean)) tArtifact(run.id, "implement", "commit", line);
  } catch {}
}

// ---------- gate ----------

function waitForGate(run, step) {
  const runDir = runDirOf(run.id);
  if (run.auto) {
    log(runDir, "plan gate skipped (--auto)");
    return { ok: true, summary: "auto-approved" };
  }
  setState(run, "awaiting-approval", "plan gate");
  const planPath = path.join(runDir, step.planFile || "plan.md");
  const plan = fs.existsSync(planPath) ? fs.readFileSync(planPath, "utf8") : "(no plan file)";
  const sent = notify(
    run,
    `:clipboard: Run ${run.id} (${run.workflow} on ${run.rig}) has a plan awaiting approval.\n\n` +
      plan.slice(0, 2800) +
      `\n\nApprove: \`factory-run approve ${run.id}\` / reject with feedback: \`factory-run reject ${run.id} "..."\` (or just tell the chief of staff).`
  );
  if (!sent) {
    // Founder never saw the plan; waiting 12h on an invisible gate is the
    // smoke-run failure mode. Fail loud instead.
    return {
      ok: false,
      summary: "plan gate notification failed to send (see notify FAILED in engine.log); fix the notify channel and resume",
      terminal: true,
    };
  }
  const decisionPath = path.join(runDir, "gate-decision.json");
  const timeoutMs = 12 * 60 * 60 * 1000;
  const started = Date.now();
  while (Date.now() - started < timeoutMs) {
    if (fs.existsSync(decisionPath)) {
      const d = readJson(decisionPath, {});
      if (d.decision === "approve") return { ok: true, summary: "founder approved" };
      return { ok: false, summary: `founder rejected: ${d.feedback || ""}`, terminal: true };
    }
    const cancelled = loadRun(run.id).state === "cancelled";
    if (cancelled) return { ok: false, summary: "cancelled", terminal: true };
    execSync("sleep 15");
  }
  return { ok: false, summary: "plan gate timed out after 12h", terminal: true };
}

// ---------- deploy ----------

/**
 * The exact `eas <...>` publish argv. Single source of truth: consumed by the
 * real deployStep() publish AND the preflight flag-coverage probe, so the
 * probe can never drift from the real invocation.
 */
function easPublishArgs(deploy, msg) {
  const environment = deploy.environment || deploy.branch;
  return [
    "update",
    "--branch", deploy.branch,
    "--environment", environment,
    "--message", msg,
    "--non-interactive",
    "--json",
  ];
}

/** Pure decision core for the harness-merge web-console restart (exercised by
 * selftest). Given the merge commit's first-parent file list, says whether the
 * factory web server must be restarted and whether its frontend build is stale
 * (frontend/dist/ is gitignored, so merged frontend sources need a rebuild). */
function classifyWebRestart(files) {
  const owned = files.filter(
    (f) => f.startsWith("orchestration/web/") || f.startsWith("orchestration/bin/factory-web")
  );
  return {
    restart: owned.length > 0,
    rebuildFrontend: owned.some((f) => f.startsWith("orchestration/web/frontend/")),
  };
}

function deployStep(run, rig) {
  const runDir = runDirOf(run.id);
  const deploy = rig.deploy || { type: "none" };
  if (deploy.type === "none") {
    return { ok: true, summary: "no deploy configured for this rig (quickfire/spec-only)", url: null };
  }
  if (deploy.type === "harness-merge") {
    // Self-improvement deploy: merge the validated run branch into the rig's
    // default branch and restart the gateway so skills/engine reload.
    const logFile = path.join(runDir, "deploy.log");
    const r = runCommand(
      `git merge --no-ff factory/${run.id} -m "self-improvement: ${run.prompt.split("\n")[0].slice(0, 72)} (run ${run.id})"`,
      rig.path,
      logFile,
      5
    );
    if (!r.ok) {
      runCommand("git merge --abort", rig.path, logFile, 2);
      return { ok: false, summary: `harness merge failed (aborted cleanly): ${r.output.split("\n").slice(-3).join(" | ").slice(0, 300)}` };
    }
    const sha = sh(`git -C ${JSON.stringify(rig.path)} rev-parse --short HEAD`).trim();
    runCommand("openclaw gateway restart < /dev/null", rig.path, logFile, 5);
    try {
      tArtifact(run.id, "deploy", "harness_merge_commit", sha);
    } catch {}
    // The gateway restart reloads gateway-owned code only; the web console is a
    // separate long-lived process, so a merge touching it needs its own restart.
    const diff = runCommand("git diff --name-only HEAD^1 HEAD", rig.path, logFile, 2);
    const web = classifyWebRestart(diff.ok ? diff.output.split("\n") : []);
    if (!web.restart) {
      return { ok: true, summary: `merged to ${rig.defaultBranch} (${sha}) and restarted gateway`, url: null };
    }
    if (web.rebuildFrontend) runCommand("rm -rf orchestration/web/frontend/dist", rig.path, logFile, 2);
    const down = runCommand("orchestration/bin/factory-web-down", rig.path, logFile, 5);
    const up = runCommand("orchestration/bin/factory-web-up", rig.path, logFile, 10);
    if (down.ok && up.ok && up.output.includes(": up at ")) {
      return { ok: true, summary: `merged to ${rig.defaultBranch} (${sha}) and restarted gateway + web console`, url: null };
    }
    // The merge is durable and already on the default branch, so the deploy
    // stays ok — but the summary must not read as a clean deploy.
    return {
      ok: true,
      summary: `merged to ${rig.defaultBranch} (${sha}), restarted gateway; web console restart FAILED — restart manually with factory-web-up, see deploy.log`,
      url: null,
    };
  }
  if (deploy.type !== "eas-update") {
    return { ok: false, summary: `unknown deploy type: ${deploy.type}` };
  }
  const appDir = path.join(run.worktree, rig.appDir || ".");
  const logFile = path.join(runDir, "deploy.log");
  const msg = `factory-run ${run.id}: ${run.prompt.slice(0, 80)}`;
  log(runDir, `deploying: eas update --branch ${deploy.branch} (${appDir})`);
  const r = runCommand(
    `npx eas ${easPublishArgs(deploy, msg).map((a) => JSON.stringify(a)).join(" ")}`,
    appDir,
    logFile,
    30
  );
  if (!r.ok) {
    return { ok: false, summary: `eas update failed (see deploy.log): ${r.output.split("\n").slice(-5).join(" | ").slice(0, 400)}` };
  }
  // The publish output is noisy; query the branch for the newest update group instead.
  let url = null;
  const list = runCommand(
    `npx eas update:list --branch ${JSON.stringify(deploy.branch)} --limit 1 --json --non-interactive`,
    appDir,
    logFile,
    5
  );
  try {
    const jsonStart = list.output.indexOf("{");
    const parsed = JSON.parse(list.output.slice(jsonStart));
    const group = parsed.currentPage && parsed.currentPage[0] && parsed.currentPage[0].group;
    if (group && rig.easSlug && RIGS.easAccount) {
      url = `https://expo.dev/accounts/${RIGS.easAccount}/projects/${rig.easSlug}/updates/${group}`;
    }
  } catch {
    const m = r.output.match(/https:\/\/expo\.dev\S+/);
    if (m) url = m[0];
  }
  let qrPath = null;
  if (url) {
    qrPath = path.join(runDir, "qr.png");
    const q = runCommand(`npx --yes qrcode ${JSON.stringify(url)} -o ${JSON.stringify(qrPath)}`, runDir, logFile, 5);
    if (!q.ok) qrPath = null;
  }
  return { ok: true, summary: url ? `EAS update published: ${url}` : "EAS update published (no URL parsed, see deploy.log)", url, qrPath };
}

// ---------- preflight (live external-CLI contract checks) ----------
//
// Both smoke-run failures were hand-written CLI argument lists first validated
// in production. These probes exercise the exact contracts (arg lists come from
// the same helpers the engine sends with) at run start, before any token is
// spent. All probes are read-only: nothing is sent, nothing is published.
// Skip the run-start invocation with FACTORY_RUN_NO_PREFLIGHT=1.

function preflightSpawn(cmd, args, cwd, timeoutMs) {
  const res = spawnSync(cmd, args, {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: timeoutMs,
    maxBuffer: 8 * 1024 * 1024,
  });
  if (res.error && res.error.code === "ETIMEDOUT") return { status: -1, stdout: "", output: `timed out after ${timeoutMs / 1000}s` };
  if (res.error) return { status: -1, stdout: "", output: String(res.error.message) };
  return { status: res.status, stdout: res.stdout || "", output: (res.stdout || "") + (res.stderr || "") };
}

function longFlagsOf(argv) {
  return argv.filter((a) => /^--[a-z][\w-]*$/i.test(a));
}

/** Option-alias groups (e.g. ["-m", "--message"]) whose --help definition line
 *  marks them required. Aliases come only from the option-definition column at
 *  the start of the line — never from flags mentioned in description prose
 *  (the "-m, --message" line says "required unless --media is set"; --media
 *  belongs to a different option and must not join this group). */
function requiredOptionGroups(helpText) {
  const groups = [];
  for (const line of helpText.split("\n")) {
    if (!/required/i.test(line)) continue;
    const def = line.match(/^\s+(-{1,2}[a-z][\w-]*(?:,\s+-{1,2}[a-z][\w-]*)*)/i);
    if (def) groups.push(def[1].split(/,\s+/));
  }
  return groups;
}

/** Option-alias groups the CLI actually enforces as required, derived by
 *  running it — not by trusting --help prose (openclaw's "-t, --target" line
 *  carries no "required" marker at all). Invokes the command under --dry-run
 *  (payload printed, nothing sent), satisfies each "Missing required option"
 *  error with a dummy value, and repeats until the CLI stops raising that
 *  error class. Returns {groups} or {error} when probing can't run safely. */
function enforcedRequiredGroups(cmd, baseArgs, helpText) {
  if (!helpText.includes("--dry-run")) {
    return { error: "--dry-run absent from --help; cannot probe required options without sending" };
  }
  const groups = [];
  const argv = [...baseArgs, "--dry-run"];
  for (let i = 0; i < 6; i++) {
    const res = preflightSpawn(cmd, argv, undefined, 30000);
    const m = res.output.match(/Missing required option "([^"]+)"/);
    if (!m) break;
    const flags = m[1].match(/-{1,2}[a-z][\w-]*/gi) || [];
    if (!flags.length || groups.some((g) => g[0] === flags[0])) break;
    groups.push(flags);
    argv.push(flags[flags.length - 1], "preflight-probe");
  }
  return { groups };
}

/** Heuristic two-way contract check: every long --flag the engine passes must
 *  appear in the help output, and every required option group given must be
 *  covered (by any of its aliases) in the engine's argv. */
function helpContractProblems(helpText, argv, requiredGroups) {
  const problems = [];
  for (const flag of longFlagsOf(argv)) {
    if (!helpText.includes(flag)) problems.push(`engine passes ${flag}, absent from --help`);
  }
  for (const group of requiredGroups) {
    if (!group.some((f) => argv.includes(f))) {
      problems.push(`${group.join("/")} is required, engine passes none of them`);
    }
  }
  return problems;
}

function probeNotifyContract() {
  const name = "notify:openclaw-send-contract";
  const help = preflightSpawn("openclaw", ["message", "send", "--help"], undefined, 30000);
  if (help.status !== 0) {
    return { name, ok: false, detail: `openclaw message send --help exited ${help.status}: ${help.output.slice(0, 200)}` };
  }
  // Required-ness comes from two sources: what the CLI enforces when actually
  // invoked (catches --target, which --help never marks required), plus any
  // options whose help line carries a "required" marker (catches -m/--message).
  const enforced = enforcedRequiredGroups("openclaw", ["message", "send"], help.output);
  if (enforced.error) return { name, ok: false, detail: enforced.error };
  if (enforced.groups.length === 0) {
    return { name, ok: false, detail: 'dry-run probe confirmed no required options ("Missing required option" format changed?)' };
  }
  const requiredGroups = [...enforced.groups];
  for (const group of requiredOptionGroups(help.output)) {
    if (!requiredGroups.some((g) => g[0] === group[0])) requiredGroups.push(group);
  }
  // Dummy media path so the --media flag is part of the checked contract.
  const argv = notifyArgs("preflight", "preflight probe", "preflight-probe.png");
  const problems = helpContractProblems(help.output, argv, requiredGroups);
  if (problems.length) return { name, ok: false, detail: problems.join("; ") };
  return {
    name,
    ok: true,
    detail: `${longFlagsOf(argv).length} long flags verified against --help; ${requiredGroups.length} required option groups covered (${enforced.groups.length} enforced live)`,
  };
}

function probeClaude() {
  const name = "claude:version";
  const res = preflightSpawn("claude", ["--version"], undefined, 30000);
  if (res.status !== 0) return { name, ok: false, detail: `claude --version exited ${res.status}: ${res.output.slice(0, 200)}` };
  return { name, ok: true, detail: res.output.trim().split("\n")[0] };
}

/** EAS probes for one rig, run in the rig's live app directory (preflight runs
 *  before any worktree exists). Rigs without eas-update deploy get none. */
function easProbes(rig) {
  const deploy = rig.deploy || { type: "none" };
  if (deploy.type !== "eas-update") return [];
  const appDir = path.join(rig.path, rig.appDir || ".");
  const probes = [];

  const whoami = preflightSpawn("npx", ["eas", "whoami", "--non-interactive"], appDir, 60000);
  probes.push({
    name: `${rig.name}:eas-whoami`,
    ok: whoami.status === 0,
    detail: whoami.status === 0
      ? `logged in as ${whoami.stdout.trim().split("\n").pop()}`
      : `exited ${whoami.status}: ${whoami.output.slice(0, 200)}`,
  });

  const flagsName = `${rig.name}:eas-update-flags`;
  const help = preflightSpawn("npx", ["eas", "update", "--help"], appDir, 60000);
  if (help.status !== 0) {
    probes.push({ name: flagsName, ok: false, detail: `eas update --help exited ${help.status}: ${help.output.slice(0, 200)}` });
  } else {
    const publishFlags = longFlagsOf(easPublishArgs(deploy, "preflight probe"));
    const missing = publishFlags.filter((f) => !help.output.includes(f));
    probes.push({
      name: flagsName,
      ok: missing.length === 0,
      detail: missing.length
        ? `publish flags missing from eas update --help: ${missing.join(", ")}`
        : `${publishFlags.length} publish flags present in --help`,
    });
  }

  const listName = `${rig.name}:eas-update-list`;
  const list = preflightSpawn(
    "npx",
    ["eas", "update:list", "--branch", deploy.branch, "--limit", "1", "--non-interactive", "--json"],
    appDir,
    60000
  );
  if (list.status !== 0) {
    probes.push({ name: listName, ok: false, detail: `exited ${list.status}: ${list.output.slice(0, 200)}` });
  } else {
    // eas-cli prints upgrade banners around the JSON; parse the outermost object.
    try {
      const text = list.stdout;
      JSON.parse(text.slice(text.indexOf("{"), text.lastIndexOf("}") + 1));
      probes.push({ name: listName, ok: true, detail: `branch ${deploy.branch} listable, JSON parseable` });
    } catch {
      probes.push({ name: listName, ok: false, detail: `branch ${deploy.branch} output not JSON-parseable` });
    }
  }
  return probes;
}

/** Run all probes for the given rigs. Returns {ok, probes: [{name, ok, detail}], summary}. */
function runPreflight(rigNames) {
  const probes = [probeNotifyContract(), probeClaude()];
  for (const name of rigNames) {
    probes.push(...easProbes(resolveRig(name)));
  }
  const failed = probes.filter((p) => !p.ok);
  const summary = failed.length
    ? failed.map((p) => `${p.name}: ${p.detail}`).join("; ").slice(0, 500)
    : `${probes.length} probes green`;
  return { ok: failed.length === 0, probes, summary };
}

// ---------- cleanup (worktree/branch reclamation) ----------
//
// Every run creates orchestration/worktrees/<id> plus a factory/<id> branch in
// its rig repo, and each worktree carries full rig setup (~GBs). Cleanup
// reclaims both once a run is terminal and its branch is merged into the rig's
// default branch. It never forces: in-flight runs, dirty worktrees, and
// unmerged branches are skipped with a reason, and each run is checked against
// its own rig repo (skip-hero runs against skip-hero main, not app-factory's).

function git(repoPath, args) {
  return spawnSync("git", ["-C", repoPath, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
}

function dirSizeBytes(p) {
  try {
    return (parseInt(sh(`du -sk ${JSON.stringify(p)}`), 10) || 0) * 1024;
  } catch {
    return 0;
  }
}

function fmtBytes(n) {
  if (n >= 1 << 30) return `${(n / (1 << 30)).toFixed(2)} GB`;
  if (n >= 1 << 20) return `${(n / (1 << 20)).toFixed(1)} MB`;
  if (n >= 1024) return `${(n / 1024).toFixed(1)} kB`;
  return `${n} B`;
}

/** Pure decision core for cleanupRun (exercised by selftest). Returns
 *  {action, reason}: "skip" (leave everything), "none" (nothing left),
 *  "clean" (remove worktree if present, delete merged branch if present),
 *  "remove-worktree" (opt-in: reclaim a clean worktree while keeping its
 *  unmerged branch). */
function classifyCleanup({ state, worktreeExists, branchExists, dirty, merged }, opts = {}) {
  if (!TERMINAL_STATES.includes(state)) return { action: "skip", reason: `state '${state}' is not terminal` };
  if (!worktreeExists && !branchExists) return { action: "none", reason: "nothing to clean" };
  if (worktreeExists && dirty) return { action: "skip", reason: "worktree has uncommitted changes" };
  if (branchExists && !merged) {
    if (worktreeExists && opts.removeUnmergedWorktrees) {
      return { action: "remove-worktree", reason: "unmerged branch kept; clean worktree removed (--remove-unmerged-worktrees)" };
    }
    return { action: "skip", reason: "branch not merged into default branch" };
  }
  return { action: "clean", reason: branchExists ? "merged and clean" : "branch already deleted; reclaiming clean worktree" };
}

/** Reclaim one run's worktree/branch when safe. No forced deletion anywhere:
 *  `git worktree remove` without --force, `git branch -d` (which itself
 *  refuses unmerged branches). Returns {id, action, reason, freedBytes}. */
function cleanupRun(run, opts = {}) {
  const worktree = path.join(WORKTREES_DIR, run.id);
  const branch = `factory/${run.id}`;
  let rig;
  try {
    rig = resolveRig(run.rig);
  } catch (err) {
    return { id: run.id, action: "skip", reason: String(err.message || err), freedBytes: 0 };
  }
  const worktreeExists = fs.existsSync(worktree);
  const branchExists = git(rig.path, ["rev-parse", "--verify", "--quiet", `refs/heads/${branch}`]).status === 0;
  let dirty = false;
  if (worktreeExists) {
    const st = git(worktree, ["status", "--porcelain"]);
    if (st.status !== 0) {
      // Not a functioning worktree; the orphan scan verifies its gitdir
      // pointer before deleting anything, so leave it for that pass.
      return { id: run.id, action: "skip", reason: "git status failed in worktree (left for the orphan scan)", freedBytes: 0 };
    }
    dirty = st.stdout.trim() !== "";
  }
  const merged = branchExists && git(rig.path, ["merge-base", "--is-ancestor", branch, rig.defaultBranch]).status === 0;
  const decision = classifyCleanup({ state: run.state, worktreeExists, branchExists, dirty, merged }, opts);
  const result = { id: run.id, action: decision.action, reason: decision.reason, freedBytes: 0 };
  if (decision.action === "skip" || decision.action === "none") return result;
  if (opts.dryRun) {
    return { ...result, action: `would-${decision.action}`, freedBytes: worktreeExists ? dirSizeBytes(worktree) : 0 };
  }
  if (worktreeExists) {
    const bytes = dirSizeBytes(worktree);
    const rm = git(rig.path, ["worktree", "remove", worktree]);
    if (rm.status !== 0) {
      return { ...result, action: "error", reason: `git worktree remove failed: ${(rm.stderr || rm.stdout || "").trim().slice(0, 200)}` };
    }
    result.freedBytes = bytes;
  }
  git(rig.path, ["worktree", "prune"]);
  if (decision.action === "clean" && branchExists) {
    const del = git(rig.path, ["branch", "-d", branch]);
    if (del.status !== 0) {
      return { ...result, action: "error", reason: `git branch -d failed: ${(del.stderr || del.stdout || "").trim().slice(0, 200)}` };
    }
  }
  return result;
}

/** Scan WORKTREES_DIR for directories that are no longer valid git worktrees
 *  (no .git file, or a gitdir pointer targeting a deleted path) and remove
 *  them. A directory that is a valid worktree of some rig repo is never an
 *  orphan — without a run.json it is only reported, not touched. */
function scanOrphans(opts = {}) {
  if (!fs.existsSync(WORKTREES_DIR)) return [];
  const results = [];
  const runIds = new Set(listRunIds());
  for (const entry of fs.readdirSync(WORKTREES_DIR)) {
    const dir = path.join(WORKTREES_DIR, entry);
    if (!fs.lstatSync(dir).isDirectory()) continue;
    let gitdir = null;
    try {
      const m = fs.readFileSync(path.join(dir, ".git"), "utf8").match(/^gitdir:\s*(.+?)\s*$/m);
      if (m) gitdir = path.resolve(dir, m[1]);
    } catch {}
    if (gitdir && fs.existsSync(gitdir)) {
      if (!runIds.has(entry)) results.push({ id: entry, action: "report", reason: "valid worktree without a run — left in place", freedBytes: 0 });
      continue;
    }
    const bytes = dirSizeBytes(dir);
    if (!opts.dryRun) fs.rmSync(dir, { recursive: true, force: true });
    results.push({
      id: entry,
      action: opts.dryRun ? "would-remove-orphan" : "remove-orphan",
      reason: "gitdir pointer missing or dangling",
      freedBytes: bytes,
    });
  }
  return results;
}

function cmdCleanup(argv) {
  const opts = {
    dryRun: argv.includes("--dry-run"),
    removeUnmergedWorktrees: argv.includes("--remove-unmerged-worktrees"),
  };
  const asJson = argv.includes("--json");
  const results = listRunIds().map((id) => cleanupRun(loadRun(id), opts));
  results.push(...scanOrphans(opts));
  const freedBytes = results.reduce((n, r) => n + (r.freedBytes || 0), 0);
  if (asJson) {
    console.log(JSON.stringify({ dryRun: opts.dryRun, freedBytes, results }, null, 2));
    return;
  }
  for (const r of results) {
    console.log(`${r.action.padEnd(20)} ${r.id}: ${r.reason}${r.freedBytes ? ` [${fmtBytes(r.freedBytes)}]` : ""}`);
  }
  console.log(`\n${opts.dryRun ? "would free" : "freed"} ${fmtBytes(freedBytes)} (${results.length} item(s) examined)`);
}

// ---------- executor ----------

function execRun(id) {
  const run = loadRun(id);
  const runDir = runDirOf(id);
  const rig = resolveRig(run.rig);
  const workflow = loadWorkflow(run.workflow);
  const loops = {};
  // True per-step execution count for telemetry: `loops` only increments for
  // the step that failed, so a looped-back step would repeat attempt numbers.
  // Agent steps report their file-derived attempt instead (resume-safe).
  const execCounts = {};

  try {
    tRun(run);
    // Preflight before any worktree or agent step: fail fast on broken external
    // CLI contracts (resumes re-verify too — a resume after a hot-patch was
    // exactly the smoke-run scenario).
    if (process.env.FACTORY_RUN_NO_PREFLIGHT !== "1") {
      const pfStarted = nowIso();
      log(runDir, "preflight: verifying external CLI contracts");
      const pf = runPreflight([run.rig]);
      for (const p of pf.probes) log(runDir, `preflight ${p.ok ? "ok" : "FAIL"} ${p.name}: ${p.detail}`);
      try {
        tStep(id, "preflight", 1, pf.ok ? "ok" : "fail", pf.summary, pfStarted);
      } catch {}
      if (!pf.ok) {
        const summary = `preflight failed: ${pf.summary} (skip with FACTORY_RUN_NO_PREFLIGHT=1)`;
        setState(run, "failed", summary);
        notify(run, `:x: Run ${id} ${summary}\nRun dir: ${runDir}`);
        return;
      }
    }
    // Worktree setup (idempotent on resume). Read-only workflows (self-review)
    // set "worktree": false and run agent steps against the live checkout.
    if (workflow.worktree === false) {
      run.worktree = rig.path;
      saveRun(run);
    } else if (!fs.existsSync(run.worktree)) {
      setState(run, "setup", "creating worktree");
      fs.mkdirSync(WORKTREES_DIR, { recursive: true });
      sh(`git -C ${JSON.stringify(rig.path)} worktree add ${JSON.stringify(run.worktree)} -b factory/${id} ${rig.defaultBranch}`);
      log(runDir, `worktree created at ${run.worktree} (branch factory/${id})`);
      const setupLog = path.join(runDir, "setup.log");
      for (const cmd of rig.setup || []) {
        log(runDir, `setup: ${cmd}`);
        const r = runCommand(cmd, run.worktree, setupLog, 30);
        if (!r.ok) throw new Error(`setup failed: ${cmd} (see setup.log)`);
      }
    }

    let i = run.stepIndex || 0;
    while (i < workflow.steps.length) {
      const step = workflow.steps[i];
      run.stepIndex = i;
      let result;
      const stepStarted = nowIso();
      execCounts[step.id] = (execCounts[step.id] || 0) + 1;

      if (step.type === "agent") {
        setState(run, `running:${step.id}`, null);
        notify(run, `:gear: Run ${id} (${run.rig}): step *${step.id}* started.`);
        result = runAgentStep(run, step);
        if (result.ok && step.id === "review") {
          result = { ...evaluateReview(run), attempt: result.attempt, usage: result.usage };
        }
        if (result.ok && step.id === "implement") recordCommits(run);
      } else if (step.type === "commands") {
        setState(run, `running:${step.id}`, null);
        result = runCommandsStep(run, step, rig);
      } else if (step.type === "gate") {
        result = waitForGate(run, step);
        if (result.ok) setState(run, "approved", result.summary);
      } else if (step.type === "deploy") {
        setState(run, "deploying", null);
        result = deployStep(run, rig);
        if (result.ok) {
          run.artifactUrl = result.url || null;
          run.qrPath = result.qrPath || null;
          saveRun(run);
        }
      } else if (step.type === "notify") {
        const planTitle = (() => {
          try {
            return fs.readFileSync(path.join(runDir, "plan.md"), "utf8").split("\n")[0].replace(/^#\s*/, "");
          } catch {
            return run.prompt.slice(0, 80);
          }
        })();
        const lines = [
          `:white_check_mark: Run ${id} complete: *${planTitle}*`,
          `Rig: ${run.rig} · branch \`factory/${id}\` · worktree kept for merge review`,
          run.artifactUrl ? `Install/preview: ${run.artifactUrl}` : "No deployable artifact for this rig.",
          `Merge when happy: \`git -C ${rig.path} merge factory/${id}\` (or ask the chief of staff).`,
        ];
        const usage = usageLine(id);
        if (usage) lines.push(usage);
        notify(run, lines.join("\n"), run.qrPath);
        result = { ok: true, summary: "founder notified" };
      } else if (step.type === "spawn") {
        // Self-improvement chain: launch a full workflow run (its own graph
        // execution) with the approved plan as the prompt.
        setState(run, `running:${step.id}`, null);
        const planFile = path.join(runDir, step.promptFrom || "improvement-plan.md");
        if (!fs.existsSync(planFile)) {
          result = { ok: false, summary: `spawn: missing ${step.promptFrom}` };
        } else {
          const childPrompt = fs.readFileSync(planFile, "utf8");
          const childId = createRun({
            rig: step.rig || run.rig,
            workflow: step.workflow,
            prompt: childPrompt,
            auto: step.auto !== false, // plan was already founder-approved at this run's gate
            parentRun: run.id,
          });
          run.childRun = childId;
          saveRun(run);
          notify(run, `:rocket: Run ${id} spawned implementation run *${childId}* (${step.workflow} on ${step.rig || run.rig}) from the approved improvement plan. It will implement, validate, and deploy through the standard pipeline.`);
          result = { ok: true, summary: `spawned ${childId}` };
        }
      } else if (step.type === "manual") {
        result = { ok: true, summary: `manual step: ${step.note || ""}` };
      } else {
        result = { ok: false, summary: `unknown step type ${step.type}` };
      }

      log(runDir, `step '${step.id}': ${result.ok ? "OK" : "FAIL"} (${result.summary})`);
      try {
        tStep(id, step.id, result.attempt || execCounts[step.id], result.ok ? "ok" : "fail", result.summary, stepStarted, result.usage);
        if (run.artifactUrl && step.type === "deploy" && result.ok) tArtifact(id, "deploy", "artifact_url", run.artifactUrl);
      } catch {}

      if (!result.ok) {
        if (result.terminal) {
          setState(run, "rejected", result.summary);
          notify(run, `:no_entry: Run ${id} stopped: ${result.summary}`);
          return;
        }
        if (step.onFail) {
          loops[step.id] = (loops[step.id] || 0) + 1;
          if (loops[step.id] <= (step.maxLoops || 1)) {
            const backIdx = workflow.steps.findIndex((s) => s.id === step.onFail);
            log(runDir, `looping back to '${step.onFail}' (attempt ${loops[step.id]}/${step.maxLoops})`);
            notify(run, `:arrows_counterclockwise: Run ${id}: *${step.id}* failed validation, looping back to *${step.onFail}* (attempt ${loops[step.id]}/${step.maxLoops}).\n${result.summary}`);
            i = backIdx;
            continue;
          }
        }
        setState(run, "failed", result.summary);
        {
          const usage = usageLine(id);
          notify(run, `:x: Run ${id} FAILED at step *${step.id}*: ${result.summary}\nRun dir: ${runDir}${usage ? `\n${usage}` : ""}`);
        }
        return;
      }
      i += 1;
      run.stepIndex = i;
      saveRun(run);
    }
    setState(run, "done", null);
    // Reclaim the worktree/branch when already merged (harness-merge rigs
    // merge during deploy). Manual-merge rigs skip as unmerged, preserving the
    // "worktree kept for merge review" flow. A cleanup failure must never
    // change the run's terminal state.
    try {
      const c = cleanupRun(run, {});
      log(runDir, `cleanup: ${c.action} (${c.reason})`);
    } catch (err) {
      log(runDir, `cleanup error (run stays done): ${String(err.message || err)}`);
    }
  } catch (err) {
    setState(run, "failed", String(err.message || err));
    notify(run, `:x: Run ${id} crashed: ${String(err.message || err).slice(0, 500)}`);
    throw err;
  }
}

// ---------- commands ----------

function createRun({ rig: rigName, workflow: wfName, prompt, auto, parentRun }) {
  const rig = resolveRig(rigName);
  loadWorkflow(wfName);
  const slug = slugify(prompt);
  const base = `${wfName.split("-")[0]}-${slug || Date.now().toString(36)}`;
  const id = uniqueRunId(base, (candidate) => fs.existsSync(runDirOf(candidate)));
  const runDir = runDirOf(id);
  fs.mkdirSync(runDir, { recursive: true });
  const run = {
    id,
    workflow: wfName,
    rig: rigName,
    prompt,
    auto: !!auto,
    parentRun: parentRun || null,
    baseBranch: rig.defaultBranch,
    worktree: path.join(WORKTREES_DIR, id),
    state: "queued",
    stepIndex: 0,
    artifactUrl: null,
    qrPath: null,
    createdAt: nowIso(),
    updatedAt: nowIso(),
    history: [],
  };
  saveRun(run);
  try {
    tRun(run);
  } catch {}
  // Detach the executor so the caller (Slack skill / spawning run) returns immediately.
  detachExec(id);
  return id;
}

function cmdStart(argv) {
  const rigName = argOf(argv, "--rig");
  const wfName = argOf(argv, "--workflow") || "feature-dev";
  const prompt = argOf(argv, "--prompt");
  const auto = argv.includes("--auto");
  if (!rigName || !prompt) {
    console.error('usage: factory-run start --rig <name> --workflow <wf> --prompt "<text>" [--auto]');
    process.exit(1);
  }
  console.log(createRun({ rig: rigName, workflow: wfName, prompt, auto }));
}

function cmdReport(argv) {
  const days = Number(argOf(argv, "--days") || 30);
  const asJson = argv.includes("--json");
  // Backfill any runs on disk that predate telemetry (runs, engine.log step
  // outcomes, review verdicts/findings, deploy artifacts).
  if (fs.existsSync(RUNS_DIR)) {
    const db = tdb();
    for (const d of fs.readdirSync(RUNS_DIR)) {
      const r = readJson(path.join(RUNS_DIR, d, "run.json"), null);
      if (!r) continue;
      tRun(r);
      tRunState(r);
      // Backfill per-step cost/tokens from each step's claude JSON output, for
      // rows that predate usage capture (only touches NULL cost_usd rows).
      for (const f of fs.readdirSync(path.join(RUNS_DIR, d))) {
        const m = f.match(/^(.+)\.output\.json$/);
        if (!m) continue;
        const u = parseUsage(readJson(path.join(RUNS_DIR, d, f), null));
        if (!u || u.costUsd == null) continue;
        db.prepare(
          `UPDATE steps SET cost_usd = ?, input_tokens = ?, output_tokens = ?, cache_read_tokens = ?, cache_creation_tokens = ?
           WHERE run_id = ? AND step_id = ? AND cost_usd IS NULL`
        ).run(u.costUsd, u.inputTokens, u.outputTokens, u.cacheReadTokens, u.cacheCreationTokens, r.id, m[1]);
      }
      const hasSteps = db.prepare(`SELECT COUNT(*) n FROM steps WHERE run_id = ?`).get(r.id).n > 0;
      if (!hasSteps) {
        const logPath = path.join(RUNS_DIR, d, "engine.log");
        if (fs.existsSync(logPath)) {
          const re = /^\[([^\]]+)\] step '([^']+)': (OK|FAIL) \((.*)\)$/;
          for (const line of fs.readFileSync(logPath, "utf8").split("\n")) {
            const m = line.match(re);
            if (m) {
              db.prepare(`INSERT INTO steps (run_id, step_id, attempt, status, summary, started_at, finished_at, duration_s) VALUES (?,?,?,?,?,?,?,NULL)`)
                .run(r.id, m[2], 1, m[3] === "OK" ? "ok" : "fail", m[4].slice(0, 1000), m[1], m[1]);
            }
          }
        }
        const review = readJson(path.join(RUNS_DIR, d, "review.json"), null);
        if (review && review.verdict) {
          tArtifact(r.id, "review", "review_verdict", review.verdict);
          for (const f of review.findings || []) tArtifact(r.id, "review", "finding", f);
        }
        if (r.artifactUrl) tArtifact(r.id, "deploy", "artifact_url", r.artifactUrl);
      }
    }
  }
  const since = new Date(Date.now() - days * 864e5).toISOString();
  const db = tdb();
  const runs = db.prepare(`SELECT * FROM runs WHERE created_at >= ? ORDER BY created_at DESC`).all(since);
  const stepStats = db
    .prepare(
      `SELECT s.step_id, COUNT(*) n, SUM(s.status = 'fail') fails, ROUND(AVG(s.duration_s), 1) avg_s, MAX(s.attempt) max_attempt,
              ROUND(SUM(COALESCE(s.cost_usd,0)), 2) cost, ROUND(AVG(s.cost_usd), 3) avg_cost,
              SUM(COALESCE(s.input_tokens,0) + COALESCE(s.cache_read_tokens,0) + COALESCE(s.cache_creation_tokens,0)) in_tok,
              SUM(COALESCE(s.output_tokens,0)) out_tok
       FROM steps s JOIN runs r ON r.id = s.run_id WHERE r.created_at >= ? GROUP BY s.step_id ORDER BY n DESC`
    )
    .all(since);
  const totals = db
    .prepare(
      `SELECT ROUND(SUM(COALESCE(s.cost_usd,0)), 2) cost,
              SUM(COALESCE(s.input_tokens,0) + COALESCE(s.cache_read_tokens,0) + COALESCE(s.cache_creation_tokens,0)) in_tok,
              SUM(COALESCE(s.output_tokens,0)) out_tok
       FROM steps s JOIN runs r ON r.id = s.run_id WHERE r.created_at >= ?`
    )
    .get(since);
  const findings = db
    .prepare(
      `SELECT a.run_id, a.value FROM artifacts a JOIN runs r ON r.id = a.run_id
       WHERE a.type = 'finding' AND r.created_at >= ? ORDER BY a.created_at DESC LIMIT 25`
    )
    .all(since);
  const failures = db
    .prepare(
      `SELECT s.run_id, s.step_id, s.summary FROM steps s JOIN runs r ON r.id = s.run_id
       WHERE s.status = 'fail' AND r.created_at >= ? ORDER BY s.finished_at DESC LIMIT 15`
    )
    .all(since);
  const artifacts = db
    .prepare(
      `SELECT a.run_id, a.type, a.value FROM artifacts a JOIN runs r ON r.id = a.run_id
       WHERE a.type IN ('artifact_url', 'harness_merge_commit', 'commit') AND r.created_at >= ?
       ORDER BY a.created_at DESC LIMIT 40`
    )
    .all(since);
  const runUsageMap = Object.fromEntries(runs.map((r) => [r.id, runUsage(r.id)]));
  if (asJson) {
    console.log(JSON.stringify({ since, totals, runs, runUsage: runUsageMap, stepStats, findings, failures, artifacts }, null, 2));
    return;
  }
  const lines = [`# Factory run report (last ${days} days, since ${since})`, ""];
  lines.push(
    `**Total cost:** $${(totals.cost || 0).toFixed(2)} · **tokens in:** ${fmtTokens(totals.in_tok || 0)} · **out:** ${fmtTokens(totals.out_tok || 0)}`,
    ""
  );
  lines.push(`## Runs (${runs.length})`, "");
  lines.push("| id | workflow | rig | state | created | cost | tok in/out | prompt |", "|---|---|---|---|---|---|---|---|");
  for (const r of runs) {
    const u = runUsageMap[r.id];
    const cost = u && u.pricedSteps ? `$${u.costUsd.toFixed(2)}` : "—";
    const tok = u && u.pricedSteps ? `${fmtTokens(u.inputTokens)}/${fmtTokens(u.outputTokens)}` : "—";
    lines.push(`| ${r.id} | ${r.workflow} | ${r.rig} | ${r.state} | ${r.created_at.slice(0, 16)} | ${cost} | ${tok} | ${(r.prompt || "").replace(/\n/g, " ").slice(0, 60)} |`);
  }
  lines.push("", "## Step statistics", "", "| step | executions | failures | avg seconds | avg cost | total cost | tok in/out | max attempt |", "|---|---|---|---|---|---|---|---|");
  for (const s of stepStats) {
    const avgCost = s.avg_cost != null ? `$${Number(s.avg_cost).toFixed(3)}` : "—";
    const totCost = s.cost ? `$${Number(s.cost).toFixed(2)}` : "—";
    const tok = s.in_tok ? `${fmtTokens(s.in_tok)}/${fmtTokens(s.out_tok)}` : "—";
    lines.push(`| ${s.step_id} | ${s.n} | ${s.fails} | ${s.avg_s} | ${avgCost} | ${totCost} | ${tok} | ${s.max_attempt} |`);
  }
  lines.push("", "## Recent step failures", "");
  for (const f of failures) lines.push(`- [${f.run_id} / ${f.step_id}] ${(f.summary || "").replace(/\n/g, " ").slice(0, 200)}`);
  lines.push("", "## Recent review findings", "");
  for (const f of findings) lines.push(`- [${f.run_id}] ${(f.value || "").replace(/\n/g, " ").slice(0, 200)}`);
  lines.push("", "## Recent artifacts (commits, deploys)", "");
  for (const a of artifacts) lines.push(`- [${a.run_id}] ${a.type}: ${(a.value || "").replace(/\n/g, " ").slice(0, 160)}`);
  console.log(lines.join("\n"));
}

function detachExec(id) {
  const out = fs.openSync(path.join(runDirOf(id), "executor.log"), "a");
  const child = spawn(process.execPath, [__filename, "exec", id], {
    detached: true,
    stdio: ["ignore", out, out],
  });
  child.unref();
}

function cmdResume(id) {
  const run = loadRun(id); // validates
  if (["done", "cancelled"].includes(run.state)) {
    console.error(`run ${id} is ${run.state}; nothing to resume`);
    process.exit(1);
  }
  detachExec(id);
  console.log(`resumed ${id} at step ${run.stepIndex}`);
}

function cmdStatus(argv) {
  const fragment = argv.find((a) => !a.startsWith("--"));
  const id = fragment ? resolveRunId(fragment) : undefined;
  const asJson = argv.includes("--json");
  const ids = id ? [id] : fs.existsSync(RUNS_DIR) ? fs.readdirSync(RUNS_DIR).filter((d) => fs.existsSync(path.join(RUNS_DIR, d, "run.json"))) : [];
  const runs = ids.map((rid) => loadRun(rid)).sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
  if (asJson) {
    console.log(JSON.stringify(runs.map((r) => ({ ...r, usage: runUsage(r.id) })), null, 2));
    return;
  }
  for (const r of runs) {
    const wf = loadWorkflow(r.workflow);
    const step = wf.steps[Math.min(r.stepIndex, wf.steps.length - 1)];
    console.log(`${r.id}  ${r.state.padEnd(20)} ${r.rig.padEnd(20)} step ${r.stepIndex}/${wf.steps.length} (${step.id})  ${r.prompt.slice(0, 60)}`);
    const usage = usageLine(r.id);
    if (usage) console.log(`  ${usage.replace(/:moneybag: /, "")}`);
    if (id) {
      for (const h of r.history.slice(-10)) console.log(`  ${h.at}  ${h.state}${h.detail ? ` — ${h.detail}` : ""}`);
      if (r.artifactUrl) console.log(`  artifact: ${r.artifactUrl}`);
      console.log(`  worktree: ${r.worktree}`);
      console.log(`  run dir:  ${runDirOf(r.id)}`);
    }
  }
  if (runs.length === 0) console.log("no runs");
}

function cmdGate(id, decision, feedback) {
  loadRun(id); // validates
  writeJson(path.join(runDirOf(id), "gate-decision.json"), { decision, feedback: feedback || null, at: nowIso() });
  console.log(`${decision} recorded for ${id}`);
}

function cmdSteer(id, instruction) {
  loadRun(id);
  fs.appendFileSync(path.join(runDirOf(id), "steering.md"), `- [${nowIso()}] ${instruction}\n`);
  console.log(`steering recorded for ${id} (applies from the next agentic step)`);
}

function cmdCancel(id) {
  const run = loadRun(id);
  setState(run, "cancelled", "cancelled by founder");
  console.log(`cancelled ${id} (executor exits at the next step boundary; worktree kept)`);
}

function cmdPreflight(argv) {
  const rigName = argOf(argv, "--rig");
  const rigNames = rigName ? [rigName] : Object.keys(RIGS.rigs);
  const { ok, probes } = runPreflight(rigNames);
  for (const p of probes) console.log(`${p.ok ? "ok  " : "FAIL"} ${p.name}: ${p.detail}`);
  if (!ok) {
    console.error("\nPREFLIGHT FAILED (run-start preflight can be skipped with FACTORY_RUN_NO_PREFLIGHT=1)");
    process.exit(1);
  }
  console.log("\npreflight green");
}

function cmdSelftest() {
  const problems = [];
  const okMark = (b) => (b ? "ok" : "MISSING");
  for (const name of Object.keys(RIGS.rigs)) {
    const rig = resolveRig(name);
    const exists = fs.existsSync(rig.path) && fs.existsSync(path.join(rig.path, ".git"));
    console.log(`rig ${name}: path ${okMark(exists)} (${rig.path})`);
    if (!exists) problems.push(`rig ${name} path missing`);
    try {
      const branch = sh(`git -C ${JSON.stringify(rig.path)} rev-parse --verify ${rig.defaultBranch}`, {}).trim();
      console.log(`rig ${name}: base branch ${rig.defaultBranch} ok (${branch.slice(0, 8)})`);
    } catch {
      problems.push(`rig ${name}: base branch ${rig.defaultBranch} not found`);
    }
  }
  for (const wf of ["feature-dev", "bug-fix"]) {
    const w = loadWorkflow(wf);
    for (const s of w.steps) {
      if (s.type === "agent" && !fs.existsSync(path.join(ORCH_DIR, "prompts", `${s.prompt}.md`))) {
        problems.push(`workflow ${wf}: missing prompt ${s.prompt}`);
      }
    }
    console.log(`workflow ${wf}: ${w.steps.length} steps ok`);
  }
  for (const bin of ["claude", "openclaw", "git", "npx"]) {
    const found = spawnSync("which", [bin], { encoding: "utf8" }).status === 0;
    console.log(`binary ${bin}: ${okMark(found)}`);
    if (!found) problems.push(`binary ${bin} not on PATH`);
  }
  // Run-id minting and resolution (pure — nothing touches RUNS_DIR).
  const throws = (fn, re) => {
    try {
      fn();
      return false;
    } catch (err) {
      return re.test(String(err.message));
    }
  };
  const fakeIds = ["feature-version-badge", "feature-version-badge-2", "bug-leaked-sockets", "feature-msdn5cuj"];
  const idChecks = [
    ["slug derivation", slugify("Add a version badge to the settings screen") === "version-badge-settings"],
    ["slug charset/length", /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slugify("Fix the LEAKED sockets!! ASAP")) && slugify("Fix the LEAKED sockets!! ASAP").length <= 28],
    ["degenerate prompt falls back", slugify("!!! \u{1F680}") === ""],
    ["collision suffixing", uniqueRunId("feature-version-badge", (id) => fakeIds.includes(id)) === "feature-version-badge-3"],
    ["exact id wins over prefix", resolveRunIdFrom("feature-version-badge", fakeIds) === "feature-version-badge"],
    ["unique prefix resolves", resolveRunIdFrom("bug-leak", fakeIds) === "bug-leaked-sockets"],
    ["unique substring resolves", resolveRunIdFrom("leaked-sockets", fakeIds) === "bug-leaked-sockets"],
    ["legacy id resolves", resolveRunIdFrom("feature-msdn5cuj", fakeIds) === "feature-msdn5cuj"],
    ["ambiguous fragment rejected", throws(() => resolveRunIdFrom("feature-", fakeIds), /^ambiguous run id 'feature-': matches feature-msdn5cuj, feature-version-badge, feature-version-badge-2$/)],
    ["no-match fragment rejected", throws(() => resolveRunIdFrom("zzz", fakeIds), /no such run/)],
  ];
  for (const [name, ok] of idChecks) {
    console.log(`run-id ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`run-id check failed: ${name}`);
  }
  // Cleanup decision core (pure — no git or filesystem access).
  const cls = (over, opts) =>
    classifyCleanup({ state: "done", worktreeExists: true, branchExists: true, dirty: false, merged: true, ...over }, opts).action;
  const cleanupChecks = [
    ["in-flight run skipped", cls({ state: "running:implement" }) === "skip"],
    ["dirty worktree skipped even when merged", cls({ dirty: true }) === "skip"],
    ["unmerged branch skipped by default", cls({ merged: false }) === "skip"],
    ["merged and clean reclaimed", cls({}) === "clean"],
    ["failed run with merged branch reclaimed", cls({ state: "failed" }) === "clean"],
    ["branch gone, clean worktree removed", cls({ branchExists: false, merged: false }) === "clean"],
    ["worktree gone, merged branch deleted", cls({ worktreeExists: false }) === "clean"],
    ["nothing left is a no-op", cls({ worktreeExists: false, branchExists: false, merged: false }) === "none"],
    ["unmerged worktree removal is opt-in", cls({ merged: false }, { removeUnmergedWorktrees: true }) === "remove-worktree"],
    ["opt-in never deletes the unmerged branch", cls({ merged: false, worktreeExists: false }, { removeUnmergedWorktrees: true }) === "skip"],
  ];
  for (const [name, ok] of cleanupChecks) {
    console.log(`cleanup ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`cleanup check failed: ${name}`);
  }
  // Harness-merge web-restart decision core (pure).
  const webChecks = [
    ["engine-only merge skips web restart", classifyWebRestart(["orchestration/bin/factory-run", "orchestration/prompts/implement.md"]).restart === false],
    ["server change restarts web", classifyWebRestart(["orchestration/web/server.mjs"]).restart === true],
    ["web lib change restarts web", classifyWebRestart(["orchestration/web/lib/runs.mjs"]).restart === true],
    ["factory-web script change restarts web", classifyWebRestart(["orchestration/bin/factory-web-down"]).restart === true],
    ["backend-only change keeps frontend build", classifyWebRestart(["orchestration/web/server.mjs"]).rebuildFrontend === false],
    ["frontend change forces rebuild", classifyWebRestart(["orchestration/web/frontend/src/App.tsx"]).rebuildFrontend === true],
    ["empty diff is a no-op", classifyWebRestart([""]).restart === false],
  ];
  for (const [name, ok] of webChecks) {
    console.log(`web-restart ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`web-restart check failed: ${name}`);
  }
  // Per-attempt step document naming/derivation (pure — no filesystem access).
  const docChecks = [
    ["first attempt unsuffixed", stepDocName("implement", "prompt", 1) === "implement.prompt.md"],
    ["retry attempts suffixed", stepDocName("implement", "output", 3) === "implement.3.output.json"],
    ["empty dir means no attempts", maxStepAttempt([], "implement") === 0],
    ["unsuffixed file reads as attempt 1", maxStepAttempt(["implement.prompt.md", "plan.md"], "implement") === 1],
    ["highest suffix wins across kinds", maxStepAttempt(["implement.prompt.md", "implement.2.prompt.md", "implement.3.output.json"], "implement") === 3],
    ["other steps' files ignored", maxStepAttempt(["review.2.prompt.md", "review.output.json"], "implement") === 0],
  ];
  for (const [name, ok] of docChecks) {
    console.log(`step-doc ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`step-doc check failed: ${name}`);
  }
  if (problems.length) {
    console.error(`\nSELFTEST FAILED:\n- ${problems.join("\n- ")}`);
    process.exit(1);
  }
  console.log("\nselftest green");
}

function argOf(argv, flag) {
  const i = argv.indexOf(flag);
  return i !== -1 ? argv[i + 1] : undefined;
}

// ---------- main ----------

const [, , cmd, ...rest] = process.argv;
try {
  if (cmd === "start") cmdStart(rest);
  else if (cmd === "exec") execRun(rest[0]);
  else if (cmd === "resume") cmdResume(resolveRunId(rest[0]));
  else if (cmd === "status" || cmd === "list") cmdStatus(rest);
  else if (cmd === "approve") cmdGate(resolveRunId(rest[0]), "approve");
  else if (cmd === "reject") cmdGate(resolveRunId(rest[0]), "reject", rest[1]);
  else if (cmd === "steer") cmdSteer(resolveRunId(rest[0]), rest.slice(1).join(" "));
  else if (cmd === "cancel") cmdCancel(resolveRunId(rest[0]));
  else if (cmd === "cleanup") cmdCleanup(rest);
  else if (cmd === "preflight") cmdPreflight(rest);
  else if (cmd === "selftest") cmdSelftest();
  else if (cmd === "report") cmdReport(rest);
  else {
    console.log("factory-run <start|exec|resume|status|list|approve|reject|steer|cancel|cleanup|report|preflight|selftest>");
    process.exit(cmd ? 1 : 0);
  }
} catch (err) {
  console.error(`error: ${err.message || err}`);
  process.exit(1);
}
