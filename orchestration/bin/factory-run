    if (!ok) problems.push(`recovery check failed: ${name}`);
  }
  // Resume step rewind (pure — no run dirs touched).
  const wfSteps = ["plan", "plan-discussion", "implement", "checks", "review", "tests", "deploy", "notify"];
  const resumeChecks = [
    ["plain resume keeps the current step", resolveResumeStep(wfSteps, 6, {}) === 6],
    ["--step rewinds to an earlier step", resolveResumeStep(wfSteps, 6, { step: "checks" }) === 3],
    ["--step accepts the current step", resolveResumeStep(wfSteps, 6, { step: "deploy" }) === 6],
    ["--back rewinds one step", resolveResumeStep(wfSteps, 6, { back: true }) === 5],
    ["--back at the first step stays put", resolveResumeStep(wfSteps, 0, { back: true }) === 0],
    ["unknown step rejected", throws(() => resolveResumeStep(wfSteps, 6, { step: "nope" }), /unknown step 'nope'/)],
    ["later-than-current step rejected", throws(() => resolveResumeStep(wfSteps, 3, { step: "deploy" }), /resume can only rewind/)],
