  const tGarbage = resultFromTranscript(["total garbage", "{}", "[1,2]"]);
  const tStats = transcriptStats([assistantEv, assistantEv, resultEv, "garbage"]);
  const transcriptChecks = [
    ["result event yields the envelope", tNormal.result !== null && tNormal.result.result === "IMPLEMENTED"],
    ["result event yields usage with cost", tNormal.usage !== null && tNormal.usage.costUsd === 1.5 && tNormal.usage.cacheReadTokens === 1000],
    ["truncated transcript falls back to assistant usage", tTruncated.result === null && tTruncated.usage !== null && tTruncated.usage.cacheReadTokens === 600 && tTruncated.usage.costUsd === null],
    ["garbage-only transcript yields nothing", tGarbage.result === null && tGarbage.usage === null],
    ["assistant turns counted", tStats.assistantTurns === 2],
    ["tool_use counted by name", tStats.toolUses.Bash === 2],
    ["models deduped", tStats.models.length === 1 && tStats.models[0] === "claude-opus-5"],
    ["session roles counted, garbage skipped", JSON.stringify(sessionMessageCounts(['{"type":"message","message":{"role":"user"}}', '{"type":"message","message":{"role":"assistant"}}', '{"type":"session"}', "junk"])) === JSON.stringify({ user: 1, assistant: 1 })],
  ];
  for (const [name, ok] of transcriptChecks) {
    console.log(`transcript ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`transcript check failed: ${name}`);
  }
  if (problems.length) {
    console.error(`\nSELFTEST FAILED:\n- ${problems.join("\n- ")}`);
    process.exit(1);
  }
  console.log("\nselftest green");
}

function argOf(argv, flag) {
  const i = argv.indexOf(flag);
  return i !== -1 ? argv[i + 1] : undefined;
}

// ---------- main ----------

const [, , cmd, ...rest] = process.argv;
try {
  if (cmd === "start") cmdStart(rest);
  else if (cmd === "exec") execRun(rest[0]);
  else if (cmd === "resume") cmdResume(rest);
  else if (cmd === "retry") cmdRetry(rest);
  else if (cmd === "status" || cmd === "list") cmdStatus(rest);
  else if (cmd === "approve") cmdGate(resolveRunId(rest[0]), "approve");
  else if (cmd === "reject") cmdGate(resolveRunId(rest[0]), "reject", rest[1]);
  else if (cmd === "reply") cmdReply(resolveRunId(rest[0]), rest.slice(1).join(" "));
  else if (cmd === "steer") cmdSteer(resolveRunId(rest[0]), rest.slice(1).join(" "));
  else if (cmd === "cancel") cmdCancel(resolveRunId(rest[0]));
  else if (cmd === "cleanup") cmdCleanup(rest);
  else if (cmd === "preflight") cmdPreflight(rest);
  else if (cmd === "selftest") cmdSelftest();
  else if (cmd === "report") cmdReport(rest);
  else if (cmd === "context") cmdContext(rest);
  else {
    console.log("factory-run <start|exec|resume|retry|status|list|approve|reject|reply|steer|cancel|cleanup|report|context|preflight|selftest>");
    process.exit(cmd ? 1 : 0);
  }
} catch (err) {
  console.error(`error: ${err.message || err}`);
  process.exit(1);
}
