    ["recently-updated run is not stuck", rt({ state: "running:implement" }, { now: Date.parse(rtT0) + 5 * 60 * 1000 }).eligible === false],
    ["done/awaiting-approval refused", rt({ state: "done" }).eligible === false && rt({ state: "awaiting-approval" }).eligible === false],
