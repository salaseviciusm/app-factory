    ["recovery-cap escalation goes straight to triage", rt({}, { lastFailure: "deploy recovery escalation: recovery cap reached (5/5 cycles)" }).tier === "triage"],
    ["escalation.md goes straight to triage", rt({}, { escalationPresent: true }).tier === "triage"],
