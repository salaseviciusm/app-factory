    if (!ok) problems.push(`web-restart check failed: ${name}`);
  }
  // Deploy-recovery decision core (pure — no git access). The cap semantics:
  // `iterations` counts cycles already burned, so the 5th attempt (4 burned)
  // still runs and a 6th (5 burned) escalates instead of rebasing.
  const rec = (over) => classifyRecovery({ drifted: true, conflicted: false, iterations: 0, ...over }).action;
  const recoveryChecks = [
    ["no drift merges untouched", rec({ drifted: false }) === "merge"],
    ["no drift merges even at cap", rec({ drifted: false, iterations: RECOVERY_CAP }) === "merge"],
    ["clean rebase re-verifies", rec({}) === "reverify"],
    ["conflicted rebase spawns resolution", rec({ conflicted: true }) === "resolve"],
    ["last capped attempt still runs", rec({ iterations: RECOVERY_CAP - 1 }) === "reverify"],
    ["attempt past the cap escalates", rec({ iterations: RECOVERY_CAP }) === "escalate"],
    ["conflict past the cap escalates too", rec({ conflicted: true, iterations: RECOVERY_CAP + 2 }) === "escalate"],
