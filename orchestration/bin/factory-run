#!/usr/bin/env node
/*
 * factory-run: the App Factory run engine.
 *
 * Executes workflow DAGs (feature-dev, bug-fix) against registered rigs:
 * git worktree per run, Claude Code sessions per agentic step, deterministic
 * checks + cross-model agentic review, EAS deploy, Slack notifications with
 * QR code via the OpenClaw gateway.
 *
 * Design doc: docs/08-orchestration-layer.md. Zero npm dependencies.
 *
 * Commands:
 *   factory-run start --rig <name> --workflow <wf> --prompt "<text>" [--auto]
 *   factory-run exec <run_id>            (internal: runs the step loop in-process)
 *   factory-run resume <run_id> [--step <step-id>|--back]
 *                                        (restart a stopped/failed run's executor,
 *                                         optionally rewound to an earlier step)
 *   factory-run retry <run_id> [--force] (failed/stuck run recovery: first retry at
 *                                         a step plain-resumes; repeats and
 *                                         resume-can't-fix failures hand off to an
 *                                         OpenClaw triage session. --force kills a
 *                                         still-live executor first)
 *   factory-run status [<run_id>] [--json]
 *   factory-run list [--json]
 *   factory-run approve <run_id>
 *   factory-run reject <run_id> "<feedback>"
 *   factory-run reply <run_id> "<text>"     (founder turn in a discussion step)
 *   factory-run steer <run_id> "<instruction>"
 *   factory-run cancel <run_id>
 *   factory-run cleanup [--dry-run] [--json] [--remove-unmerged-worktrees]
 *   factory-run context <run_id> [--json]  (per-step context/cost analysis)
 *   factory-run context --sessions [--sessions-dir <dir>] [--days N]
 *   factory-run preflight [--rig <name>]   (live external-CLI contract checks)
 *   factory-run selftest
 *
 * Run ids are readable task slugs (<workflow-prefix>-<slug>, e.g.
 * feature-version-badge). Every <run_id> above except `exec` also accepts any
 * unambiguous prefix or substring of an id.
 */
"use strict";

const fs = require("fs");
const os = require("os");
const path = require("path");
const { execSync, spawnSync, spawn } = require("child_process");

const ORCH_DIR = path.resolve(__dirname, "..");
// Company agent profiles (repo-root agents/, sibling of orchestration/), read
// from the main checkout like prompts/ — never from a run's worktree. Only
// top-level .md files are addressable; agents/dormant/ is intentionally not.
const AGENTS_DIR = path.join(ORCH_DIR, "..", "agents");
const RUNS_DIR = path.join(ORCH_DIR, "runs");
const WORKTREES_DIR = path.join(ORCH_DIR, "worktrees");
const RIGS = JSON.parse(fs.readFileSync(path.join(ORCH_DIR, "rigs.json"), "utf8"));
// Discussion-step pure core (reply parsing, conversation assembly, outcome
// resolution) lives in the web lib so `node --test web/lib/*.test.mjs` covers
// it; CJS require(esm) is stable on the node this repo runs.
const {
  DISCUSSION_DEFAULTS,
  parseReplyLines,
  assembleConversation,
  pendingReplies: countPendingReplies,
  lastActivityAt: discussionLastActivity,
  resolveOutcome,
} = require(path.join(ORCH_DIR, "web", "lib", "discussion.mjs"));
// Plan-profile lint core (strict plan markdown contract) — same web-lib
// require(esm) pattern; bin/plan-lint wraps it for agents' self-checks.
const { lintPlan } = require(path.join(ORCH_DIR, "web", "lib", "plan-md.mjs"));
// Retry pure core (stall predicate, executor-command matcher, eligibility/tier
// classifier) — same web-lib pattern, shared with the server and its tests.
// TERMINAL_STATES lives there too so all three consumers agree; "killed" is
// the discussion step's don't-build ending: terminal and a SUCCESS (early
// kill = money saved), never rendered as a failure.
const {
  TERMINAL_STATES,
  classifyRetry,
  matchesExecutor,
  lastFailureDetail,
} = require(path.join(ORCH_DIR, "web", "lib", "retry.mjs"));

// ---------- telemetry (SQLite, node:sqlite — structured artifacts; each agent
// step's full stream-json transcript lives in its run dir, see runAgentStep) ----------

let _tdb = null;
function tdb() {
  if (_tdb) return _tdb;
  const { DatabaseSync } = require("node:sqlite");
  _tdb = new DatabaseSync(path.join(ORCH_DIR, "telemetry.db"));
  _tdb.exec(`
    CREATE TABLE IF NOT EXISTS runs (
      id TEXT PRIMARY KEY, workflow TEXT, rig TEXT, prompt TEXT, state TEXT,
      auto INTEGER, parent_run TEXT, created_at TEXT, finished_at TEXT
    );
    CREATE TABLE IF NOT EXISTS steps (
      run_id TEXT, step_id TEXT, attempt INTEGER, status TEXT, summary TEXT,
      started_at TEXT, finished_at TEXT, duration_s REAL
    );
    CREATE TABLE IF NOT EXISTS artifacts (
      run_id TEXT, step_id TEXT, type TEXT, value TEXT, created_at TEXT
    );
  `);
  // Migration: per-agent-step cost/token capture from the claude JSON output.
  // ALTER ... ADD COLUMN throws if the column already exists — idempotent by catch.
  for (const col of [
    "cost_usd REAL",
    "input_tokens INTEGER",
    "output_tokens INTEGER",
    "cache_read_tokens INTEGER",
    "cache_creation_tokens INTEGER",
  ]) {
    try {
      _tdb.exec(`ALTER TABLE steps ADD COLUMN ${col}`);
    } catch {}
  }
  return _tdb;
}

function tRun(run) {
  tdb()
    .prepare(
      `INSERT INTO runs (id, workflow, rig, prompt, state, auto, parent_run, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?)
       ON CONFLICT(id) DO UPDATE SET state = excluded.state`
    )
    .run(run.id, run.workflow, run.rig, run.prompt, run.state, run.auto ? 1 : 0, run.parentRun || null, run.createdAt);
}

function tRunState(run) {
  const terminal = TERMINAL_STATES.includes(run.state);
  tdb()
    .prepare(`UPDATE runs SET state = ?, finished_at = COALESCE(finished_at, ?) WHERE id = ?`)
    .run(run.state, terminal ? nowIso() : null, run.id);
}

function tStep(runId, stepId, attempt, status, summary, startedAt, usage) {
  const finished = nowIso();
  const dur = (Date.parse(finished) - Date.parse(startedAt)) / 1000;
  const u = usage || {};
  tdb()
    .prepare(
      `INSERT INTO steps (run_id, step_id, attempt, status, summary, started_at, finished_at, duration_s,
        cost_usd, input_tokens, output_tokens, cache_read_tokens, cache_creation_tokens)
       VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)`
    )
    .run(
      runId, stepId, attempt, status, (summary || "").slice(0, 1000), startedAt, finished, dur,
      u.costUsd ?? null, u.inputTokens ?? null, u.outputTokens ?? null,
      u.cacheReadTokens ?? null, u.cacheCreationTokens ?? null
    );
}

/** Extract cost/token usage from a parsed `claude --output-format json` result. */
function parseUsage(parsed) {
  if (!parsed || typeof parsed !== "object") return null;
  const u = parsed.usage || {};
  return {
    costUsd: typeof parsed.total_cost_usd === "number" ? parsed.total_cost_usd : null,
    inputTokens: u.input_tokens || 0,
    outputTokens: u.output_tokens || 0,
    cacheReadTokens: u.cache_read_input_tokens || 0,
    cacheCreationTokens: u.cache_creation_input_tokens || 0,
  };
}

/** Extract {result, usage} from stream-json transcript lines (pure, exercised
 *  by selftest). `result` is the `"type":"result"` event object (the prior
 *  `--output-format json` envelope) or null when the transcript was truncated
 *  by a timeout/kill; then `usage` falls back to the last assistant event's
 *  `message.usage` so failed attempts stop costing "null". Garbage lines are
 *  skipped, never thrown. */
function resultFromTranscript(lines) {
  let result = null;
  let lastAssistantUsage = null;
  for (const line of lines) {
    let ev;
    try {
      ev = JSON.parse(line);
    } catch {
      continue;
    }
    if (!ev || typeof ev !== "object") continue;
    if (ev.type === "result") result = ev;
    else if (ev.type === "assistant" && ev.message && ev.message.usage) lastAssistantUsage = ev.message.usage;
  }
  if (result) return { result, usage: parseUsage(result) };
  if (lastAssistantUsage) {
    const u = lastAssistantUsage;
    return {
      result: null,
      usage: {
        costUsd: null,
        inputTokens: u.input_tokens || 0,
        outputTokens: u.output_tokens || 0,
        cacheReadTokens: u.cache_read_input_tokens || 0,
        cacheCreationTokens: u.cache_creation_input_tokens || 0,
      },
    };
  }
  return { result: null, usage: null };
}

/** Deterministic transcript stats for `context` (pure, exercised by selftest):
 *  assistant turns, tool_use counts by tool name, models seen. Garbage lines
 *  are skipped, never thrown. */
function transcriptStats(lines) {
  const stats = { assistantTurns: 0, toolUses: {}, models: [] };
  const models = new Set();
  for (const line of lines) {
    let ev;
    try {
      ev = JSON.parse(line);
    } catch {
      continue;
    }
    if (!ev || typeof ev !== "object" || ev.type !== "assistant" || !ev.message) continue;
    stats.assistantTurns += 1;
    if (ev.message.model) models.add(ev.message.model);
    for (const block of Array.isArray(ev.message.content) ? ev.message.content : []) {
      if (block && block.type === "tool_use" && block.name) {
        stats.toolUses[block.name] = (stats.toolUses[block.name] || 0) + 1;
      }
    }
  }
  stats.models = [...models];
  return stats;
}

/** Sum cost/tokens across all telemetry step rows for a run (in-progress or done). */
function runUsage(runId) {
  try {
    const r = tdb()
      .prepare(
        `SELECT COALESCE(SUM(cost_usd),0) cost, COALESCE(SUM(input_tokens),0) in_tok,
                COALESCE(SUM(output_tokens),0) out_tok, COALESCE(SUM(cache_read_tokens),0) cache_read,
                COALESCE(SUM(cache_creation_tokens),0) cache_create,
                SUM(cost_usd IS NOT NULL) priced_steps
         FROM steps WHERE run_id = ?`
      )
      .get(runId);
    return {
      costUsd: r.cost || 0,
      inputTokens: (r.in_tok || 0) + (r.cache_read || 0) + (r.cache_create || 0),
      rawInputTokens: r.in_tok || 0,
      cacheReadTokens: r.cache_read || 0,
      cacheCreationTokens: r.cache_create || 0,
      outputTokens: r.out_tok || 0,
      pricedSteps: r.priced_steps || 0,
    };
  } catch {
    return null;
  }
}

function fmtTokens(n) {
  if (n >= 1e6) return `${(n / 1e6).toFixed(2)}M`;
  if (n >= 1e3) return `${(n / 1e3).toFixed(1)}k`;
  return String(n);
}

/** One-line Slack/CLI usage summary for a run, or "" if nothing priced yet. */
function usageLine(runId) {
  const u = runUsage(runId);
  if (!u || u.pricedSteps === 0) return "";
  return `:moneybag: Cost $${u.costUsd.toFixed(2)} · tokens in ${fmtTokens(u.inputTokens)} (${fmtTokens(u.cacheReadTokens)} cached) / out ${fmtTokens(u.outputTokens)} · ${u.pricedSteps} agent step(s)`;
}

function tArtifact(runId, stepId, type, value) {
  tdb()
    .prepare(`INSERT INTO artifacts (run_id, step_id, type, value, created_at) VALUES (?,?,?,?,?)`)
    .run(runId, stepId, type, String(value).slice(0, 2000), nowIso());
}

// ---------- helpers ----------

function expandHome(p) {
  return p.startsWith("~") ? path.join(os.homedir(), p.slice(1)) : p;
}

function nowIso() {
  return new Date().toISOString();
}

function log(runDir, msg) {
  const line = `[${nowIso()}] ${msg}`;
  console.log(line);
  if (runDir) fs.appendFileSync(path.join(runDir, "engine.log"), line + "\n");
}

function readJson(p, fallback) {
  try {
    return JSON.parse(fs.readFileSync(p, "utf8"));
  } catch {
    return fallback;
  }
}

function writeJson(p, obj) {
  fs.writeFileSync(p, JSON.stringify(obj, null, 2) + "\n");
}

function sh(cmd, opts = {}) {
  return execSync(cmd, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], ...opts });
}

/** Run a shell command, capturing output to a log file. Returns {ok, output}. */
function runCommand(cmd, cwd, logFile, timeoutMinutes = 30) {
  const res = spawnSync("bash", ["-lc", cmd], {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: timeoutMinutes * 60 * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  const output = (res.stdout || "") + (res.stderr || "");
  if (logFile) fs.appendFileSync(logFile, `\n$ ${cmd}\n${output}\n(exit ${res.status})\n`);
  return { ok: res.status === 0, output, status: res.status };
}

function resolveRig(name) {
  if (RIGS.rigs[name]) {
    const rig = { name, ...RIGS.rigs[name] };
    rig.path = expandHome(rig.path);
    return rig;
  }
  const m = name.match(/^factory:(.+)$/);
  if (m) {
    const appPath = path.join(expandHome(RIGS.factoryApps.basePath), m[1]);
    if (!fs.existsSync(appPath)) throw new Error(`factory app not found: ${appPath}`);
    return { name, path: appPath, ...RIGS.factoryApps, basePath: undefined };
  }
  throw new Error(`unknown rig: ${name}. Known: ${Object.keys(RIGS.rigs).join(", ")}, factory:<app>`);
}

function loadWorkflow(name) {
  const p = path.join(ORCH_DIR, "workflows", `${name}.json`);
  if (!fs.existsSync(p)) throw new Error(`unknown workflow: ${name}`);
  return JSON.parse(fs.readFileSync(p, "utf8"));
}

/** Every workflow step's file references, checked before any run record or
 *  worktree exists (createRun) and across all workflows by selftest. Agent and
 *  discussion steps: the prompt template must exist and, when the step names
 *  an `agent` profile, the name must be a plain slug (never usable as a path —
 *  no `../`) with a matching top-level agents/<agent>.md; discussion bounds
 *  must be sane numbers. Spawn steps: the child workflow must exist and
 *  rigFrom must stay a plain run-dir .json filename. Returns problem lines,
 *  [] when clean. */
function validateWorkflowAgentSteps(wfName, wf) {
  const problems = [];
  for (const s of wf.steps) {
    if (s.type === "agent" || s.type === "discussion") {
      if (!fs.existsSync(path.join(ORCH_DIR, "prompts", `${s.prompt}.md`))) {
        problems.push(`workflow ${wfName}: missing prompt ${s.prompt}`);
      }
      if (s.agent !== undefined) {
        if (!/^[a-z0-9-]+$/.test(String(s.agent))) {
          problems.push(`workflow ${wfName}: invalid agent name '${s.agent}' (must match /^[a-z0-9-]+$/)`);
        } else if (!fs.existsSync(path.join(AGENTS_DIR, `${s.agent}.md`))) {
          problems.push(`workflow ${wfName}: missing agent profile ${s.agent} (agents/${s.agent}.md)`);
        }
      }
      if (s.type === "discussion") {
        for (const cap of ["maxTurns", "idleTimeoutMinutes"]) {
          const v = s[cap];
          if (v !== undefined && (typeof v !== "number" || !Number.isFinite(v) || v < 1)) {
            problems.push(`workflow ${wfName}: discussion step '${s.id}' ${cap} '${v}' must be a number >= 1`);
          }
        }
      }
    } else if (s.type === "spawn") {
      if (typeof s.workflow !== "string" || !fs.existsSync(path.join(ORCH_DIR, "workflows", `${s.workflow}.json`))) {
        problems.push(`workflow ${wfName}: spawn step '${s.id}' references unknown workflow '${s.workflow}'`);
      }
      if (s.rigFrom !== undefined && !/^[a-z0-9][a-z0-9._-]*\.json$/.test(String(s.rigFrom))) {
        problems.push(`workflow ${wfName}: spawn step '${s.id}' rigFrom '${s.rigFrom}' must be a plain .json filename in the run dir`);
      }
    }
  }
  return problems;
}

function runDirOf(id) {
  return path.join(RUNS_DIR, id);
}

// Run ids are human-readable task slugs: <workflow-prefix>-<slug> derived from
// the prompt (e.g. feature-version-badge), numeric suffix only on collision.
// Degenerate prompts fall back to the legacy base36 timestamp shape. Every CLI
// verb accepts any unambiguous prefix or substring of an id (exec excepted).

const SLUG_STOPWORDS = new Set([
  "a", "an", "and", "are", "as", "at", "add", "be", "by", "can", "could", "create",
  "do", "fix", "for", "from", "in", "is", "it", "its", "make", "my", "need", "new",
  "of", "on", "or", "our", "please", "should", "so", "some", "that", "the", "then",
  "this", "to", "up", "update", "want", "we", "with", "would", "you", "your",
]);
const SLUG_MAX_LEN = 28;
const SLUG_MAX_WORDS = 4;

/** Derive a [a-z0-9-] slug from a prompt: first few meaningful words, capped at
 *  a word boundary. Returns "" when the prompt has no usable words. */
function slugify(prompt) {
  const words = String(prompt || "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, " ")
    .split(" ")
    .filter((w) => w && !SLUG_STOPWORDS.has(w))
    .slice(0, SLUG_MAX_WORDS);
  let slug = "";
  for (const w of words) {
    const next = slug ? `${slug}-${w}` : w;
    if (next.length > SLUG_MAX_LEN) break;
    slug = next;
  }
  return slug;
}

/** First free id among base, base-2, base-3, … (exists: (id) => bool). */
function uniqueRunId(base, exists) {
  let id = base;
  for (let n = 2; exists(id); n++) id = `${base}-${n}`;
  return id;
}

function listRunIds() {
  if (!fs.existsSync(RUNS_DIR)) return [];
  return fs.readdirSync(RUNS_DIR).filter((d) => fs.existsSync(path.join(RUNS_DIR, d, "run.json")));
}

/** Resolve a full id, unique id-prefix, or unique substring against `ids`.
 *  Pure core of resolveRunId, also exercised by selftest. */
function resolveRunIdFrom(input, ids) {
  if (!input) throw new Error("missing run id");
  if (ids.includes(input)) return input;
  const prefixed = ids.filter((d) => d.startsWith(input));
  // Prefix matches are a subset of substring matches, so an ambiguous prefix
  // can never be salvaged by the substring pass — error right away.
  const matches = prefixed.length ? prefixed : ids.filter((d) => d.includes(input));
  if (matches.length === 1) return matches[0];
  if (matches.length > 1) {
    throw new Error(`ambiguous run id '${input}': matches ${matches.sort().join(", ")}`);
  }
  throw new Error(`no such run: ${input}`);
}

function resolveRunId(input) {
  const id = resolveRunIdFrom(input, listRunIds());
  if (id !== input) console.error(`(resolved '${input}' -> ${id})`);
  return id;
}

function loadRun(id) {
  const p = path.join(runDirOf(id), "run.json");
  if (!fs.existsSync(p)) throw new Error(`no such run: ${id}`);
  return readJson(p);
}

function saveRun(run) {
  writeJson(path.join(runDirOf(run.id), "run.json"), run);
}

function setState(run, state, detail) {
  run.state = state;
  run.updatedAt = nowIso();
  run.history.push({ state, detail: detail || null, at: run.updatedAt });
  saveRun(run);
  try {
    tRunState(run);
  } catch {
    /* telemetry must never break a run */
  }
}

// ---------- notifications (OpenClaw -> Slack) ----------

/** Resolve ${VAR} placeholders from the environment or openclaw/secrets.env (IDs stay out of git). */
let _secretsEnv = null;
function resolvePlaceholders(str) {
  return str.replace(/\$\{(\w+)\}/g, (_, key) => {
    if (process.env[key]) return process.env[key];
    if (_secretsEnv === null) {
      _secretsEnv = {};
      const p = path.join(ORCH_DIR, "..", "openclaw", "secrets.env");
      if (fs.existsSync(p)) {
        for (const line of fs.readFileSync(p, "utf8").split("\n")) {
          const m = line.match(/^(\w+)=(.*)$/);
          if (m) _secretsEnv[m[1]] = m[2];
        }
      }
    }
    if (_secretsEnv[key]) return _secretsEnv[key];
    throw new Error(`unresolved placeholder \${${key}} (set it in env or openclaw/secrets.env)`);
  });
}

/** Per-rig Slack channel NAME for run notifications (pure core, exercised by
 *  selftest). Rig entries declare `notifyChannelName`; factory:<app> rigs
 *  render the factoryApps `${app}` template with the app name. The result is
 *  normalized to Slack's channel-name charset (lowercase, [a-z0-9_-], ≤80).
 *  Null when unconfigured → caller uses the global RIGS.notify fallback. */
function rigNotifyChannelName(rigName, rigs) {
  let name = null;
  if (rigs.rigs[rigName] && rigs.rigs[rigName].notifyChannelName) {
    name = rigs.rigs[rigName].notifyChannelName;
  } else {
    const m = String(rigName || "").match(/^factory:(.+)$/);
    if (m && rigs.factoryApps && rigs.factoryApps.notifyChannelName) {
      name = rigs.factoryApps.notifyChannelName.replace(/\$\{app\}/g, m[1]);
    }
  }
  if (!name) return null;
  name = name.toLowerCase().replace(/[^a-z0-9_-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 80);
  return name || null;
}

/** Channel name → C... ID via openclaw/lib/slack-channel.mjs (creates the
 *  channel on demand; on-disk cache keeps repeat calls off conversations.list).
 *  Null on any failure — never throws; successes are memoized per process,
 *  failures are not, so a transient Slack outage can heal mid-run. */
const _channelIdCache = new Map();
function slackChannelId(name) {
  if (_channelIdCache.has(name)) return _channelIdCache.get(name);
  const helper = path.join(ORCH_DIR, "..", "openclaw", "lib", "slack-channel.mjs");
  const res = spawnSync("node", [helper, name], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 60000,
  });
  const id = (res.stdout || "").trim();
  if (res.status !== 0 || !/^[CG][A-Z0-9]+$/.test(id)) return null;
  _channelIdCache.set(name, id);
  return id;
}

/**
 * The exact `openclaw message send` argv. Single source of truth: consumed by
 * the real notify() send AND the preflight contract probe, so the probe can
 * never drift from the real invocation.
 */
function notifyArgs(to, message, mediaPath) {
  const channel = (RIGS.notify && RIGS.notify.channel) || "slack";
  const args = [
    "message", "send",
    "--channel", channel,
    "--target", to,
    "-m", message,
  ];
  if (mediaPath) args.push("--media", mediaPath);
  return args;
}

/** Send a Slack notification. Returns true on success — and when notifications
 *  are deliberately disabled (no RIGS.notify / FACTORY_RUN_NO_NOTIFY=1): a
 *  disabled channel must not fail gates. Returns false on unresolved
 *  placeholder or non-zero exit.
 *
 *  Destination: the run's rig channel (rigNotifyChannelName, created on
 *  demand) when configured and resolvable; otherwise the global RIGS.notify.to
 *  — a routing problem degrades to the old single-channel behavior, never to a
 *  dropped notification. */
function notify(run, message, mediaPath) {
  const target = RIGS.notify;
  if (!target || process.env.FACTORY_RUN_NO_NOTIFY === "1") return true;
  const runDir = runDirOf(run.id);
  let to = null;
  const channelName = rigNotifyChannelName(run.rig, RIGS);
  if (channelName) {
    const id = slackChannelId(channelName);
    if (id) to = `channel:${id}`;
    else log(runDir, `notify: per-rig channel #${channelName} did not resolve; falling back to global notify target`);
  }
  let args;
  try {
    args = notifyArgs(
      to || resolvePlaceholders(target.to),
      message,
      mediaPath && fs.existsSync(mediaPath) ? mediaPath : null
    );
  } catch (err) {
    log(runDir, `notify FAILED: ${err.message}`);
    return false;
  }
  const res = spawnSync("openclaw", args, {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 120000,
  });
  if (res.status !== 0) {
    log(runDir, `notify FAILED: ${(res.stderr || res.stdout || "").slice(0, 500)}`);
    return false;
  }
  log(runDir, `notified Slack: ${message.split("\n")[0]}`);
  return true;
}

// ---------- agentic steps (Claude Code) ----------

/** Compose an agent step's final prompt (pure, exercised by selftest).
 *  Order: agent profile first, rendered task template second, joined by
 *  "\n\n---\n\n" — the profile is a role/voice/standards preamble included
 *  VERBATIM (frontmatter and all, no placeholder substitution), and the
 *  template's task + output contract come last so task-specific instructions
 *  win on any conflict. Without a profile the template passes through
 *  unchanged. */
function composeStepPrompt(profileText, renderedTemplate) {
  if (!profileText) return renderedTemplate;
  return `${profileText}\n\n---\n\n${renderedTemplate}`;
}

function renderPrompt(step, run, extra) {
  const runDir = runDirOf(run.id);
  let tpl = fs.readFileSync(path.join(ORCH_DIR, "prompts", `${step.prompt}.md`), "utf8");
  const steeringPath = path.join(runDir, "steering.md");
  const steering = fs.existsSync(steeringPath)
    ? `Founder steering (mid-run instructions, honor these):\n\n${fs.readFileSync(steeringPath, "utf8")}`
    : "";
  const findingsPath = path.join(runDir, "findings.md");
  const findings = fs.existsSync(findingsPath)
    ? `Previous validation FAILED. You must address every finding below, then re-complete your task:\n\n${fs.readFileSync(findingsPath, "utf8")}`
    : "";
  let rendered = tpl
    .replaceAll("{{PROMPT}}", run.prompt)
    .replaceAll("{{RUN_DIR}}", runDir)
    .replaceAll("{{ORCH_DIR}}", ORCH_DIR)
    .replaceAll("{{BASE_BRANCH}}", run.baseBranch)
    .replaceAll("{{STEERING}}", steering)
    .replaceAll("{{FINDINGS}}", findings);
  // Step-type-specific placeholders (discussion turns inject {{DISCUSSION}}
  // and friends); still template-only — the profile stays verbatim.
  for (const [key, value] of Object.entries(extra || {})) {
    rendered = rendered.replaceAll(key, value);
  }
  // {{…}} substitution applies to the task template only; the profile (when
  // the step names one) is prepended verbatim by composeStepPrompt.
  const profile = step.agent ? fs.readFileSync(path.join(AGENTS_DIR, `${step.agent}.md`), "utf8") : null;
  return composeStepPrompt(profile, rendered);
}

/** Filename of one attempt's prompt/output/transcript document. Attempt 1
 *  stays unsuffixed (implement.prompt.md) so pre-existing run dirs read as
 *  attempt 1; retries get implement.2.prompt.md, .3, … */
function stepDocName(stepId, kind, attempt) {
  const ext = kind === "prompt" ? "prompt.md" : kind === "transcript" ? "transcript.jsonl" : "output.json";
  return attempt <= 1 ? `${stepId}.${ext}` : `${stepId}.${attempt}.${ext}`;
}

/** Inverse of stepDocName (pure, exercised by selftest): parse a run-dir
 *  filename into {step, attempt, kind} or null when it is not a step document.
 *  Attempt-suffix aware: implement.2.output.json is step "implement" attempt 2,
 *  never step "implement.2" (the report-backfill mis-parse); unsuffixed = 1. */
function parseStepDoc(name) {
  const m = name.match(/^(.+?)\.(?:(\d+)\.)?(prompt\.md|output\.json|transcript\.jsonl)$/);
  if (!m) return null;
  const kinds = { "prompt.md": "prompt", "output.json": "output", "transcript.jsonl": "transcript" };
  return { step: m[1], attempt: m[2] ? parseInt(m[2], 10) : 1, kind: kinds[m[3]] };
}

/** Highest attempt among existing prompt/output/transcript files for a step,
 *  0 when none. Pure core (exercised by selftest); `names` =
 *  fs.readdirSync(runDir). */
function maxStepAttempt(names, stepId) {
  const re = new RegExp(`^${stepId}\\.(?:(\\d+)\\.)?(?:prompt\\.md|output\\.json|transcript\\.jsonl)$`);
  let max = 0;
  for (const name of names) {
    const m = name.match(re);
    if (m) max = Math.max(max, m[1] ? parseInt(m[1], 10) : 1);
  }
  return max;
}

function runAgentStep(run, step, extra) {
  const runDir = runDirOf(run.id);
  // Attempt derived from files on disk (not in-memory loop counters) so
  // numbering survives engine restarts and never overwrites earlier attempts.
  const attempt = maxStepAttempt(fs.readdirSync(runDir), step.id) + 1;
  const prompt = renderPrompt(step, run, extra);
  const promptFile = path.join(runDir, stepDocName(step.id, "prompt", attempt));
  fs.writeFileSync(promptFile, prompt);
  // Full working context goes to <step>[.N].transcript.jsonl: stdout streams
  // to a file descriptor (transcripts are MBs and must survive timeouts/kills),
  // never through the in-memory buffer. --verbose is required by the claude CLI
  // for stream-json in print mode.
  const transcriptFile = path.join(runDir, stepDocName(step.id, "transcript", attempt));
  const args = [
    "-p", prompt,
    "--output-format", "stream-json",
    "--verbose",
    "--dangerously-skip-permissions",
  ];
  if (step.model) args.push("--model", step.model);
  log(runDir, `agent step '${step.id}' starting (attempt ${attempt}, model=${step.model || "default"}, agent=${step.agent || "none"}, cwd=${run.worktree})`);
  const fd = fs.openSync(transcriptFile, "w");
  let res;
  try {
    res = spawnSync("claude", args, {
      cwd: run.worktree,
      encoding: "utf8",
      stdio: ["ignore", fd, "pipe"],
      timeout: (step.timeoutMinutes || 30) * 60 * 1000,
      maxBuffer: 256 * 1024 * 1024,
      env: { ...process.env, CLAUDE_CODE_ENTRYPOINT: "factory-run" },
    });
  } finally {
    fs.closeSync(fd);
  }
  // Reconstruct the prior single-object envelope from the transcript's result
  // event so parseUsage, the report backfill, and the web console keep reading
  // <step>[.N].output.json unchanged. Wrapped: telemetry parsing must never
  // fail a step.
  let extracted = { result: null, usage: null };
  try {
    extracted = resultFromTranscript(fs.readFileSync(transcriptFile, "utf8").split("\n"));
  } catch {}
  fs.writeFileSync(
    path.join(runDir, stepDocName(step.id, "output", attempt)),
    extracted.result ? JSON.stringify(extracted.result, null, 2) + "\n" : ""
  );
  if (res.error && res.error.code === "ETIMEDOUT") {
    return { ok: false, attempt, summary: `agent step '${step.id}' timed out after ${step.timeoutMinutes}m`, usage: extracted.usage };
  }
  if (res.status !== 0) {
    return { ok: false, attempt, summary: `agent step '${step.id}' exited ${res.status}: ${(res.stderr || "").slice(0, 500)}`, usage: extracted.usage };
  }
  const resultText =
    extracted.result && typeof extracted.result.result === "string"
      ? extracted.result.result
      : `(no result event in ${path.basename(transcriptFile)})`;
  return { ok: true, attempt, summary: resultText.slice(0, 2000), usage: extracted.usage };
}

/** Preserve the live findings.md as the next findings.N.md archive copy.
 *  findings.md itself must stay deletable on review PASS (renderPrompt injects
 *  it into every later agent prompt), so history lives in the archives. Called
 *  after every findings write and defensively before the PASS delete; skips
 *  when findings.md is absent or identical to the newest archive. */
function archiveFindings(runDir) {
  const live = path.join(runDir, "findings.md");
  if (!fs.existsSync(live)) return;
  const text = fs.readFileSync(live, "utf8");
  let max = 0;
  for (const name of fs.readdirSync(runDir)) {
    const m = name.match(/^findings\.(\d+)\.md$/);
    if (m) max = Math.max(max, parseInt(m[1], 10));
  }
  if (max > 0) {
    try {
      if (fs.readFileSync(path.join(runDir, `findings.${max}.md`), "utf8") === text) return;
    } catch {}
  }
  fs.writeFileSync(path.join(runDir, `findings.${max + 1}.md`), text);
}

// ---------- deterministic steps ----------

function runCommandsStep(run, step, rig) {
  const runDir = runDirOf(run.id);
  const cmds = rig[step.source] || [];
  if (cmds.length === 0) {
    log(runDir, `step '${step.id}': no ${step.source} configured for rig, skipping`);
    return { ok: true, summary: `no ${step.source} configured` };
  }
  const logFile = path.join(runDir, `${step.id}.log`);
  for (const cmd of cmds) {
    log(runDir, `step '${step.id}': ${cmd}`);
    const r = runCommand(cmd, run.worktree, logFile, 30);
    if (!r.ok) {
      const tail = r.output.split("\n").slice(-80).join("\n");
      fs.writeFileSync(
        path.join(runDir, "findings.md"),
        `Deterministic ${step.source} failed.\n\nCommand: \`${cmd}\`\n\nOutput tail:\n\n\`\`\`\n${tail}\n\`\`\`\n`
      );
      archiveFindings(runDir);
      return { ok: false, summary: `${step.source} failed at: ${cmd}` };
    }
  }
  return { ok: true, summary: `${cmds.length} ${step.source} command(s) green` };
}

function evaluateReview(run) {
  const runDir = runDirOf(run.id);
  const review = readJson(path.join(runDir, "review.json"), null);
  if (!review || !review.verdict) {
    return { ok: false, summary: "reviewer did not produce a valid review.json" };
  }
  try {
    tArtifact(run.id, "review", "review_verdict", review.verdict);
    for (const f of review.findings || []) tArtifact(run.id, "review", "finding", f);
  } catch {}
  if (review.verdict === "PASS") {
    archiveFindings(runDir);
    fs.rmSync(path.join(runDir, "findings.md"), { force: true });
    return { ok: true, summary: "agentic review PASS" };
  }
  const findings = (review.findings || []).map((f, i) => `${i + 1}. ${f}`).join("\n");
  fs.writeFileSync(
    path.join(runDir, "findings.md"),
    `Agentic cross-validation FAILED.\n\nFindings:\n\n${findings}\n`
  );
  archiveFindings(runDir);
  return { ok: false, summary: `agentic review FAIL (${(review.findings || []).length} findings)` };
}

/** Validate the run's plan.md against the strict plan profile (plan-md.mjs).
 *  The web console renders plans from this contract, so a violating plan must
 *  never survive the step that wrote it: on failure the line-numbered problems
 *  land in findings.md (archived like review findings) and the attempt fails,
 *  so the existing findings/retry loop re-prompts the writing agent with
 *  {{FINDINGS}} injected. On success stale lint findings are cleared exactly
 *  like a review PASS. */
function evaluatePlanMd(run, label) {
  const runDir = runDirOf(run.id);
  const planPath = path.join(runDir, "plan.md");
  const problems = fs.existsSync(planPath)
    ? lintPlan(fs.readFileSync(planPath, "utf8"))
    : [{ line: 1, message: "plan.md was not written" }];
  if (problems.length === 0) {
    archiveFindings(runDir);
    fs.rmSync(path.join(runDir, "findings.md"), { force: true });
    return { ok: true, summary: `plan.md conforms to the plan profile (${label})` };
  }
  const list = problems.map((p, i) => `${i + 1}. plan.md line ${p.line}: ${p.message}`).join("\n");
  fs.writeFileSync(
    path.join(runDir, "findings.md"),
    `Plan markdown validation FAILED (${label}).\n\n` +
      `\`${planPath}\` must follow the strict plan profile from your prompt. Fix every finding, ` +
      `self-check with \`node ${path.join(ORCH_DIR, "bin", "plan-lint")} ${planPath}\`, and re-complete your task.\n\n` +
      `Findings:\n\n${list}\n`
  );
  archiveFindings(runDir);
  return { ok: false, summary: `plan lint FAIL ${label}: ${problems.length} problem(s)` };
}

/** Record the run branch's commits as telemetry artifacts (idempotent-ish: replaces prior rows). */
function recordCommits(run) {
  try {
    const out = sh(`git -C ${JSON.stringify(run.worktree)} log --format='%H %s' ${run.baseBranch}..HEAD`);
    tdb().prepare(`DELETE FROM artifacts WHERE run_id = ? AND type = 'commit'`).run(run.id);
    for (const line of out.trim().split("\n").filter(Boolean)) tArtifact(run.id, "implement", "commit", line);
  } catch {}
}

// ---------- gate ----------

function waitForGate(run, step) {
  const runDir = runDirOf(run.id);
  if (run.auto) {
    log(runDir, "plan gate skipped (--auto)");
    return { ok: true, summary: "auto-approved" };
  }
  setState(run, "awaiting-approval", "plan gate");
  const planPath = path.join(runDir, step.planFile || "plan.md");
  const plan = fs.existsSync(planPath) ? fs.readFileSync(planPath, "utf8") : "(no plan file)";
  const sent = notify(
    run,
    `:clipboard: Run ${run.id} (${run.workflow} on ${run.rig}) has a plan awaiting approval.\n\n` +
      plan.slice(0, 2800) +
      `\n\nApprove: \`factory-run approve ${run.id}\` / reject with feedback: \`factory-run reject ${run.id} "..."\` (or just tell the chief of staff).`
  );
  if (!sent) {
    // Founder never saw the plan; waiting 12h on an invisible gate is the
    // smoke-run failure mode. Fail loud instead.
    return {
      ok: false,
      summary: "plan gate notification failed to send (see notify FAILED in engine.log); fix the notify channel and resume",
      terminal: true,
    };
  }
  const decisionPath = path.join(runDir, "gate-decision.json");
  const timeoutMs = 12 * 60 * 60 * 1000;
  const started = Date.now();
  while (Date.now() - started < timeoutMs) {
    if (fs.existsSync(decisionPath)) {
      const d = readJson(decisionPath, {});
      if (d.decision === "approve") return { ok: true, summary: "founder approved" };
      return { ok: false, summary: `founder rejected: ${d.feedback || ""}`, terminal: true };
    }
    const cancelled = loadRun(run.id).state === "cancelled";
    if (cancelled) return { ok: false, summary: "cancelled", terminal: true };
    execSync("sleep 15");
  }
  return { ok: false, summary: "plan gate timed out after 12h", terminal: true };
}

// ---------- discussion (conversational founder gate) ----------
//
// A real multi-turn Slack exchange: each agent turn is one runAgentStep
// invocation (attempt-numbered on disk like any retry, so telemetry, `context`
// and the web console pick turns up unchanged); founder turns arrive via
// `factory-run reply` as JSON lines in discussion-replies.jsonl; resolution
// reuses the gate's decision file verbatim (`approve` = go-ahead, `reject` =
// don't-build → run state "killed", a success). Bounds are loud: turn cap and
// idle timeout fail the run explicitly, never auto-approve.

/** Turns already on disk for a discussion step, oldest first: each attempt's
 *  output-envelope text plus its completion time (file mtime). Derived from
 *  disk, not memory, so the conversation survives engine restarts/resumes. */
function readDiscussionTurns(runDir, stepId) {
  const turns = [];
  for (const name of fs.readdirSync(runDir)) {
    const doc = parseStepDoc(name);
    if (!doc || doc.step !== stepId || doc.kind !== "output") continue;
    const p = path.join(runDir, name);
    const envelope = readJson(p, null);
    turns.push({
      attempt: doc.attempt,
      at: new Date(fs.statSync(p).mtimeMs).toISOString(),
      text: envelope && typeof envelope.result === "string" ? envelope.result : "",
    });
  }
  return turns.sort((a, b) => a.attempt - b.attempt);
}

function runDiscussionStep(run, step) {
  const id = run.id;
  const runDir = runDirOf(id);
  // `--auto` ("just do it") skips the founder conversation exactly as it
  // skipped the gate it replaces — spawned child runs carry an already
  // approved plan, so blocking them on a discussion would deadlock the chain.
  // Opt-in per step (skipWhen: "auto"): new-app's spec discussion is the
  // don't-build kill switch and must never be skippable.
  if (run.auto && step.skipWhen === "auto") {
    log(runDir, `discussion ${step.id} skipped (--auto)`);
    return { ok: true, summary: "auto-approved (discussion skipped)" };
  }
  const maxTurns = step.maxTurns ?? DISCUSSION_DEFAULTS.maxTurns;
  const idleTimeoutMinutes = step.idleTimeoutMinutes ?? DISCUSSION_DEFAULTS.idleTimeoutMinutes;
  const decisionPath = path.join(runDir, "gate-decision.json");
  const repliesPath = path.join(runDir, "discussion-replies.jsonl");
  const readReplies = () =>
    fs.existsSync(repliesPath) ? parseReplyLines(fs.readFileSync(repliesPath, "utf8").split("\n")) : [];

  let turns = readDiscussionTurns(runDir, step.id);
  // Replies already answered by an on-disk turn (resume case): everything at
  // or before the last turn's completion. The live loop then counts by index
  // so a reply landing mid-turn still triggers the next one.
  const initReplies = readReplies();
  let consumed = initReplies.length - countPendingReplies(turns, initReplies);

  // One agent turn: conversation context rebuilt from disk + replies and
  // injected via {{DISCUSSION}} (fresh claude -p per turn, no session resume);
  // the turn's final text IS the Slack message. The founder must see every
  // turn — an unsent turn is the invisible-gate failure mode, so fail loud.
  // Turn telemetry is recorded here (telemetryDone), one ok row per attempt.
  const runTurn = () => {
    for (let lintRetried = false; ; lintRetried = true) {
      const replies = readReplies();
      const started = nowIso();
      setState(run, `running:${step.id}`, `discussion turn ${turns.length + 1}/${maxTurns}`);
      const r = runAgentStep(run, step, {
        "{{DISCUSSION}}": assembleConversation(turns, replies),
        "{{TURN}}": String(turns.length + 1),
        "{{MAX_TURNS}}": String(maxTurns),
      });
      consumed = replies.length;
      try {
        tStep(id, step.id, r.attempt, r.ok ? "ok" : "fail", r.summary, started, r.usage);
      } catch {}
      if (!r.ok) return r;
      turns = readDiscussionTurns(runDir, step.id);
      // Plan discussions rewrite plan.md each turn; a turn that leaves it
      // violating the plan profile must not reach the founder (the web console
      // renders from that contract). Findings re-prompt exactly one retry turn
      // (attempt-numbered like any turn), then the step fails loudly.
      if (step.prompt === "plan-discussion") {
        const v = evaluatePlanMd(run, `after discussion turn ${turns.length}`);
        if (!v.ok) {
          log(runDir, `${v.summary} — ${lintRetried ? "failing the step" : "re-prompting one retry turn with findings"}`);
          if (!lintRetried) continue;
          return { ok: false, summary: v.summary };
        }
      }
      return postTurn(r.summary);
    }
  };

  /** Post a validated turn to the founder and park the run on the reply. */
  const postTurn = (turnText) => {
    const opening = turns.length === 1 ? ` (${run.workflow} on ${run.rig})` : "";
    const sent = notify(
      run,
      `:speech_balloon: Run ${id}${opening} — *${step.id}* turn ${turns.length}/${maxTurns}:\n\n` +
        (turnText || "").slice(0, 2800) +
        `\n\nReply: \`factory-run reply ${id} "<text>"\` · go-ahead: \`factory-run approve ${id}\` · ` +
        `don't build: \`factory-run reject ${id} "<why>"\` (or just tell the chief of staff).`
    );
    if (!sent) {
      return {
        ok: false,
        summary: `discussion turn ${turns.length} notification failed to send (see notify FAILED in engine.log); fix the notify channel and resume`,
      };
    }
    setState(run, "awaiting-approval", `discussion ${step.id}: turn ${turns.length}/${maxTurns} posted`);
    return { ok: true };
  };

  if (turns.length === 0) {
    const t = runTurn();
    if (!t.ok) return { ...t, telemetryDone: true };
  } else {
    setState(run, "awaiting-approval", `discussion ${step.id}: resumed at turn ${turns.length}/${maxTurns}`);
  }

  const finish = (outcome, extra) => {
    writeJson(path.join(runDir, "discussion-outcome.json"), { outcome, turns: turns.length, at: nowIso(), ...extra });
    // A consumed decision must not leak into a later gate/discussion (or a
    // rewound re-discussion) of this run.
    fs.rmSync(decisionPath, { force: true });
  };

  while (true) {
    if (loadRun(id).state === "cancelled") {
      return { ok: false, summary: "cancelled", terminal: true, telemetryDone: true };
    }
    const decision = fs.existsSync(decisionPath) ? readJson(decisionPath, {}) : null;
    const replies = readReplies();
    const res = resolveOutcome({
      decision,
      pendingReplies: Math.max(0, replies.length - consumed),
      turnsUsed: turns.length,
      maxTurns,
      lastActivityAt: discussionLastActivity(turns, replies),
      now: nowIso(),
      idleTimeoutMinutes,
    });
    if (res && res.outcome === "go-ahead") {
      finish("go-ahead", {});
      return { ok: true, summary: `founder go-ahead after ${turns.length} turn(s)`, telemetryDone: true };
    }
    if (res && res.outcome === "dont-build") {
      finish("dont-build", { feedback: res.feedback || null });
      return {
        ok: true,
        halt: "killed",
        summary: `founder called don't-build after ${turns.length} turn(s)${res.feedback ? ` — ${res.feedback}` : ""}`,
        telemetryDone: true,
      };
    }
    if (res) {
      // turn-cap / idle-timeout: loud failure, never a go-ahead.
      finish(res.outcome, {});
      const summary =
        res.outcome === "turn-cap"
          ? `discussion turn cap hit (${maxTurns} turns) without a founder decision — failing loudly, never auto-approving`
          : `discussion idle timeout hit (${idleTimeoutMinutes} minutes with no founder activity) — failing loudly, never auto-approving`;
      try {
        tStep(id, step.id, Math.max(turns.length, 1), "fail", summary, nowIso());
      } catch {}
      return { ok: false, summary, telemetryDone: true };
    }
    if (replies.length > consumed) {
      const t = runTurn();
      if (!t.ok) return { ...t, telemetryDone: true };
      continue;
    }
    execSync("sleep 15");
  }
}

// ---------- deploy ----------

/**
 * The exact `eas <...>` publish argv. Single source of truth: consumed by the
 * real deployStep() publish AND the preflight flag-coverage probe, so the
 * probe can never drift from the real invocation.
 */
function easPublishArgs(deploy, msg) {
  const environment = deploy.environment || deploy.branch;
  return [
    "update",
    "--branch", deploy.branch,
    "--environment", environment,
    "--message", msg,
    "--non-interactive",
    "--json",
  ];
}

/** Pure decision core for the harness-merge web-console restart (exercised by
 * selftest). Given the merge commit's first-parent file list, says whether the
 * factory web server must be restarted and whether its frontend build is stale
 * (frontend/dist/ is gitignored, so merged frontend sources need a rebuild). */
function classifyWebRestart(files) {
  const owned = files.filter(
    (f) => f.startsWith("orchestration/web/") || f.startsWith("orchestration/bin/factory-web")
  );
  return {
    restart: owned.length > 0,
    rebuildFrontend: owned.some((f) => f.startsWith("orchestration/web/frontend/")),
  };
}

// Deploy-time base-drift recovery (harness-merge only): concurrent runs land
// on the base branch mid-run, so a stale-base merge is never attempted. On
// drift the run branch is rebased onto the base inside the worktree and the
// executor loops the verification gates back over the new base, bounded by
// RECOVERY_CAP. The counter lives in run.json (run.recovery) so engine
// restarts and resumes cannot reset it.
const RECOVERY_CAP = 5;

// Engine-synthetic agent step: spawned by the executor only when a recovery
// rebase conflicts — never declared in workflow JSON.
const RESOLVE_STEP = { id: "resolve-conflicts", type: "agent", prompt: "conflict-resolver", timeoutMinutes: 30 };

/** Pure decision core for deploy-time base-drift recovery (exercised by
 *  selftest). `iterations` = recovery cycles already burned. Called before the
 *  rebase with conflicted=false (merge / escalate / permission-to-rebase) and
 *  again after it with the real conflict outcome. */
function classifyRecovery({ drifted, conflicted, iterations, cap = RECOVERY_CAP }) {
  if (!drifted) return { action: "merge", reason: "base branch unchanged since branch point" };
  if (iterations >= cap) return { action: "escalate", reason: `recovery cap reached (${iterations}/${cap} cycles)` };
  if (conflicted) return { action: "resolve", reason: "rebase conflicted; agent resolution required" };
  return { action: "reverify", reason: "clean rebase; deterministic gates must re-run against the new base" };
}

/** Write conflict.md into the run dir: the conflicting files/hunks plus the
 *  base-side commits that caused the drift — the dynamic context the static
 *  conflict-resolver prompt template references (same pattern as findings.md). */
function writeConflictContext(run, fromSha, toSha, logFile) {
  const files = runCommand("git diff --name-only --diff-filter=U", run.worktree, logFile, 2).output.trim();
  const commits = runCommand(`git log --format='%h %s' ${fromSha}..${toSha}`, run.worktree, logFile, 2).output.trim();
  const hunksRaw = runCommand("git diff", run.worktree, logFile, 2).output;
  const hunks = hunksRaw.length > 30000 ? `${hunksRaw.slice(0, 30000)}\n… (truncated)` : hunksRaw;
  fs.writeFileSync(
    path.join(runDirOf(run.id), "conflict.md"),
    [
      "# Rebase conflict: base branch advanced during this run",
      "",
      `Run branch \`factory/${run.id}\` is being rebased onto \`${run.baseBranch}\` (\`${toSha.slice(0, 12)}\`); the rebase stopped on conflicts.`,
      "",
      "## Conflicting files",
      "",
      files ? `\`\`\`\n${files}\n\`\`\`` : "(none reported)",
      "",
      `## Base-side commits since the branch point (\`${fromSha.slice(0, 12)}..${toSha.slice(0, 12)}\`)`,
      "",
      commits ? `\`\`\`\n${commits}\n\`\`\`` : "(none)",
      "",
      "## Conflict hunks (`git diff` at the first stop, truncated)",
      "",
      "```diff",
      hunks.trimEnd(),
      "```",
      "",
    ].join("\n")
  );
}

/** True while a rebase is mid-flight in the worktree (either backend). */
function rebaseInProgress(worktree) {
  return ["rebase-merge", "rebase-apply"].some((d) => {
    const p = git(worktree, ["rev-parse", "--git-path", d]);
    return p.status === 0 && fs.existsSync(path.resolve(worktree, p.stdout.trim()));
  });
}

function deployStep(run, rig) {
  const runDir = runDirOf(run.id);
  const deploy = rig.deploy || { type: "none" };
  if (deploy.type === "none") {
    return { ok: true, summary: "no deploy configured for this rig (quickfire/spec-only)", url: null };
  }
  if (deploy.type === "harness-merge") {
    // Self-improvement deploy: merge the validated run branch into the rig's
    // default branch and restart the gateway so skills/engine reload.
    const logFile = path.join(runDir, "deploy.log");
    let baseSha, mergeBase;
    try {
      baseSha = sh(`git -C ${JSON.stringify(run.worktree)} rev-parse ${run.baseBranch}`).trim();
      mergeBase = sh(`git -C ${JSON.stringify(run.worktree)} merge-base ${run.baseBranch} HEAD`).trim();
    } catch (err) {
      return { ok: false, summary: `base drift check failed: ${String(err.message || err).slice(0, 300)}` };
    }
    const iterations = run.recovery ? run.recovery.iterations : 0;
    const pre = classifyRecovery({ drifted: baseSha !== mergeBase, conflicted: false, iterations });
    if (pre.action === "escalate") {
      return { ok: false, recover: "escalate", summary: pre.reason };
    }
    if (pre.action !== "merge") {
      log(runDir, `deploy: base ${run.baseBranch} advanced ${mergeBase.slice(0, 8)} -> ${baseSha.slice(0, 8)}; rebasing factory/${run.id} in the worktree`);
      const rb = runCommand(`git rebase ${JSON.stringify(run.baseBranch)}`, run.worktree, logFile, 10);
      let conflicted = false;
      if (!rb.ok) {
        const unmerged = runCommand("git diff --name-only --diff-filter=U", run.worktree, logFile, 2);
        conflicted = unmerged.ok && unmerged.output.trim() !== "";
        if (!conflicted) {
          runCommand("git rebase --abort", run.worktree, logFile, 2);
          return { ok: false, summary: `rebase onto ${run.baseBranch} failed without conflicts (aborted, see deploy.log): ${rb.output.split("\n").slice(-3).join(" | ").slice(0, 300)}` };
        }
        writeConflictContext(run, mergeBase, baseSha, logFile);
      }
      const decision = classifyRecovery({ drifted: true, conflicted, iterations });
      if (!run.recovery) run.recovery = { iterations: 0, attempts: [] };
      run.recovery.iterations += 1;
      run.recovery.attempts.push({ at: nowIso(), fromSha: mergeBase, toSha: baseSha, conflicted, outcome: decision.action });
      // Founder steering: a clean rebase re-runs only the deterministic gates,
      // so the executor skips the review agent while `pending` is "reverify".
      run.recovery.pending = decision.action;
      saveRun(run);
      return {
        ok: false,
        recover: decision.action,
        summary: conflicted
          ? `rebase onto ${run.baseBranch} (${baseSha.slice(0, 8)}) conflicted`
          : `clean rebase onto ${run.baseBranch} (${baseSha.slice(0, 8)})`,
      };
    }
    if (run.recovery && run.recovery.pending) {
      delete run.recovery.pending;
      saveRun(run);
    }
    // The prompt's first line is free-form founder/plan text and can contain
    // backticks, quotes or $ — single-quote it so the shell treats it as data.
    const mergeSubject = `self-improvement: ${run.prompt.split("\n")[0].slice(0, 72)} (run ${run.id})`;
    const r = runCommand(
      `git merge --no-ff factory/${run.id} -m '${mergeSubject.replace(/'/g, `'\\''`)}'`,
      rig.path,
      logFile,
      5
    );
    if (!r.ok) {
      runCommand("git merge --abort", rig.path, logFile, 2);
      return { ok: false, summary: `harness merge failed (aborted cleanly): ${r.output.split("\n").slice(-3).join(" | ").slice(0, 300)}` };
    }
    const sha = sh(`git -C ${JSON.stringify(rig.path)} rev-parse --short HEAD`).trim();
    runCommand("openclaw gateway restart < /dev/null", rig.path, logFile, 5);
    try {
      tArtifact(run.id, "deploy", "harness_merge_commit", sha);
    } catch {}
    // The gateway restart reloads gateway-owned code only; the web console is a
    // separate long-lived process, so a merge touching it needs its own restart.
    const diff = runCommand("git diff --name-only HEAD^1 HEAD", rig.path, logFile, 2);
    const web = classifyWebRestart(diff.ok ? diff.output.split("\n") : []);
    if (!web.restart) {
      return { ok: true, summary: `merged to ${rig.defaultBranch} (${sha}) and restarted gateway`, url: null };
    }
    if (web.rebuildFrontend) runCommand("rm -rf orchestration/web/frontend/dist", rig.path, logFile, 2);
    const down = runCommand("orchestration/bin/factory-web-down", rig.path, logFile, 5);
    const up = runCommand("orchestration/bin/factory-web-up", rig.path, logFile, 10);
    if (down.ok && up.ok && up.output.includes(": up at ")) {
      return { ok: true, summary: `merged to ${rig.defaultBranch} (${sha}) and restarted gateway + web console`, url: null };
    }
    // The merge is durable and already on the default branch, so the deploy
    // stays ok — but the summary must not read as a clean deploy.
    return {
      ok: true,
      summary: `merged to ${rig.defaultBranch} (${sha}), restarted gateway; web console restart FAILED — restart manually with factory-web-up, see deploy.log`,
      url: null,
    };
  }
  if (deploy.type !== "eas-update") {
    return { ok: false, summary: `unknown deploy type: ${deploy.type}` };
  }
  const appDir = path.join(run.worktree, rig.appDir || ".");
  const logFile = path.join(runDir, "deploy.log");
  const msg = `factory-run ${run.id}: ${run.prompt.slice(0, 80)}`;
  log(runDir, `deploying: eas update --branch ${deploy.branch} (${appDir})`);
  const r = runCommand(
    `npx eas ${easPublishArgs(deploy, msg).map((a) => JSON.stringify(a)).join(" ")}`,
    appDir,
    logFile,
    30
  );
  if (!r.ok) {
    return { ok: false, summary: `eas update failed (see deploy.log): ${r.output.split("\n").slice(-5).join(" | ").slice(0, 400)}` };
  }
  // The publish output is noisy; query the branch for the newest update group instead.
  let url = null;
  const list = runCommand(
    `npx eas update:list --branch ${JSON.stringify(deploy.branch)} --limit 1 --json --non-interactive`,
    appDir,
    logFile,
    5
  );
  try {
    const jsonStart = list.output.indexOf("{");
    const parsed = JSON.parse(list.output.slice(jsonStart));
    const group = parsed.currentPage && parsed.currentPage[0] && parsed.currentPage[0].group;
    if (group && rig.easSlug && RIGS.easAccount) {
      url = `https://expo.dev/accounts/${RIGS.easAccount}/projects/${rig.easSlug}/updates/${group}`;
    }
  } catch {
    const m = r.output.match(/https:\/\/expo\.dev\S+/);
    if (m) url = m[0];
  }
  let qrPath = null;
  if (url) {
    qrPath = path.join(runDir, "qr.png");
    const q = runCommand(`npx --yes qrcode ${JSON.stringify(url)} -o ${JSON.stringify(qrPath)}`, runDir, logFile, 5);
    if (!q.ok) qrPath = null;
  }
  return { ok: true, summary: url ? `EAS update published: ${url}` : "EAS update published (no URL parsed, see deploy.log)", url, qrPath };
}

// ---------- preflight (live external-CLI contract checks) ----------
//
// Both smoke-run failures were hand-written CLI argument lists first validated
// in production. These probes exercise the exact contracts (arg lists come from
// the same helpers the engine sends with) at run start, before any token is
// spent. All probes are read-only: nothing is sent, nothing is published.
// Skip the run-start invocation with FACTORY_RUN_NO_PREFLIGHT=1.

function preflightSpawn(cmd, args, cwd, timeoutMs) {
  const res = spawnSync(cmd, args, {
    cwd,
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: timeoutMs,
    maxBuffer: 8 * 1024 * 1024,
  });
  if (res.error && res.error.code === "ETIMEDOUT") return { status: -1, stdout: "", output: `timed out after ${timeoutMs / 1000}s` };
  if (res.error) return { status: -1, stdout: "", output: String(res.error.message) };
  return { status: res.status, stdout: res.stdout || "", output: (res.stdout || "") + (res.stderr || "") };
}

function longFlagsOf(argv) {
  return argv.filter((a) => /^--[a-z][\w-]*$/i.test(a));
}

/** Option-alias groups (e.g. ["-m", "--message"]) whose --help definition line
 *  marks them required. Aliases come only from the option-definition column at
 *  the start of the line — never from flags mentioned in description prose
 *  (the "-m, --message" line says "required unless --media is set"; --media
 *  belongs to a different option and must not join this group). */
function requiredOptionGroups(helpText) {
  const groups = [];
  for (const line of helpText.split("\n")) {
    if (!/required/i.test(line)) continue;
    const def = line.match(/^\s+(-{1,2}[a-z][\w-]*(?:,\s+-{1,2}[a-z][\w-]*)*)/i);
    if (def) groups.push(def[1].split(/,\s+/));
  }
  return groups;
}

/** Option-alias groups the CLI actually enforces as required, derived by
 *  running it — not by trusting --help prose (openclaw's "-t, --target" line
 *  carries no "required" marker at all). Invokes the command under --dry-run
 *  (payload printed, nothing sent), satisfies each "Missing required option"
 *  error with a dummy value, and repeats until the CLI stops raising that
 *  error class. Returns {groups} or {error} when probing can't run safely. */
function enforcedRequiredGroups(cmd, baseArgs, helpText) {
  if (!helpText.includes("--dry-run")) {
    return { error: "--dry-run absent from --help; cannot probe required options without sending" };
  }
  const groups = [];
  const argv = [...baseArgs, "--dry-run"];
  for (let i = 0; i < 6; i++) {
    const res = preflightSpawn(cmd, argv, undefined, 30000);
    const m = res.output.match(/Missing required option "([^"]+)"/);
    if (!m) break;
    const flags = m[1].match(/-{1,2}[a-z][\w-]*/gi) || [];
    if (!flags.length || groups.some((g) => g[0] === flags[0])) break;
    groups.push(flags);
    argv.push(flags[flags.length - 1], "preflight-probe");
  }
  return { groups };
}

/** Heuristic two-way contract check: every long --flag the engine passes must
 *  appear in the help output, and every required option group given must be
 *  covered (by any of its aliases) in the engine's argv. */
function helpContractProblems(helpText, argv, requiredGroups) {
  const problems = [];
  for (const flag of longFlagsOf(argv)) {
    if (!helpText.includes(flag)) problems.push(`engine passes ${flag}, absent from --help`);
  }
  for (const group of requiredGroups) {
    if (!group.some((f) => argv.includes(f))) {
      problems.push(`${group.join("/")} is required, engine passes none of them`);
    }
  }
  return problems;
}

function probeNotifyContract() {
  const name = "notify:openclaw-send-contract";
  const help = preflightSpawn("openclaw", ["message", "send", "--help"], undefined, 30000);
  if (help.status !== 0) {
    return { name, ok: false, detail: `openclaw message send --help exited ${help.status}: ${help.output.slice(0, 200)}` };
  }
  // Required-ness comes from two sources: what the CLI enforces when actually
  // invoked (catches --target, which --help never marks required), plus any
  // options whose help line carries a "required" marker (catches -m/--message).
  const enforced = enforcedRequiredGroups("openclaw", ["message", "send"], help.output);
  if (enforced.error) return { name, ok: false, detail: enforced.error };
  if (enforced.groups.length === 0) {
    return { name, ok: false, detail: 'dry-run probe confirmed no required options ("Missing required option" format changed?)' };
  }
  const requiredGroups = [...enforced.groups];
  for (const group of requiredOptionGroups(help.output)) {
    if (!requiredGroups.some((g) => g[0] === group[0])) requiredGroups.push(group);
  }
  // Dummy media path so the --media flag is part of the checked contract.
  const argv = notifyArgs("preflight", "preflight probe", "preflight-probe.png");
  const problems = helpContractProblems(help.output, argv, requiredGroups);
  if (problems.length) return { name, ok: false, detail: problems.join("; ") };
  return {
    name,
    ok: true,
    detail: `${longFlagsOf(argv).length} long flags verified against --help; ${requiredGroups.length} required option groups covered (${enforced.groups.length} enforced live)`,
  };
}

function probeClaude() {
  const name = "claude:version";
  const res = preflightSpawn("claude", ["--version"], undefined, 30000);
  if (res.status !== 0) return { name, ok: false, detail: `claude --version exited ${res.status}: ${res.output.slice(0, 200)}` };
  return { name, ok: true, detail: res.output.trim().split("\n")[0] };
}

/** EAS probes for one rig, run in the rig's live app directory (preflight runs
 *  before any worktree exists). Rigs without eas-update deploy get none. */
function easProbes(rig) {
  const deploy = rig.deploy || { type: "none" };
  if (deploy.type !== "eas-update") return [];
  const appDir = path.join(rig.path, rig.appDir || ".");
  const probes = [];

  const whoami = preflightSpawn("npx", ["eas", "whoami", "--non-interactive"], appDir, 60000);
  probes.push({
    name: `${rig.name}:eas-whoami`,
    ok: whoami.status === 0,
    detail: whoami.status === 0
      ? `logged in as ${whoami.stdout.trim().split("\n").pop()}`
      : `exited ${whoami.status}: ${whoami.output.slice(0, 200)}`,
  });

  const flagsName = `${rig.name}:eas-update-flags`;
  const help = preflightSpawn("npx", ["eas", "update", "--help"], appDir, 60000);
  if (help.status !== 0) {
    probes.push({ name: flagsName, ok: false, detail: `eas update --help exited ${help.status}: ${help.output.slice(0, 200)}` });
  } else {
    const publishFlags = longFlagsOf(easPublishArgs(deploy, "preflight probe"));
    const missing = publishFlags.filter((f) => !help.output.includes(f));
    probes.push({
      name: flagsName,
      ok: missing.length === 0,
      detail: missing.length
        ? `publish flags missing from eas update --help: ${missing.join(", ")}`
        : `${publishFlags.length} publish flags present in --help`,
    });
  }

  const listName = `${rig.name}:eas-update-list`;
  const list = preflightSpawn(
    "npx",
    ["eas", "update:list", "--branch", deploy.branch, "--limit", "1", "--non-interactive", "--json"],
    appDir,
    60000
  );
  if (list.status !== 0) {
    probes.push({ name: listName, ok: false, detail: `exited ${list.status}: ${list.output.slice(0, 200)}` });
  } else {
    // eas-cli prints upgrade banners around the JSON; parse the outermost object.
    try {
      const text = list.stdout;
      JSON.parse(text.slice(text.indexOf("{"), text.lastIndexOf("}") + 1));
      probes.push({ name: listName, ok: true, detail: `branch ${deploy.branch} listable, JSON parseable` });
    } catch {
      probes.push({ name: listName, ok: false, detail: `branch ${deploy.branch} output not JSON-parseable` });
    }
  }
  return probes;
}

/** Run all probes for the given rigs. Returns {ok, probes: [{name, ok, detail}], summary}. */
function runPreflight(rigNames) {
  const probes = [probeNotifyContract(), probeClaude()];
  for (const name of rigNames) {
    probes.push(...easProbes(resolveRig(name)));
  }
  const failed = probes.filter((p) => !p.ok);
  const summary = failed.length
    ? failed.map((p) => `${p.name}: ${p.detail}`).join("; ").slice(0, 500)
    : `${probes.length} probes green`;
  return { ok: failed.length === 0, probes, summary };
}

// ---------- cleanup (worktree/branch reclamation) ----------
//
// Every run creates orchestration/worktrees/<id> plus a factory/<id> branch in
// its rig repo, and each worktree carries full rig setup (~GBs). Cleanup
// reclaims both once a run is terminal and its branch is merged into the rig's
// default branch. It never forces: in-flight runs, dirty worktrees, and
// unmerged branches are skipped with a reason, and each run is checked against
// its own rig repo (skip-hero runs against skip-hero main, not app-factory's).

function git(repoPath, args) {
  return spawnSync("git", ["-C", repoPath, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
}

function dirSizeBytes(p) {
  try {
    return (parseInt(sh(`du -sk ${JSON.stringify(p)}`), 10) || 0) * 1024;
  } catch {
    return 0;
  }
}

function fmtBytes(n) {
  if (n >= 1 << 30) return `${(n / (1 << 30)).toFixed(2)} GB`;
  if (n >= 1 << 20) return `${(n / (1 << 20)).toFixed(1)} MB`;
  if (n >= 1024) return `${(n / 1024).toFixed(1)} kB`;
  return `${n} B`;
}

/** Pure decision core for cleanupRun (exercised by selftest). Returns
 *  {action, reason}: "skip" (leave everything), "none" (nothing left),
 *  "clean" (remove worktree if present, delete merged branch if present),
 *  "remove-worktree" (opt-in: reclaim a clean worktree while keeping its
 *  unmerged branch). */
function classifyCleanup({ state, worktreeExists, branchExists, dirty, merged }, opts = {}) {
  if (!TERMINAL_STATES.includes(state)) return { action: "skip", reason: `state '${state}' is not terminal` };
  if (!worktreeExists && !branchExists) return { action: "none", reason: "nothing to clean" };
  if (worktreeExists && dirty) return { action: "skip", reason: "worktree has uncommitted changes" };
  if (branchExists && !merged) {
    if (worktreeExists && opts.removeUnmergedWorktrees) {
      return { action: "remove-worktree", reason: "unmerged branch kept; clean worktree removed (--remove-unmerged-worktrees)" };
    }
    return { action: "skip", reason: "branch not merged into default branch" };
  }
  return { action: "clean", reason: branchExists ? "merged and clean" : "branch already deleted; reclaiming clean worktree" };
}

/** Reclaim one run's worktree/branch when safe. No forced deletion anywhere:
 *  `git worktree remove` without --force, `git branch -d` (which itself
 *  refuses unmerged branches). Returns {id, action, reason, freedBytes}. */
function cleanupRun(run, opts = {}) {
  const worktree = path.join(WORKTREES_DIR, run.id);
  const branch = `factory/${run.id}`;
  let rig;
  try {
    rig = resolveRig(run.rig);
  } catch (err) {
    return { id: run.id, action: "skip", reason: String(err.message || err), freedBytes: 0 };
  }
  const worktreeExists = fs.existsSync(worktree);
  const branchExists = git(rig.path, ["rev-parse", "--verify", "--quiet", `refs/heads/${branch}`]).status === 0;
  let dirty = false;
  if (worktreeExists) {
    const st = git(worktree, ["status", "--porcelain"]);
    if (st.status !== 0) {
      // Not a functioning worktree; the orphan scan verifies its gitdir
      // pointer before deleting anything, so leave it for that pass.
      return { id: run.id, action: "skip", reason: "git status failed in worktree (left for the orphan scan)", freedBytes: 0 };
    }
    dirty = st.stdout.trim() !== "";
  }
  const merged = branchExists && git(rig.path, ["merge-base", "--is-ancestor", branch, rig.defaultBranch]).status === 0;
  const decision = classifyCleanup({ state: run.state, worktreeExists, branchExists, dirty, merged }, opts);
  const result = { id: run.id, action: decision.action, reason: decision.reason, freedBytes: 0 };
  if (decision.action === "skip" || decision.action === "none") return result;
  if (opts.dryRun) {
    return { ...result, action: `would-${decision.action}`, freedBytes: worktreeExists ? dirSizeBytes(worktree) : 0 };
  }
  if (worktreeExists) {
    const bytes = dirSizeBytes(worktree);
    const rm = git(rig.path, ["worktree", "remove", worktree]);
    if (rm.status !== 0) {
      return { ...result, action: "error", reason: `git worktree remove failed: ${(rm.stderr || rm.stdout || "").trim().slice(0, 200)}` };
    }
    result.freedBytes = bytes;
  }
  git(rig.path, ["worktree", "prune"]);
  if (decision.action === "clean" && branchExists) {
    const del = git(rig.path, ["branch", "-d", branch]);
    if (del.status !== 0) {
      return { ...result, action: "error", reason: `git branch -d failed: ${(del.stderr || del.stdout || "").trim().slice(0, 200)}` };
    }
  }
  return result;
}

/** Scan WORKTREES_DIR for directories that are no longer valid git worktrees
 *  (no .git file, or a gitdir pointer targeting a deleted path) and remove
 *  them. A directory that is a valid worktree of some rig repo is never an
 *  orphan — without a run.json it is only reported, not touched. */
function scanOrphans(opts = {}) {
  if (!fs.existsSync(WORKTREES_DIR)) return [];
  const results = [];
  const runIds = new Set(listRunIds());
  for (const entry of fs.readdirSync(WORKTREES_DIR)) {
    const dir = path.join(WORKTREES_DIR, entry);
    if (!fs.lstatSync(dir).isDirectory()) continue;
    let gitdir = null;
    try {
      const m = fs.readFileSync(path.join(dir, ".git"), "utf8").match(/^gitdir:\s*(.+?)\s*$/m);
      if (m) gitdir = path.resolve(dir, m[1]);
    } catch {}
    if (gitdir && fs.existsSync(gitdir)) {
      if (!runIds.has(entry)) results.push({ id: entry, action: "report", reason: "valid worktree without a run — left in place", freedBytes: 0 });
      continue;
    }
    const bytes = dirSizeBytes(dir);
    if (!opts.dryRun) fs.rmSync(dir, { recursive: true, force: true });
    results.push({
      id: entry,
      action: opts.dryRun ? "would-remove-orphan" : "remove-orphan",
      reason: "gitdir pointer missing or dangling",
      freedBytes: bytes,
    });
  }
  return results;
}

function cmdCleanup(argv) {
  const opts = {
    dryRun: argv.includes("--dry-run"),
    removeUnmergedWorktrees: argv.includes("--remove-unmerged-worktrees"),
  };
  const asJson = argv.includes("--json");
  const results = listRunIds().map((id) => cleanupRun(loadRun(id), opts));
  results.push(...scanOrphans(opts));
  const freedBytes = results.reduce((n, r) => n + (r.freedBytes || 0), 0);
  if (asJson) {
    console.log(JSON.stringify({ dryRun: opts.dryRun, freedBytes, results }, null, 2));
    return;
  }
  for (const r of results) {
    console.log(`${r.action.padEnd(20)} ${r.id}: ${r.reason}${r.freedBytes ? ` [${fmtBytes(r.freedBytes)}]` : ""}`);
  }
  console.log(`\n${opts.dryRun ? "would free" : "freed"} ${fmtBytes(freedBytes)} (${results.length} item(s) examined)`);
}

// ---------- executor ----------

/** Deploy-step recovery orchestration: cap escalations, the synthetic
 *  resolve-conflicts agent step (with escalation.md handling), and the
 *  loop-back target. Returns { loopTo } for the executor to continue the step
 *  loop, or null when the run is terminal (state set + founder notified
 *  here). The worktree and branch are always left intact — and any in-flight
 *  rebase aborted — so `factory-run resume` can restart the run. */
function handleRecovery(run, workflow, deployDef, result) {
  const id = run.id;
  const runDir = runDirOf(id);
  const logFile = path.join(runDir, "deploy.log");
  const attempts = (run.recovery && run.recovery.attempts) || [];
  const last = attempts[attempts.length - 1];
  if (result.recover === "escalate") {
    setState(run, "failed", `deploy recovery escalation: ${result.summary}`);
    notify(
      run,
      `:rotating_light: Run ${id} needs a human: ${result.summary} — the base branch keeps advancing past this run.\n` +
        `Worktree and branch \`factory/${id}\` are intact. Restart with \`factory-run resume ${id}\` ` +
        `(or rewind: \`factory-run resume ${id} --step <step-id>\`).\nRun dir: ${runDir}`
    );
    return null;
  }
  if (result.recover === "resolve") {
    const escalationPath = path.join(runDir, "escalation.md");
    fs.rmSync(escalationPath, { force: true }); // a stale escalation must not veto this cycle
    const started = nowIso();
    setState(run, `running:${RESOLVE_STEP.id}`, null);
    notify(run, `:gear: Run ${id} (${run.rig}): ${result.summary} — step *${RESOLVE_STEP.id}* started.`);
    const r = runAgentStep(run, RESOLVE_STEP);
    const fail = (outcome, summary, notice) => {
      if (last) last.outcome = outcome;
      if (rebaseInProgress(run.worktree)) runCommand("git rebase --abort", run.worktree, logFile, 2);
      try {
        tStep(id, RESOLVE_STEP.id, r.attempt, "fail", summary, started, r.usage);
      } catch {}
      setState(run, "failed", summary);
      notify(run, notice);
      return null;
    };
    if (fs.existsSync(escalationPath)) {
      const text = fs.readFileSync(escalationPath, "utf8");
      return fail(
        "escalated",
        `resolve-conflicts escalated: ${(text.split("\n").find((l) => l.trim()) || "see escalation.md").slice(0, 300)}`,
        `:rotating_light: Run ${id} escalated by the conflict-resolution agent (rebase aborted; branch intact; ` +
          `\`factory-run resume ${id}\` once addressed):\n\n${text.slice(0, 2800)}`
      );
    }
    if (!r.ok) {
      return fail("failed", r.summary, `:x: Run ${id} FAILED at step *${RESOLVE_STEP.id}*: ${r.summary}\nRun dir: ${runDir}`);
    }
    // The agent claims success — verify the rebase really completed before
    // trusting the branch: no in-flight rebase, a clean tree, and HEAD
    // containing the rebase target captured at drift time.
    const status = git(run.worktree, ["status", "--porcelain"]);
    const onTarget = !last || git(run.worktree, ["merge-base", "--is-ancestor", last.toSha, "HEAD"]).status === 0;
    if (rebaseInProgress(run.worktree) || status.status !== 0 || status.stdout.trim() !== "" || !onTarget) {
      return fail(
        "incomplete",
        "resolve-conflicts agent finished but the rebase is not complete (rebase aborted; see deploy.log)",
        `:x: Run ${id}: conflict resolution did not complete the rebase; rebase aborted, branch intact. Resume with \`factory-run resume ${id}\`.`
      );
    }
    if (last) last.outcome = "resolved";
    saveRun(run);
    try {
      tStep(id, RESOLVE_STEP.id, r.attempt, "ok", r.summary, started, r.usage);
    } catch {}
  }
  const target = deployDef.onRecover || "checks";
  const backIdx = workflow.steps.findIndex((s) => s.id === target);
  if (backIdx === -1) {
    setState(run, "failed", `deploy onRecover target '${target}' is not a workflow step`);
    notify(run, `:x: Run ${id} FAILED: deploy onRecover target '${target}' is not a workflow step.`);
    return null;
  }
  const n = run.recovery.iterations;
  const what =
    result.recover === "resolve"
      ? "conflicts resolved by agent; full gates re-run"
      : "re-running deterministic gates (review skipped)";
  setState(run, "recovering", `cycle ${n}/${RECOVERY_CAP}: ${result.summary} — ${what}`);
  notify(run, `:arrows_counterclockwise: Run ${id}: ${result.summary}; ${what}. Looping back to *${target}* (recovery cycle ${n}/${RECOVERY_CAP}).`);
  return { loopTo: backIdx };
}

function execRun(id) {
  const run = loadRun(id);
  const runDir = runDirOf(id);
  const rig = resolveRig(run.rig);
  const workflow = loadWorkflow(run.workflow);
  const loops = {};
  // True per-step execution count for telemetry: `loops` only increments for
  // the step that failed, so a looped-back step would repeat attempt numbers.
  // Agent steps report their file-derived attempt instead (resume-safe).
  const execCounts = {};

  try {
    tRun(run);
    // Preflight before any worktree or agent step: fail fast on broken external
    // CLI contracts (resumes re-verify too — a resume after a hot-patch was
    // exactly the smoke-run scenario).
    if (process.env.FACTORY_RUN_NO_PREFLIGHT !== "1") {
      const pfStarted = nowIso();
      log(runDir, "preflight: verifying external CLI contracts");
      const pf = runPreflight([run.rig]);
      for (const p of pf.probes) log(runDir, `preflight ${p.ok ? "ok" : "FAIL"} ${p.name}: ${p.detail}`);
      try {
        tStep(id, "preflight", 1, pf.ok ? "ok" : "fail", pf.summary, pfStarted);
      } catch {}
      if (!pf.ok) {
        const summary = `preflight failed: ${pf.summary} (skip with FACTORY_RUN_NO_PREFLIGHT=1)`;
        setState(run, "failed", summary);
        notify(run, `:x: Run ${id} ${summary}\nRun dir: ${runDir}`);
        return;
      }
    }
    // Worktree setup (idempotent on resume). Read-only workflows (self-review)
    // set "worktree": false and run agent steps against the live checkout.
    if (workflow.worktree === false) {
      run.worktree = rig.path;
      saveRun(run);
    } else if (!fs.existsSync(run.worktree)) {
      setState(run, "setup", "creating worktree");
      fs.mkdirSync(WORKTREES_DIR, { recursive: true });
      sh(`git -C ${JSON.stringify(rig.path)} worktree add ${JSON.stringify(run.worktree)} -b factory/${id} ${rig.defaultBranch}`);
      log(runDir, `worktree created at ${run.worktree} (branch factory/${id})`);
      const setupLog = path.join(runDir, "setup.log");
      for (const cmd of rig.setup || []) {
        log(runDir, `setup: ${cmd}`);
        const r = runCommand(cmd, run.worktree, setupLog, 30);
        if (!r.ok) throw new Error(`setup failed: ${cmd} (see setup.log)`);
      }
    }

    let i = run.stepIndex || 0;
    while (i < workflow.steps.length) {
      const step = workflow.steps[i];
      run.stepIndex = i;
      let result;
      const stepStarted = nowIso();
      execCounts[step.id] = (execCounts[step.id] || 0) + 1;

      if (step.type === "agent" && step.id === "review" && run.recovery && run.recovery.pending === "reverify") {
        // Founder steering: a clean recovery rebase re-runs only the
        // deterministic gates — no code changed, the review verdict stands.
        result = { ok: true, summary: "review skipped: clean-rebase re-verification runs deterministic gates only" };
      } else if (step.type === "agent") {
        if (run.recovery && run.recovery.pending === "reverify") {
          // Any other agent step (e.g. a checks failure looping back to
          // implement) changes code — the review skip no longer applies.
          delete run.recovery.pending;
          saveRun(run);
        }
        setState(run, `running:${step.id}`, null);
        notify(run, `:gear: Run ${id} (${run.rig}): step *${step.id}* started.`);
        result = runAgentStep(run, step);
        if (result.ok && step.id === "review") {
          result = { ...evaluateReview(run), attempt: result.attempt, usage: result.usage };
        }
        if (result.ok && step.id === "plan") {
          // The web console renders plan.md from the strict plan profile — a
          // violating plan fails the attempt (findings.md written) so the
          // workflow's onFail loop re-runs the plan step with findings.
          result = { ...evaluatePlanMd(run, "after the plan step"), attempt: result.attempt, usage: result.usage };
        }
        if (result.ok && step.id === "implement") recordCommits(run);
      } else if (step.type === "commands") {
        setState(run, `running:${step.id}`, null);
        result = runCommandsStep(run, step, rig);
      } else if (step.type === "gate") {
        result = waitForGate(run, step);
        if (result.ok) setState(run, "approved", result.summary);
      } else if (step.type === "discussion") {
        // Conversational founder gate: manages its own states (running:<id>
        // per turn, awaiting-approval between turns) and per-turn telemetry.
        result = runDiscussionStep(run, step);
        if (result.ok && !result.halt) setState(run, "approved", result.summary);
      } else if (step.type === "deploy") {
        setState(run, "deploying", null);
        result = deployStep(run, rig);
        if (result.ok) {
          run.artifactUrl = result.url || null;
          run.qrPath = result.qrPath || null;
          saveRun(run);
        }
      } else if (step.type === "notify") {
        const planTitle = (() => {
          try {
            return fs.readFileSync(path.join(runDir, "plan.md"), "utf8").split("\n")[0].replace(/^#\s*/, "");
          } catch {
            return run.prompt.slice(0, 80);
          }
        })();
        const lines = [
          `:white_check_mark: Run ${id} complete: *${planTitle}*`,
          `Rig: ${run.rig} · branch \`factory/${id}\` · worktree kept for merge review`,
          run.artifactUrl ? `Install/preview: ${run.artifactUrl}` : "No deployable artifact for this rig.",
          `Merge when happy: \`git -C ${rig.path} merge factory/${id}\` (or ask the chief of staff).`,
        ];
        const usage = usageLine(id);
        if (usage) lines.push(usage);
        notify(run, lines.join("\n"), run.qrPath);
        result = { ok: true, summary: "founder notified" };
      } else if (step.type === "spawn") {
        // Chained run: launch a full workflow run (its own graph execution)
        // with the founder-approved prompt file from this run's dir.
        setState(run, `running:${step.id}`, null);
        const planFile = path.join(runDir, step.promptFrom || "improvement-plan.md");
        // rigFrom: the child rig is only known at run time (new-app: refine
        // writes {codename} to app.json). resolveRig requires the app on the
        // rig's default branch — deploy runs before spawn for exactly that.
        let childRig = step.rig || run.rig;
        let rigProblem = null;
        if (step.rigFrom) {
          const app = readJson(path.join(runDir, step.rigFrom), null);
          const codename = app && typeof app.codename === "string" ? app.codename.trim() : "";
          if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(codename)) {
            rigProblem = `spawn: ${step.rigFrom} missing or lacks a valid codename slug`;
          } else {
            childRig = `factory:${codename}`;
          }
        }
        if (rigProblem) {
          result = { ok: false, summary: rigProblem };
        } else if (!fs.existsSync(planFile)) {
          result = { ok: false, summary: `spawn: missing ${step.promptFrom}` };
        } else {
          const childPrompt = fs.readFileSync(planFile, "utf8");
          try {
            const childId = createRun({
              rig: childRig,
              workflow: step.workflow,
              prompt: childPrompt,
              auto: step.auto !== false, // prompt was already founder-approved at this run's gate/discussion
              parentRun: run.id,
            });
            run.childRun = childId;
            saveRun(run);
            notify(run, `:rocket: Run ${id} spawned run *${childId}* (${step.workflow} on ${childRig}) from the approved ${step.promptFrom || "improvement-plan.md"}. It will implement, validate, and deploy through the standard pipeline.`);
            result = { ok: true, summary: `spawned ${childId}` };
          } catch (err) {
            result = { ok: false, summary: `spawn failed: ${String(err.message || err).slice(0, 300)}` };
          }
        }
      } else if (step.type === "manual") {
        result = { ok: true, summary: `manual step: ${step.note || ""}` };
      } else {
        result = { ok: false, summary: `unknown step type ${step.type}` };
      }

      log(runDir, `step '${step.id}': ${result.ok ? "OK" : result.recover ? `RECOVER:${result.recover}` : "FAIL"} (${result.summary})`);
      try {
        // Recovery cycles get their own telemetry status so deploy failure
        // stats stay honest (a drift loop-back is not a broken deploy).
        // Discussion steps record per-turn rows themselves (telemetryDone).
        if (!result.telemetryDone) {
          tStep(id, step.id, result.attempt || execCounts[step.id], result.ok ? "ok" : result.recover ? "recover" : "fail", result.summary, stepStarted, result.usage);
        }
        if (run.artifactUrl && step.type === "deploy" && result.ok) tArtifact(id, "deploy", "artifact_url", run.artifactUrl);
      } catch {}

      if (result.recover) {
        const rec = handleRecovery(run, workflow, step, result);
        if (!rec) return;
        i = rec.loopTo;
        continue;
      }

      if (result.ok && result.halt === "killed") {
        // A don't-build ending is a halting SUCCESS, never the :x: failure
        // path: early kill = money saved. Terminal state "killed".
        setState(run, "killed", result.summary);
        const usage = usageLine(id);
        notify(
          run,
          `:money_with_wings: Run ${id} closed at *${step.id}*: ${result.summary}\n` +
            `Killing a weak idea early is a win — no build cost sunk. Run dir kept: ${runDir}${usage ? `\n${usage}` : ""}`
        );
        return;
      }

      if (!result.ok) {
        if (result.terminal) {
          setState(run, "rejected", result.summary);
          notify(run, `:no_entry: Run ${id} stopped: ${result.summary}`);
          return;
        }
        if (step.onFail) {
          loops[step.id] = (loops[step.id] || 0) + 1;
          if (loops[step.id] <= (step.maxLoops || 1)) {
            const backIdx = workflow.steps.findIndex((s) => s.id === step.onFail);
            log(runDir, `looping back to '${step.onFail}' (attempt ${loops[step.id]}/${step.maxLoops})`);
            notify(run, `:arrows_counterclockwise: Run ${id}: *${step.id}* failed validation, looping back to *${step.onFail}* (attempt ${loops[step.id]}/${step.maxLoops}).\n${result.summary}`);
            i = backIdx;
            continue;
          }
        }
        setState(run, "failed", result.summary);
        {
          const usage = usageLine(id);
          notify(run, `:x: Run ${id} FAILED at step *${step.id}*: ${result.summary}\nRun dir: ${runDir}${usage ? `\n${usage}` : ""}`);
        }
        return;
      }
      i += 1;
      run.stepIndex = i;
      saveRun(run);
    }
    setState(run, "done", null);
    // Reclaim the worktree/branch when already merged (harness-merge rigs
    // merge during deploy). Manual-merge rigs skip as unmerged, preserving the
    // "worktree kept for merge review" flow. A cleanup failure must never
    // change the run's terminal state.
    try {
      const c = cleanupRun(run, {});
      log(runDir, `cleanup: ${c.action} (${c.reason})`);
    } catch (err) {
      log(runDir, `cleanup error (run stays done): ${String(err.message || err)}`);
    }
  } catch (err) {
    setState(run, "failed", String(err.message || err));
    notify(run, `:x: Run ${id} crashed: ${String(err.message || err).slice(0, 500)}`);
    throw err;
  }
}

// ---------- commands ----------

function createRun({ rig: rigName, workflow: wfName, prompt, auto, parentRun }) {
  const rig = resolveRig(rigName);
  const wf = loadWorkflow(wfName);
  // Fail before the run dir or worktree exists on a broken step reference.
  const wfProblems = validateWorkflowAgentSteps(wfName, wf);
  if (wfProblems.length) throw new Error(wfProblems.join("; "));
  const slug = slugify(prompt);
  const base = `${wfName.split("-")[0]}-${slug || Date.now().toString(36)}`;
  const id = uniqueRunId(base, (candidate) => fs.existsSync(runDirOf(candidate)));
  const runDir = runDirOf(id);
  fs.mkdirSync(runDir, { recursive: true });
  const run = {
    id,
    workflow: wfName,
    rig: rigName,
    prompt,
    auto: !!auto,
    parentRun: parentRun || null,
    baseBranch: rig.defaultBranch,
    worktree: path.join(WORKTREES_DIR, id),
    state: "queued",
    stepIndex: 0,
    artifactUrl: null,
    qrPath: null,
    createdAt: nowIso(),
    updatedAt: nowIso(),
    history: [],
  };
  saveRun(run);
  try {
    tRun(run);
  } catch {}
  // Detach the executor so the caller (Slack skill / spawning run) returns immediately.
  detachExec(id);
  return id;
}

function cmdStart(argv) {
  const rigName = argOf(argv, "--rig");
  const wfName = argOf(argv, "--workflow") || "feature-dev";
  const prompt = argOf(argv, "--prompt");
  const auto = argv.includes("--auto");
  if (!rigName || !prompt) {
    console.error('usage: factory-run start --rig <name> --workflow <wf> --prompt "<text>" [--auto]');
    process.exit(1);
  }
  console.log(createRun({ rig: rigName, workflow: wfName, prompt, auto }));
}

function cmdReport(argv) {
  const days = Number(argOf(argv, "--days") || 30);
  const asJson = argv.includes("--json");
  // Backfill any runs on disk that predate telemetry (runs, engine.log step
  // outcomes, review verdicts/findings, deploy artifacts).
  if (fs.existsSync(RUNS_DIR)) {
    const db = tdb();
    for (const d of fs.readdirSync(RUNS_DIR)) {
      const r = readJson(path.join(RUNS_DIR, d, "run.json"), null);
      if (!r) continue;
      tRun(r);
      tRunState(r);
      // Backfill per-step cost/tokens from each attempt's claude JSON envelope,
      // for rows that predate usage capture (only touches NULL cost_usd rows).
      // parseStepDoc keeps attempts apart: implement.2.output.json updates
      // step "implement" attempt 2 only — never every row of the step.
      for (const f of fs.readdirSync(path.join(RUNS_DIR, d))) {
        const doc = parseStepDoc(f);
        if (!doc || doc.kind !== "output") continue;
        const u = parseUsage(readJson(path.join(RUNS_DIR, d, f), null));
        if (!u || u.costUsd == null) continue;
        db.prepare(
          `UPDATE steps SET cost_usd = ?, input_tokens = ?, output_tokens = ?, cache_read_tokens = ?, cache_creation_tokens = ?
           WHERE run_id = ? AND step_id = ? AND attempt = ? AND cost_usd IS NULL`
        ).run(u.costUsd, u.inputTokens, u.outputTokens, u.cacheReadTokens, u.cacheCreationTokens, r.id, doc.step, doc.attempt);
      }
      const hasSteps = db.prepare(`SELECT COUNT(*) n FROM steps WHERE run_id = ?`).get(r.id).n > 0;
      if (!hasSteps) {
        const logPath = path.join(RUNS_DIR, d, "engine.log");
        if (fs.existsSync(logPath)) {
          const re = /^\[([^\]]+)\] step '([^']+)': (OK|FAIL) \((.*)\)$/;
          for (const line of fs.readFileSync(logPath, "utf8").split("\n")) {
            const m = line.match(re);
            if (m) {
              db.prepare(`INSERT INTO steps (run_id, step_id, attempt, status, summary, started_at, finished_at, duration_s) VALUES (?,?,?,?,?,?,?,NULL)`)
                .run(r.id, m[2], 1, m[3] === "OK" ? "ok" : "fail", m[4].slice(0, 1000), m[1], m[1]);
            }
          }
        }
        const review = readJson(path.join(RUNS_DIR, d, "review.json"), null);
        if (review && review.verdict) {
          tArtifact(r.id, "review", "review_verdict", review.verdict);
          for (const f of review.findings || []) tArtifact(r.id, "review", "finding", f);
        }
        if (r.artifactUrl) tArtifact(r.id, "deploy", "artifact_url", r.artifactUrl);
      }
    }
  }
  const since = new Date(Date.now() - days * 864e5).toISOString();
  const db = tdb();
  const runs = db.prepare(`SELECT * FROM runs WHERE created_at >= ? ORDER BY created_at DESC`).all(since);
  const stepStats = db
    .prepare(
      `SELECT s.step_id, COUNT(*) n, SUM(s.status = 'fail') fails, ROUND(AVG(s.duration_s), 1) avg_s, MAX(s.attempt) max_attempt,
              ROUND(SUM(COALESCE(s.cost_usd,0)), 2) cost, ROUND(AVG(s.cost_usd), 3) avg_cost,
              SUM(COALESCE(s.input_tokens,0) + COALESCE(s.cache_read_tokens,0) + COALESCE(s.cache_creation_tokens,0)) in_tok,
              SUM(COALESCE(s.output_tokens,0)) out_tok
       FROM steps s JOIN runs r ON r.id = s.run_id WHERE r.created_at >= ? GROUP BY s.step_id ORDER BY n DESC`
    )
    .all(since);
  const totals = db
    .prepare(
      `SELECT ROUND(SUM(COALESCE(s.cost_usd,0)), 2) cost,
              SUM(COALESCE(s.input_tokens,0) + COALESCE(s.cache_read_tokens,0) + COALESCE(s.cache_creation_tokens,0)) in_tok,
              SUM(COALESCE(s.output_tokens,0)) out_tok
       FROM steps s JOIN runs r ON r.id = s.run_id WHERE r.created_at >= ?`
    )
    .get(since);
  const findings = db
    .prepare(
      `SELECT a.run_id, a.value FROM artifacts a JOIN runs r ON r.id = a.run_id
       WHERE a.type = 'finding' AND r.created_at >= ? ORDER BY a.created_at DESC LIMIT 25`
    )
    .all(since);
  const failures = db
    .prepare(
      `SELECT s.run_id, s.step_id, s.summary FROM steps s JOIN runs r ON r.id = s.run_id
       WHERE s.status = 'fail' AND r.created_at >= ? ORDER BY s.finished_at DESC LIMIT 15`
    )
    .all(since);
  const artifacts = db
    .prepare(
      `SELECT a.run_id, a.type, a.value FROM artifacts a JOIN runs r ON r.id = a.run_id
       WHERE a.type IN ('artifact_url', 'harness_merge_commit', 'commit') AND r.created_at >= ?
       ORDER BY a.created_at DESC LIMIT 40`
    )
    .all(since);
  const runUsageMap = Object.fromEntries(runs.map((r) => [r.id, runUsage(r.id)]));
  if (asJson) {
    console.log(JSON.stringify({ since, totals, runs, runUsage: runUsageMap, stepStats, findings, failures, artifacts }, null, 2));
    return;
  }
  const lines = [`# Factory run report (last ${days} days, since ${since})`, ""];
  lines.push(
    `**Total cost:** $${(totals.cost || 0).toFixed(2)} · **tokens in:** ${fmtTokens(totals.in_tok || 0)} · **out:** ${fmtTokens(totals.out_tok || 0)}`,
    ""
  );
  lines.push(`## Runs (${runs.length})`, "");
  lines.push("| id | workflow | rig | state | created | cost | tok in/out | prompt |", "|---|---|---|---|---|---|---|---|");
  for (const r of runs) {
    const u = runUsageMap[r.id];
    const cost = u && u.pricedSteps ? `$${u.costUsd.toFixed(2)}` : "—";
    const tok = u && u.pricedSteps ? `${fmtTokens(u.inputTokens)}/${fmtTokens(u.outputTokens)}` : "—";
    lines.push(`| ${r.id} | ${r.workflow} | ${r.rig} | ${r.state} | ${r.created_at.slice(0, 16)} | ${cost} | ${tok} | ${(r.prompt || "").replace(/\n/g, " ").slice(0, 60)} |`);
  }
  lines.push("", "## Step statistics", "", "| step | executions | failures | avg seconds | avg cost | total cost | tok in/out | max attempt |", "|---|---|---|---|---|---|---|---|");
  for (const s of stepStats) {
    const avgCost = s.avg_cost != null ? `$${Number(s.avg_cost).toFixed(3)}` : "—";
    const totCost = s.cost ? `$${Number(s.cost).toFixed(2)}` : "—";
    const tok = s.in_tok ? `${fmtTokens(s.in_tok)}/${fmtTokens(s.out_tok)}` : "—";
    lines.push(`| ${s.step_id} | ${s.n} | ${s.fails} | ${s.avg_s} | ${avgCost} | ${totCost} | ${tok} | ${s.max_attempt} |`);
  }
  lines.push("", "## Recent step failures", "");
  for (const f of failures) lines.push(`- [${f.run_id} / ${f.step_id}] ${(f.summary || "").replace(/\n/g, " ").slice(0, 200)}`);
  lines.push("", "## Recent review findings", "");
  for (const f of findings) lines.push(`- [${f.run_id}] ${(f.value || "").replace(/\n/g, " ").slice(0, 200)}`);
  lines.push("", "## Recent artifacts (commits, deploys)", "");
  for (const a of artifacts) lines.push(`- [${a.run_id}] ${a.type}: ${(a.value || "").replace(/\n/g, " ").slice(0, 160)}`);
  console.log(lines.join("\n"));
}

// ---------- context (per-step context/cost analysis) ----------
//
// Deterministic parsing/aggregation over one run dir's step documents — where
// the tokens and cost actually went, per step/attempt. LLM-side inference
// stays in the self-reviewer prompt; this command only reports numbers.

/** Analyze one run dir: per step/attempt, prompt size, steering/findings
 *  injection flags, usage (envelope first, transcript fallback), and — when a
 *  transcript exists — assistant turns, tool_use counts, and models. Rows are
 *  ordered by prompt-file mtime (execution order). */
function analyzeRunContext(id) {
  const runDir = runDirOf(id);
  const rows = [];
  for (const name of fs.readdirSync(runDir)) {
    const doc = parseStepDoc(name);
    if (!doc || doc.kind !== "prompt") continue;
    const promptPath = path.join(runDir, name);
    const promptText = fs.readFileSync(promptPath, "utf8");
    const row = {
      step: doc.step,
      attempt: doc.attempt,
      promptBytes: Buffer.byteLength(promptText),
      steeringInjected: promptText.includes("Founder steering"),
      findingsInjected: promptText.includes("Previous validation FAILED"),
      usage: null,
      usageSource: null,
      durationMs: null,
      transcript: null,
      mtimeMs: fs.statSync(promptPath).mtimeMs,
    };
    const envelope = readJson(path.join(runDir, stepDocName(doc.step, "output", doc.attempt)), null);
    const u = parseUsage(envelope);
    if (u) {
      row.usage = u;
      row.usageSource = "envelope";
      row.durationMs = typeof envelope.duration_ms === "number" ? envelope.duration_ms : null;
    }
    const transcriptPath = path.join(runDir, stepDocName(doc.step, "transcript", doc.attempt));
    if (fs.existsSync(transcriptPath)) {
      try {
        const lines = fs.readFileSync(transcriptPath, "utf8").split("\n");
        row.transcript = transcriptStats(lines);
        if (!row.usage) {
          const ex = resultFromTranscript(lines);
          if (ex.usage) {
            row.usage = ex.usage;
            row.usageSource = "transcript-fallback";
          }
        }
      } catch {
        /* an unreadable transcript must not fail the report */
      }
    }
    rows.push(row);
  }
  rows.sort((a, b) => a.mtimeMs - b.mtimeMs);
  const totals = { costUsd: 0, inputTokens: 0, outputTokens: 0, cacheReadTokens: 0, cacheCreationTokens: 0 };
  for (const r of rows) {
    if (!r.usage) continue;
    totals.costUsd += r.usage.costUsd || 0;
    totals.inputTokens += r.usage.inputTokens || 0;
    totals.outputTokens += r.usage.outputTokens || 0;
    totals.cacheReadTokens += r.usage.cacheReadTokens || 0;
    totals.cacheCreationTokens += r.usage.cacheCreationTokens || 0;
  }
  return { runDir, rows, totals };
}

/** Count user/assistant messages in an OpenClaw session transcript's lines
 *  (pure, exercised by selftest). Garbage lines are skipped, never thrown. */
function sessionMessageCounts(lines) {
  const counts = { user: 0, assistant: 0 };
  for (const line of lines) {
    let ev;
    try {
      ev = JSON.parse(line);
    } catch {
      continue;
    }
    const role = ev && ev.message && ev.message.role;
    if (role === "user") counts.user += 1;
    else if (role === "assistant") counts.assistant += 1;
  }
  return counts;
}

const OPENCLAW_SESSIONS_DIR = "~/.openclaw/agents/main/sessions";

/** `context --sessions`: inventory OpenClaw session transcripts (the founder ↔
 *  OpenClaw conversations that start runs) — discoverable, not ingested. */
function cmdContextSessions(argv) {
  const dir = expandHome(argOf(argv, "--sessions-dir") || OPENCLAW_SESSIONS_DIR);
  const days = Number(argOf(argv, "--days") || 30);
  const asJson = argv.includes("--json");
  if (!fs.existsSync(dir)) {
    console.log(`no OpenClaw session directory at ${dir} — nothing to inventory (pass --sessions-dir to override)`);
    return;
  }
  const since = Date.now() - days * 864e5;
  const sessions = [];
  for (const name of fs.readdirSync(dir)) {
    if (!name.endsWith(".jsonl")) continue;
    const p = path.join(dir, name);
    let st;
    try {
      st = fs.statSync(p);
    } catch {
      continue;
    }
    if (st.mtimeMs < since) continue;
    let counts = { user: 0, assistant: 0 };
    try {
      counts = sessionMessageCounts(fs.readFileSync(p, "utf8").split("\n"));
    } catch {}
    sessions.push({
      file: name,
      path: p,
      mtime: new Date(st.mtimeMs).toISOString(),
      bytes: st.size,
      userMessages: counts.user,
      assistantMessages: counts.assistant,
    });
  }
  sessions.sort((a, b) => (a.mtime < b.mtime ? 1 : -1));
  if (asJson) {
    console.log(JSON.stringify({ dir, days, sessions }, null, 2));
    return;
  }
  console.log(`# OpenClaw sessions in ${dir} (last ${days} days: ${sessions.length} transcript(s))\n`);
  for (const s of sessions) {
    console.log(
      `${s.mtime.slice(0, 16)}  ${fmtBytes(s.bytes).padStart(9)}  ${String(s.userMessages).padStart(4)} user / ${String(s.assistantMessages).padStart(4)} assistant  ${s.file}`
    );
  }
}

function cmdContext(argv) {
  if (argv.includes("--sessions")) return cmdContextSessions(argv);
  const asJson = argv.includes("--json");
  const id = resolveRunId(argv.find((a, i) => !a.startsWith("--") && argv[i - 1] !== "--sessions-dir" && argv[i - 1] !== "--days"));
  const { runDir, rows, totals } = analyzeRunContext(id);
  if (asJson) {
    const steps = rows.map(({ mtimeMs, ...rest }) => rest);
    console.log(JSON.stringify({ runId: id, runDir, steps, totals }, null, 2));
    return;
  }
  console.log(`# Context report: ${id} (${runDir})\n`);
  if (rows.length === 0) console.log("no agent-step documents in this run dir");
  for (const r of rows) {
    console.log(`${r.step} (attempt ${r.attempt})`);
    console.log(
      `  prompt ${fmtBytes(r.promptBytes)} · steering: ${r.steeringInjected ? "yes" : "no"} · findings: ${r.findingsInjected ? "yes" : "no"}`
    );
    if (r.usage) {
      const u = r.usage;
      const cost = u.costUsd != null ? `$${u.costUsd.toFixed(2)}` : "n/a";
      const dur = r.durationMs != null ? ` · ${Math.round(r.durationMs / 1000)}s` : "";
      console.log(
        `  cost ${cost} · tokens in ${fmtTokens(u.inputTokens)} (+ ${fmtTokens(u.cacheReadTokens)} cache read, ${fmtTokens(u.cacheCreationTokens)} cache create) / out ${fmtTokens(u.outputTokens)}${dur} [${r.usageSource}]`
      );
    } else {
      console.log("  usage: none captured (no envelope, no usable transcript)");
    }
    if (r.transcript) {
      console.log(
        `  transcript: ${r.transcript.assistantTurns} assistant turn(s) · models: ${r.transcript.models.join(", ") || "n/a"}`
      );
      const tools = Object.entries(r.transcript.toolUses).sort((a, b) => b[1] - a[1]);
      if (tools.length) console.log(`  tools: ${tools.map(([name, n]) => `${name}×${n}`).join(", ")}`);
    }
    console.log("");
  }
  console.log(
    `## Run totals\ncost $${totals.costUsd.toFixed(2)} · tokens in ${fmtTokens(totals.inputTokens)} (+ ${fmtTokens(totals.cacheReadTokens)} cache read, ${fmtTokens(totals.cacheCreationTokens)} cache create) / out ${fmtTokens(totals.outputTokens)}\n`
  );
  const ranked = rows.filter((r) => r.usage).sort((a, b) => (b.usage.cacheReadTokens || 0) - (a.usage.cacheReadTokens || 0));
  if (ranked.length) {
    console.log("## Steps by cache-read tokens (context actually processed)");
    for (const r of ranked) {
      console.log(`  ${fmtTokens(r.usage.cacheReadTokens || 0).padStart(8)}  ${r.step} (attempt ${r.attempt})`);
    }
  }
}

function detachExec(id) {
  const out = fs.openSync(path.join(runDirOf(id), "executor.log"), "a");
  const child = spawn(process.execPath, [__filename, "exec", id], {
    detached: true,
    stdio: ["ignore", out, out],
  });
  child.unref();
  // Executor pid record (executor.pid, not run.json — the child executor
  // rewrites run.json and would race this write away) for the retry/resume
  // double-execute guard. A stale file after a normal exit is harmless:
  // liveness is always re-verified against the pid's live command line.
  fs.writeFileSync(path.join(runDirOf(id), "executor.pid"), `${child.pid}\n`);
  return child.pid;
}

/** Liveness of the run's recorded executor pid: the pid must exist AND its
 *  `ps` command line must still be this run's `factory-run exec` invocation
 *  (pid-reuse guard — a recycled pid never counts, and is never killed). */
function executorStatus(id) {
  let pid = null;
  try {
    pid = parseInt(fs.readFileSync(path.join(runDirOf(id), "executor.pid"), "utf8").trim(), 10) || null;
  } catch {}
  if (!pid || pid < 1) return { alive: false, pid: null };
  const res = spawnSync("ps", ["-p", String(pid), "-o", "command="], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return { alive: res.status === 0 && matchesExecutor(res.stdout, id), pid };
}

/** Terminate a run's live executor (forced retry of a stuck run): SIGTERM,
 *  brief wait, SIGKILL fallback. Returns true when the process is gone. */
function killExecutor(id, pid) {
  try {
    process.kill(pid, "SIGTERM");
  } catch {}
  for (let i = 0; i < 10 && executorStatus(id).alive; i++) execSync("sleep 0.3");
  if (executorStatus(id).alive) {
    try {
      process.kill(pid, "SIGKILL");
    } catch {}
    execSync("sleep 0.3");
  }
  return !executorStatus(id).alive;
}

/** Pure core of `resume --step/--back` (exercised by selftest): the stepIndex
 *  a resume should restart at. Rewind-only — a step after the current one is
 *  rejected (skipping gates forward is never allowed). */
function resolveResumeStep(stepIds, currentIndex, opts = {}) {
  if (opts.step) {
    const idx = stepIds.indexOf(opts.step);
    if (idx === -1) throw new Error(`unknown step '${opts.step}' (workflow steps: ${stepIds.join(", ")})`);
    if (idx > currentIndex) {
      throw new Error(`step '${opts.step}' is after the current step '${stepIds[Math.min(currentIndex, stepIds.length - 1)]}'; resume can only rewind`);
    }
    return idx;
  }
  if (opts.back) return Math.max(0, currentIndex - 1);
  return currentIndex;
}

function cmdResume(argv) {
  // First positional that is neither a flag nor --step's value.
  const id = resolveRunId(argv.find((a, i) => !a.startsWith("--") && argv[i - 1] !== "--step"));
  const run = loadRun(id);
  if (["done", "cancelled", "killed"].includes(run.state)) {
    console.error(`run ${id} is ${run.state}; nothing to resume`);
    process.exit(1);
  }
  // Double-execute guard: resuming past a live executor would run the step
  // loop twice against the same worktree.
  const ex = executorStatus(id);
  if (ex.alive) {
    console.error(
      `run ${id} already has a live executor (pid ${ex.pid}) — resuming would double-execute. ` +
        `Use 'factory-run retry ${id} --force' to kill it and resume.`
    );
    process.exit(1);
  }
  const wf = loadWorkflow(run.workflow);
  const idx = resolveResumeStep(
    wf.steps.map((s) => s.id),
    run.stepIndex || 0,
    { step: argOf(argv, "--step"), back: argv.includes("--back") }
  );
  if (idx !== (run.stepIndex || 0)) {
    run.stepIndex = idx;
    run.updatedAt = nowIso();
    run.history.push({ state: run.state, detail: `resume rewound to step '${wf.steps[idx].id}' (index ${idx})`, at: run.updatedAt });
    saveRun(run);
  }
  detachExec(id);
  console.log(`resumed ${id} at step ${run.stepIndex} (${wf.steps[Math.min(run.stepIndex, wf.steps.length - 1)].id})`);
}

// ---------- retry (failed & stuck runs; two tiers, one command) ----------
//
// Tier selection is classifyRetry (web/lib/retry.mjs): a first retry at the
// current step plain-resumes; a repeat retry, or a failure a resume cannot fix
// (preflight failure, recovery-cap escalation, escalation.md, missing
// worktree), hands the run to the OpenClaw chief of staff as a triage session.
// Stuck (stalled non-terminal) runs additionally gate on executor liveness:
// killing a live executor requires --force.

/**
 * The exact `openclaw agent` triage-dispatch argv. Single source of truth
 * like notifyArgs: the real dispatch and the CLI-absent log line both derive
 * from it.
 */
function triageArgs(runId, brief) {
  return ["agent", "--agent", "main", "--session-id", `factory-triage-${runId}`, "-m", brief];
}

function triageBrief(run, stepId, why) {
  const runDir = runDirOf(run.id);
  return [
    `Factory triage handoff for run ${run.id} (${run.workflow} on ${run.rig}), state '${run.state}', step '${stepId}'.`,
    `Why triage instead of a plain resume: ${why}.`,
    `Follow your factory-triage skill. Gather evidence first: \`factory-run status ${run.id} --json\`, \`factory-run context ${run.id}\`, and the run dir logs in ${runDir} (engine.log, executor.log, step logs, findings.md, escalation.md).`,
    `If the evidence clearly indicates a fix: apply it, then \`factory-run resume ${run.id}\` (add --step <step-id> only when the evidence clearly points at an earlier step).`,
    `If the right fix is unclear: post the options to the founder in the rig's Slack channel and stop. Never guess; never approve or reject gates yourself.`,
  ].join("\n");
}

/** Fire-and-forget OpenClaw triage handoff: detached, stdin ignored (the
 *  openclaw CLI hangs on a TTY check otherwise), output to triage.log. When
 *  the CLI is absent the exact dispatch is logged instead — offline/test
 *  environments still see precisely what would have run. Returns true when a
 *  session was actually dispatched. */
function dispatchTriage(run, stepId, why) {
  const runDir = runDirOf(run.id);
  const brief = triageBrief(run, stepId, why);
  const args = triageArgs(run.id, brief);
  if (spawnSync("which", ["openclaw"], { encoding: "utf8" }).status !== 0) {
    log(runDir, `triage dispatch skipped (openclaw CLI not on PATH); would run: openclaw ${args.slice(0, -1).join(" ")} '${brief.split("\n")[0]} …'`);
    return false;
  }
  const out = fs.openSync(path.join(runDir, "triage.log"), "a");
  const child = spawn("openclaw", args, { detached: true, stdio: ["ignore", out, out] });
  child.unref();
  log(runDir, `triage dispatched: openclaw agent session factory-triage-${run.id} (pid ${child.pid})`);
  return true;
}

function cmdRetry(argv) {
  const id = resolveRunId(argv.find((a) => !a.startsWith("--")));
  const force = argv.includes("--force");
  const run = loadRun(id);
  const runDir = runDirOf(id);
  let stepId = null;
  try {
    const wf = loadWorkflow(run.workflow);
    stepId = wf.steps[Math.min(run.stepIndex || 0, wf.steps.length - 1)].id;
  } catch {}
  const ex = executorStatus(id);
  const decision = classifyRetry(run, {
    now: Date.now(),
    stepId,
    escalationPresent: fs.existsSync(path.join(runDir, "escalation.md")),
    worktreeMissing: Boolean(run.worktree) && !fs.existsSync(run.worktree),
    executorAlive: ex.alive,
    executorPid: ex.pid,
    force,
    lastFailure: lastFailureDetail(run.history || []),
  });
  if (!decision.eligible) {
    console.error(`cannot retry ${id}: ${decision.reason}`);
    process.exit(1);
  }
  if (decision.killExecutor) {
    if (!killExecutor(id, ex.pid)) {
      console.error(`could not terminate executor pid ${ex.pid}; retry aborted`);
      process.exit(1);
    }
    log(runDir, `retry --force: terminated live executor pid ${ex.pid}`);
  }
  // Record the retry before acting: the tier history is what escalates the
  // NEXT retry at this step to triage, so it must survive whatever happens.
  if (!Array.isArray(run.retries)) run.retries = [];
  const at = nowIso();
  run.retries.push({ at, tier: decision.tier, step: stepId });
  run.updatedAt = at;
  run.history.push({ state: run.state, detail: `retry (${decision.tier} tier) at step '${stepId}': ${decision.reason}`, at });
  saveRun(run);
  if (decision.tier === "resume") {
    log(runDir, `retry: plain resume at step '${stepId}' (${decision.reason})`);
    detachExec(id);
    console.log(`retry (resume tier): ${id} resumed at step ${run.stepIndex || 0} (${stepId})`);
    return;
  }
  const dispatched = dispatchTriage(run, stepId, decision.reason);
  notify(
    run,
    `:ambulance: Run ${id} handed to OpenClaw triage (session \`factory-triage-${id}\`): ${decision.reason}.\n` +
      `The triage agent gathers evidence, then either fixes and resumes, or posts the options here for you to decide.`
  );
  console.log(
    dispatched
      ? `retry (triage tier): dispatched OpenClaw session factory-triage-${id} — ${decision.reason}`
      : `retry (triage tier): openclaw CLI not on PATH — dispatch logged to engine.log only (${decision.reason})`
  );
}

/** Machine-readable step/gate facts for `status --json`, so consumers (the
 *  standup skill, the web console) never parse human-formatted `history`
 *  detail strings. `currentStep` mirrors what the human output prints (raw
 *  stepIndex over total, id/type from the workflow, index clamped for id
 *  lookup). For awaiting-approval runs, `gate` says which kind of founder
 *  gate is pending: a plan gate, or a discussion awaiting a reply (with
 *  pendingReplies/lastActivityAt from the discussion helpers). */
function statusExtras(run) {
  let wf;
  try {
    wf = loadWorkflow(run.workflow);
  } catch {
    return { currentStep: null, gate: null };
  }
  const step = wf.steps[Math.min(run.stepIndex || 0, wf.steps.length - 1)];
  const currentStep = { index: run.stepIndex || 0, total: wf.steps.length, id: step.id, type: step.type };
  if (run.state !== "awaiting-approval") return { currentStep, gate: null };
  if (step.type === "discussion") {
    const runDir = runDirOf(run.id);
    // A run dir can be absent (pruned, or a synthetic run in selftest); report
    // the gate kind rather than letting `status --json` die on one bad run.
    if (!fs.existsSync(runDir)) return { currentStep, gate: { kind: "discussion", pendingReplies: null, lastActivityAt: run.updatedAt || null } };
    const turns = readDiscussionTurns(runDir, step.id);
    const repliesPath = path.join(runDir, "discussion-replies.jsonl");
    const replies = fs.existsSync(repliesPath)
      ? parseReplyLines(fs.readFileSync(repliesPath, "utf8").split("\n"))
      : [];
    return {
      currentStep,
      gate: {
        kind: "discussion",
        pendingReplies: countPendingReplies(turns, replies),
        lastActivityAt: discussionLastActivity(turns, replies),
      },
    };
  }
  // Plan gate (or any non-discussion approval wait): no reply mechanism, so
  // pendingReplies is null; last activity is the state transition that posted it.
  return { currentStep, gate: { kind: "plan-gate", pendingReplies: null, lastActivityAt: run.updatedAt || null } };
}

function cmdStatus(argv) {
  const fragment = argv.find((a) => !a.startsWith("--"));
  const id = fragment ? resolveRunId(fragment) : undefined;
  const asJson = argv.includes("--json");
  const ids = id ? [id] : fs.existsSync(RUNS_DIR) ? fs.readdirSync(RUNS_DIR).filter((d) => fs.existsSync(path.join(RUNS_DIR, d, "run.json"))) : [];
  const runs = ids.map((rid) => loadRun(rid)).sort((a, b) => (a.createdAt < b.createdAt ? 1 : -1));
  if (asJson) {
    console.log(JSON.stringify(runs.map((r) => ({ ...r, usage: runUsage(r.id), ...statusExtras(r) })), null, 2));
    return;
  }
  for (const r of runs) {
    const wf = loadWorkflow(r.workflow);
    const step = wf.steps[Math.min(r.stepIndex, wf.steps.length - 1)];
    console.log(`${r.id}  ${r.state.padEnd(20)} ${r.rig.padEnd(20)} step ${r.stepIndex}/${wf.steps.length} (${step.id})  ${r.prompt.slice(0, 60)}`);
    const usage = usageLine(r.id);
    if (usage) console.log(`  ${usage.replace(/:moneybag: /, "")}`);
    if (id) {
      for (const h of r.history.slice(-10)) console.log(`  ${h.at}  ${h.state}${h.detail ? ` — ${h.detail}` : ""}`);
      if (r.recovery) {
        const a = r.recovery.attempts || [];
        const detail = a.map((x) => `${x.conflicted ? "conflicted" : "clean"}→${x.outcome}`).join(", ");
        console.log(`  recovery: ${r.recovery.iterations}/${RECOVERY_CAP} cycle(s)${detail ? ` — ${detail}` : ""}`);
      }
      if (r.artifactUrl) console.log(`  artifact: ${r.artifactUrl}`);
      console.log(`  worktree: ${r.worktree}`);
      console.log(`  run dir:  ${runDirOf(r.id)}`);
    }
  }
  if (runs.length === 0) console.log("no runs");
}

function cmdGate(id, decision, feedback) {
  loadRun(id); // validates
  writeJson(path.join(runDirOf(id), "gate-decision.json"), { decision, feedback: feedback || null, at: nowIso() });
  console.log(`${decision} recorded for ${id}`);
}

/** Founder turn in a discussion step: append one JSON line to the run's
 *  discussion-replies.jsonl. The polling discussion step answers with exactly
 *  one new agent turn per reply batch. */
function cmdReply(id, text) {
  loadRun(id);
  if (!text || !text.trim()) {
    console.error('usage: factory-run reply <run_id> "<text>"');
    process.exit(1);
  }
  fs.appendFileSync(path.join(runDirOf(id), "discussion-replies.jsonl"), JSON.stringify({ at: nowIso(), text }) + "\n");
  console.log(`reply recorded for ${id} (the discussion agent answers in its next turn)`);
}

function cmdSteer(id, instruction) {
  loadRun(id);
  fs.appendFileSync(path.join(runDirOf(id), "steering.md"), `- [${nowIso()}] ${instruction}\n`);
  console.log(`steering recorded for ${id} (applies from the next agentic step)`);
}

function cmdCancel(id) {
  const run = loadRun(id);
  setState(run, "cancelled", "cancelled by founder");
  console.log(`cancelled ${id} (executor exits at the next step boundary; worktree kept)`);
}

function cmdPreflight(argv) {
  const rigName = argOf(argv, "--rig");
  const rigNames = rigName ? [rigName] : Object.keys(RIGS.rigs);
  const { ok, probes } = runPreflight(rigNames);
  for (const p of probes) console.log(`${p.ok ? "ok  " : "FAIL"} ${p.name}: ${p.detail}`);
  if (!ok) {
    console.error("\nPREFLIGHT FAILED (run-start preflight can be skipped with FACTORY_RUN_NO_PREFLIGHT=1)");
    process.exit(1);
  }
  console.log("\npreflight green");
}

function cmdSelftest() {
  const problems = [];
  const okMark = (b) => (b ? "ok" : "MISSING");
  for (const name of Object.keys(RIGS.rigs)) {
    const rig = resolveRig(name);
    const exists = fs.existsSync(rig.path) && fs.existsSync(path.join(rig.path, ".git"));
    console.log(`rig ${name}: path ${okMark(exists)} (${rig.path})`);
    if (!exists) problems.push(`rig ${name} path missing`);
    try {
      const branch = sh(`git -C ${JSON.stringify(rig.path)} rev-parse --verify ${rig.defaultBranch}`, {}).trim();
      console.log(`rig ${name}: base branch ${rig.defaultBranch} ok (${branch.slice(0, 8)})`);
    } catch {
      problems.push(`rig ${name}: base branch ${rig.defaultBranch} not found`);
    }
  }
  const wfNames = fs
    .readdirSync(path.join(ORCH_DIR, "workflows"))
    .filter((f) => f.endsWith(".json"))
    .map((f) => f.replace(/\.json$/, ""))
    .sort();
  for (const wf of wfNames) {
    const w = loadWorkflow(wf);
    const wfProblems = validateWorkflowAgentSteps(wf, w);
    problems.push(...wfProblems);
    console.log(`workflow ${wf}: ${w.steps.length} steps ${wfProblems.length ? "INVALID" : "ok"}`);
  }
  {
    const p = fs.existsSync(path.join(ORCH_DIR, "prompts", `${RESOLVE_STEP.prompt}.md`));
    console.log(`prompt ${RESOLVE_STEP.prompt} (synthetic ${RESOLVE_STEP.id}): ${okMark(p)}`);
    if (!p) problems.push(`missing prompt ${RESOLVE_STEP.prompt} for synthetic step ${RESOLVE_STEP.id}`);
  }
  for (const bin of ["claude", "openclaw", "git", "npx"]) {
    const found = spawnSync("which", [bin], { encoding: "utf8" }).status === 0;
    console.log(`binary ${bin}: ${okMark(found)}`);
    if (!found) problems.push(`binary ${bin} not on PATH`);
  }
  // Run-id minting and resolution (pure — nothing touches RUNS_DIR).
  const throws = (fn, re) => {
    try {
      fn();
      return false;
    } catch (err) {
      return re.test(String(err.message));
    }
  };
  const fakeIds = ["feature-version-badge", "feature-version-badge-2", "bug-leaked-sockets", "feature-msdn5cuj"];
  const idChecks = [
    ["slug derivation", slugify("Add a version badge to the settings screen") === "version-badge-settings"],
    ["slug charset/length", /^[a-z0-9]+(-[a-z0-9]+)*$/.test(slugify("Fix the LEAKED sockets!! ASAP")) && slugify("Fix the LEAKED sockets!! ASAP").length <= 28],
    ["degenerate prompt falls back", slugify("!!! \u{1F680}") === ""],
    ["collision suffixing", uniqueRunId("feature-version-badge", (id) => fakeIds.includes(id)) === "feature-version-badge-3"],
    ["exact id wins over prefix", resolveRunIdFrom("feature-version-badge", fakeIds) === "feature-version-badge"],
    ["unique prefix resolves", resolveRunIdFrom("bug-leak", fakeIds) === "bug-leaked-sockets"],
    ["unique substring resolves", resolveRunIdFrom("leaked-sockets", fakeIds) === "bug-leaked-sockets"],
    ["legacy id resolves", resolveRunIdFrom("feature-msdn5cuj", fakeIds) === "feature-msdn5cuj"],
    ["ambiguous fragment rejected", throws(() => resolveRunIdFrom("feature-", fakeIds), /^ambiguous run id 'feature-': matches feature-msdn5cuj, feature-version-badge, feature-version-badge-2$/)],
    ["no-match fragment rejected", throws(() => resolveRunIdFrom("zzz", fakeIds), /no such run/)],
  ];
  for (const [name, ok] of idChecks) {
    console.log(`run-id ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`run-id check failed: ${name}`);
  }
  // Cleanup decision core (pure — no git or filesystem access).
  const cls = (over, opts) =>
    classifyCleanup({ state: "done", worktreeExists: true, branchExists: true, dirty: false, merged: true, ...over }, opts).action;
  const cleanupChecks = [
    ["in-flight run skipped", cls({ state: "running:implement" }) === "skip"],
    ["dirty worktree skipped even when merged", cls({ dirty: true }) === "skip"],
    ["unmerged branch skipped by default", cls({ merged: false }) === "skip"],
    ["merged and clean reclaimed", cls({}) === "clean"],
    ["failed run with merged branch reclaimed", cls({ state: "failed" }) === "clean"],
    ["branch gone, clean worktree removed", cls({ branchExists: false, merged: false }) === "clean"],
    ["worktree gone, merged branch deleted", cls({ worktreeExists: false }) === "clean"],
    ["nothing left is a no-op", cls({ worktreeExists: false, branchExists: false, merged: false }) === "none"],
    ["unmerged worktree removal is opt-in", cls({ merged: false }, { removeUnmergedWorktrees: true }) === "remove-worktree"],
    ["opt-in never deletes the unmerged branch", cls({ merged: false, worktreeExists: false }, { removeUnmergedWorktrees: true }) === "skip"],
  ];
  for (const [name, ok] of cleanupChecks) {
    console.log(`cleanup ${name}: ${ok ? "ok" : "FAIL"}`);
    if (!ok) problems.push(`cleanup check failed: ${name}`);
  }
  // Harness-merge web-restart decision core (pure).
  const webChecks = [
    ["engine-only merge skips web restart", classifyWebRestart(["orchestration/bin/factory-run", "orchestration/prompts/implement.md"]).restart === false],
    ["server change restarts web", classifyWebRestart(["orchestration/web/server.mjs"]).restart === true],
    ["web lib change restarts web", classifyWebRestart(["orchestration/web/lib/runs.mjs"]).restart === true],
    ["factory-web script change restarts web", classifyWebRestart(["orchestration/bin/factory-web-down"]).restart === true],
    ["backend-only change keeps frontend build", classifyWebRestart(["orchestration/web/server.mjs"]).rebuildFrontend === false],
    ["frontend change forces rebuild", classifyWebRestart(["orchestration/web/frontend/src/App.tsx"]).rebuildFrontend === true],
