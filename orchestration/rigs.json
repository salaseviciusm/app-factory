{
  "notify": {
    "channel": "slack",
    "to": "channel:${FACTORY_BUILDS_CHANNEL}"
  },
  "easAccount": "salaseviciusm",
  "rigs": {
    "running-with-pace": {
      "path": "~/src/running-with-pace",
      "tier": "production",
      "defaultBranch": "main",
      "notifyChannelName": "factory-pace",
      "setup": [
        "npm install",
        "cd pace-react-native && npm install"
      ],
      "checks": [
        "npm run type-check",
        "npm run lint"
      ],
      "tests": [
        "npm run test:unit"
      ],
      "appDir": "pace-react-native",
      "easSlug": "pace",
      "deploy": {
        "type": "eas-update",
        "branch": "preview"
      }
    },
    "app-factory": {
      "path": "~/src/app-factory",
      "tier": "production",
      "defaultBranch": "main",
      "notifyChannelName": "factory-app-factory",
      "setup": [],
      "checks": [
        "node --check orchestration/bin/factory-run",
        "orchestration/bin/factory-run selftest",
        "for f in orchestration/web/server.mjs orchestration/web/lib/*.mjs orchestration/bin/factory-web; do node --check \"$f\" || exit 1; done",
        "bash -n openclaw/apply-slack.sh openclaw/apply-voice.sh openclaw/setup-automations.sh openclaw/slack-heartbeat.sh",
        "node --check openclaw/lib/slack-channel.mjs"
      ],
      "tests": [
        "node --test orchestration/web/lib/*.test.mjs",
        "node --test orchestration/test/*.test.mjs"
      ],
      "appDir": ".",
      "deploy": {
        "type": "harness-merge"
      }
    },
    "skip-hero": {
      "path": "~/src/skip-hero",
      "tier": "production",
      "defaultBranch": "main",
      "notifyChannelName": "factory-skiphero",
      "setup": [
        "npm install"
      ],
      "checks": [
        "npm run typecheck",
        "npm run lint",
        "npm run format:check",
        {
          "cmd": "npm run golden:check",
          "founderGated": true,
          "renderer": "skip-hero-golden",
          "protectedPaths": [
            "examples/*.golden.json"
          ],
          "onApprove": {
            "commands": [
              "npm run golden:update"
            ],
            "commitPaths": [
              "examples/*.golden.json"
            ],
            "commitMessage": "harness: founder-approved golden re-baseline"
          }
        }
      ],
      "tests": [
        "npm run test"
      ],
      "appDir": "apps/mobile",
      "easSlug": "skip-hero",
      "deploy": {
        "type": "eas-update",
        "branch": "preview"
      }
    }
  },
  "factoryApps": {
    "basePath": "~/src/app-factory/apps",
    "tier": "quickfire",
    "defaultBranch": "main",
    "notifyChannelName": "factory-app-${app}",
    "setup": [
      "npm install"
    ],
    "checks": [
      "npm run check"
    ],
    "tests": [],
    "appDir": ".",
    "deploy": {
      "type": "none"
    }
  }
}
