# Factory secrets + environment IDs — the ONE file a fresh install needs.
# Copy to secrets.env (gitignored) and fill in real values:
#   cp openclaw/secrets.env.example openclaw/secrets.env
# Then run openclaw/apply-slack.sh (README Step 4) and openclaw/setup-automations.sh
# (README Step 5). Never commit secrets.env.

# Slack app tokens — from the Slack app created in README Step 4:
#   Bot User OAuth Token (Install App page), starts xoxb-
SLACK_BOT_TOKEN=xoxb-REPLACE
#   App-Level Token with connections:write (Basic Information → App-Level Tokens), starts xapp-
SLACK_APP_TOKEN=xapp-REPLACE

# Slack channel IDs (right-click channel → Copy link → the C... segment).
# Only these hand-created channels need IDs pasted here. The heartbeat's
# #factory-status and the per-repo run channels (#factory-pace,
# #factory-skiphero, #factory-app-factory, #factory-app-<x>) are resolved by
# NAME and created on demand via openclaw/lib/slack-channel.mjs — no IDs needed.
FACTORY_STANDUP_CHANNEL=C_REPLACE_STANDUP
FACTORY_APPROVALS_CHANNEL=C_REPLACE_APPROVALS
# #factory-builds is now only the FALLBACK target for run notifications when a
# per-rig channel cannot be resolved (see orchestration/rigs.json notify).
FACTORY_BUILDS_CHANNEL=C_REPLACE_BUILDS
# Optional: pin #factory-status (heartbeat topic stamps) to an explicit ID and
# skip the name lookup / on-demand creation entirely.
#FACTORY_STATUS_CHANNEL=C_OPTIONAL_STATUS
# Dedicated QUIET channel for the connectivity watchdog's probe messages (README
# Step 5c) — use a channel humans don't read, e.g. #factory-watchdog, so the
# 5-minute liveness probes never spam anyone. Invite the bot to it.
FACTORY_WATCHDOG_CHANNEL=C_REPLACE_WATCHDOG

# Founder's Slack member ID (profile → ⋯ → Copy member ID, U...)
FACTORY_FOUNDER_SLACK_ID=U_REPLACE_FOUNDER

# Anthropic auth is NOT here: it lives in ~/.claude/.credentials.json (materialized
# from the macOS Keychain — see README Step 2) and is read by OpenClaw directly.

# Voice transcription (either one; Groq recommended - free tier, whisper-large-v3-turbo)
GROQ_API_KEY=REPLACE_or_delete
OPENAI_API_KEY=REPLACE_or_delete
