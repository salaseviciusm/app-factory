// OpenClaw Slack channel config patch — TEMPLATE. Do not edit IDs here.
// Real values live in openclaw/secrets.env (gitignored); openclaw/apply-slack.sh
// renders this template with them and applies the result (README Step 4).
//
// Token fields use the canonical SecretRef form resolved from the daemon's
// service env file — token VALUES never appear in any committed file.
// (`{ $env: ... }` shorthand is NOT read by OpenClaw 2026.7.)
{
  channels: {
    slack: {
      enabled: true,
      mode: "socket",
      botToken: { source: "env", provider: "default", id: "SLACK_BOT_TOKEN" },
      appToken: { source: "env", provider: "default", id: "SLACK_APP_TOKEN" },
      // Only factory channels; everything else is invisible to the agent.
      groupPolicy: "allowlist",
      channels: {
        // #factory-standup — no @mention needed; this is the agent's home room
        "${FACTORY_STANDUP_CHANNEL}": { requireMention: false },
        // #factory-approvals — gate confirmations
        "${FACTORY_APPROVALS_CHANNEL}": { requireMention: false },
        // #factory-builds — fallback for run notifications when a per-rig
        // channel cannot be resolved; run-gate approvals are typed here as
        // plain replies, so no @mention required
        "${FACTORY_BUILDS_CHANNEL}": { requireMention: false },
        // #factory-status + per-repo run channels — resolved by NAME (created
        // on demand) by apply-slack.sh at apply time, so founder replies (e.g.
        // gate approvals) typed in them reach the agent. Re-run apply-slack.sh
        // after stamping a new quickfire app to allowlist its channel.
        "${FACTORY_STATUS_CHANNEL}": { requireMention: false },
        "${FACTORY_PACE_CHANNEL}": { requireMention: false },
        "${FACTORY_SKIPHERO_CHANNEL}": { requireMention: false },
        "${FACTORY_APP_FACTORY_CHANNEL}": { requireMention: false },
        ${EXTRA_APP_CHANNELS}
      },
      // DMs from the founder only
      dmPolicy: "allowlist",
      allowFrom: ["${FACTORY_FOUNDER_SLACK_ID}"],
    },
  },
}
